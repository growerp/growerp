<!-- The server rendered shop pages (cart, log in, sign-up, checkout, orders) call the same
     popstore services as the /pop REST API, so they get the same grant: every user, inherited
     by those services (see POPRS_API in PopRestStoreAaaSetupData.xml). -->
<entity-facade-xml type="seed">
    <moqui.security.ArtifactGroup artifactGroupId="POPRS_SHOP" description="POP Store shop pages"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="POPRS_SHOP" artifactTypeEnumId="AT_XML_SCREEN"
            inheritAuthz="Y" artifactName="component://PopRestStore/screen/store/cart.xml"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="POPRS_SHOP" artifactTypeEnumId="AT_XML_SCREEN"
            inheritAuthz="Y" artifactName="component://PopRestStore/screen/store/login.xml"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="POPRS_SHOP" artifactTypeEnumId="AT_XML_SCREEN"
            inheritAuthz="Y" artifactName="component://PopRestStore/screen/store/signup.xml"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="POPRS_SHOP" artifactTypeEnumId="AT_XML_SCREEN"
            inheritAuthz="Y" artifactName="component://PopRestStore/screen/store/checkout.xml"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="POPRS_SHOP" artifactTypeEnumId="AT_XML_SCREEN"
            inheritAuthz="Y" artifactName="component://PopRestStore/screen/store/order.xml"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="POPRS_SHOP" artifactTypeEnumId="AT_XML_SCREEN"
            inheritAuthz="Y" artifactName="component://PopRestStore/screen/store/orders.xml"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="POPRS_SHOP_ALL" userGroupId="ALL_USERS" artifactGroupId="POPRS_SHOP"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
</entity-facade-xml>
