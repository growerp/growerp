<!-- Shopping cart, the same for every product (courses included); the cart order lives in the
     web session, see popstore.CartServices.get#ActiveOrderAndCustomer -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-2.1.xsd"
    require-authentication="anonymous-view" history="false">

    <transition name="updateQuantity">
        <parameter name="orderId"/><parameter name="orderItemSeqId"/><parameter name="quantity"/>
        <actions>
            <service-call name="popstore.CartServices.update#OrderProductQuantity"
                in-map="[orderId: orderId, orderItemSeqId: orderItemSeqId, quantity: quantity]"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="removeItem">
        <parameter name="orderId"/><parameter name="orderItemSeqId"/>
        <actions>
            <service-call name="popstore.CartServices.delete#OrderItem"
                in-map="[orderId: orderId, orderItemSeqId: orderItemSeqId]"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <pre-actions>
        <set field="pageTitle" value="Shopping cart"/>
    </pre-actions>
    <actions>
        <service-call name="popstore.CartServices.get#OrderDisplay" out-map="context"/>
        <set field="template_server_cart" from="storeInfo.settings.template_server_cart"
            default-value="component://PopRestStore/template/store/modern/cart.html.ftl"/>
    </actions>
    <widgets>
        <render-mode><text type="html" location="${template_server_header}"/></render-mode>
        <render-mode><text type="html" location="${template_server_cart}"/></render-mode>
        <render-mode><text type="html" location="${template_server_footer}"/></render-mode>
    </widgets>
</screen>
