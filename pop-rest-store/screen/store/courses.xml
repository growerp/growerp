<!-- Courses are sold as products: /courses redirects to the Courses category of the store
     owner, /courses/{courseId} to the course's product page. Kept for links out there. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-2.1.xsd"
        require-authentication="anonymous-view" allow-extra-path="true" history="false">

    <pre-actions>
        <set field="extraPathNameList" from="sri.screenUrlInfo.extraPathNameList"/>
        <set field="courseId" from="extraPathNameList ? extraPathNameList[0] : null"/>
        <entity-find-one entity-name="mantle.party.Party" value-field="storeCompany" cache="true">
            <field-map field-name="partyId" from="productStore.organizationPartyId"/></entity-find-one>
        <set field="ownerPartyId" from="storeCompany?.ownerPartyId ?: '-'"/>
        <set field="location" from="null"/>
        <if condition="courseId">
            <entity-find entity-name="growerp.course.Course" list="courseList">
                <econdition field-name="ownerPartyId"/>
                <econdition field-name="courseId"/>
                <econdition field-name="status" value="PUBLISHED"/>
            </entity-find>
            <if condition="courseList &amp;&amp; courseList[0].productId">
                <set field="location" value="/product/${courseList[0].productId}"/>
            </if>
            <else>
                <entity-find entity-name="mantle.product.category.ProductCategory" list="categoryList">
                    <econdition field-name="ownerPartyId"/>
                    <econdition field-name="productCategoryTypeEnumId" value="PctCatalog"/>
                    <econdition field-name="categoryName" value="Courses"/>
                </entity-find>
                <if condition="storeInfo.hasCourses &amp;&amp; categoryList">
                    <set field="location" value="/category/${categoryList[0].productCategoryId}"/>
                </if>
            </else>
        </if>
        <script>
            if (location) {
                ec.web.response.setStatus(301)
                ec.web.response.setHeader('Location', location)
            } else {
                ec.web.response.setStatus(404)
            }
        </script>
    </pre-actions>
    <widgets/>
</screen>
