<!-- Public course catalog: /courses lists the published courses of the store owner,
     /courses/{courseId} shows one course's outline. Lesson content is never served here;
     learners enroll and study in the app. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-2.1.xsd"
        require-authentication="anonymous-view" allow-extra-path="true" history="false">

    <pre-actions>
        <set field="extraPathNameList" from="sri.screenUrlInfo.extraPathNameList"/>
        <set field="courseId" from="extraPathNameList ? extraPathNameList[0] : null"/>
        <set field="pageTitle" value="Courses"/>
        <entity-find-one entity-name="mantle.party.Party" value-field="storeCompany" cache="true">
            <field-map field-name="partyId" from="productStore.organizationPartyId"/></entity-find-one>
        <entity-find entity-name="growerp.course.Course" list="courseEntityList">
            <econdition field-name="ownerPartyId" from="storeCompany?.ownerPartyId ?: '-'"/>
            <econdition field-name="status" value="PUBLISHED"/>
            <econdition field-name="courseId" ignore-if-empty="true"/>
            <order-by field-name="title"/>
        </entity-find>
        <!-- no published courses (menu link hidden) or unknown course: render a not-found page -->
        <set field="notFound" from="!storeInfo.hasCourses || (courseId &amp;&amp; !courseEntityList)"/>
        <if condition="notFound"><script>ec.web.response.setStatus(404)</script></if>

        <set field="courseList" from="[]"/>
        <iterate list="courseEntityList" entry="courseEntity">
            <entity-find entity-name="growerp.course.CourseModule" list="moduleList">
                <econdition field-name="courseId" from="courseEntity.courseId"/>
                <order-by field-name="sequenceNum"/>
            </entity-find>
            <set field="modules" from="[]"/>
            <set field="lessonCount" from="0"/>
            <iterate list="moduleList" entry="module">
                <entity-find entity-name="growerp.course.CourseLesson" list="lessonList">
                    <econdition field-name="moduleId" from="module.moduleId"/>
                    <order-by field-name="sequenceNum"/>
                    <select-field field-name="title,estimatedDuration"/>
                </entity-find>
                <set field="lessonCount" from="lessonCount + lessonList.size()"/>
                <script>modules.add([title: module.title, description: module.description,
                        lessons: lessonList.collect { [title: it.title, estimatedDuration: it.estimatedDuration] }])</script>
            </iterate>
            <set field="coursePrice" from="null"/>
            <if condition="courseEntity.productId">
                <entity-find entity-name="mantle.product.ProductPrice" list="priceList">
                    <econdition field-name="productId" from="courseEntity.productId"/>
                    <econdition field-name="priceTypeEnumId" value="PptCurrent"/>
                    <date-filter/>
                    <order-by field-name="-fromDate"/>
                </entity-find>
                <set field="coursePrice" from="priceList ? priceList[0] : null"/>
            </if>
            <script>courseList.add([courseId: courseEntity.courseId, title: courseEntity.title,
                    description: courseEntity.description, objectives: courseEntity.objectives,
                    difficulty: courseEntity.difficulty, estimatedDuration: courseEntity.estimatedDuration,
                    coverImageUrl: courseEntity.coverImageUrl, price: coursePrice?.price,
                    priceUomId: coursePrice?.priceUomId ?: productStore.defaultCurrencyUomId,
                    moduleCount: moduleList.size(), lessonCount: lessonCount, modules: modules])</script>
        </iterate>
        <if condition="courseId &amp;&amp; courseList">
            <set field="course" from="courseList[0]"/>
            <set field="pageTitle" from="course.title"/>
        </if>
        <set field="template_server_courses" from="storeInfo.settings.template_server_courses"
            default-value="component://PopRestStore/template/store/${templateId}/courses.html.ftl"/>
    </pre-actions>
    <widgets>
        <render-mode><text type="html" location="${template_server_header}"/></render-mode>
        <render-mode><text type="html" location="${template_server_courses}"/></render-mode>
        <render-mode><text type="html" location="${template_server_footer}"/></render-mode>
    </widgets>
</screen>
