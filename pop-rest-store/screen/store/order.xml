<!-- /order/{orderId}: one order of the logged in customer; with placed=true the confirmation
     right after checkout. Courses in it are opened in the academy app. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-2.1.xsd"
    require-authentication="anonymous-view" allow-extra-path="true" history="false">
    <parameter name="placed"/>

    <pre-actions>
        <set field="extraPathNameList" from="sri.screenUrlInfo.extraPathNameList"/>
        <set field="orderId" from="extraPathNameList ? extraPathNameList[0] : null"/>
        <if condition="!ec.user.userId">
            <script>sri.sendRedirectAndStopRender('/login?returnTo=/order/' + (orderId ?: ''))</script>
        </if>
        <set field="pageTitle" value="Order ${orderId ?: ''}"/>
    </pre-actions>
    <actions>
        <if condition="orderId">
            <service-call name="popstore.CartServices.get#OrderDisplay" in-map="[orderId: orderId]"
                out-map="context"/>
        </if>
        <set field="template_server_order" from="storeInfo.settings.template_server_order"
            default-value="component://PopRestStore/template/store/modern/order.html.ftl"/>
    </actions>
    <widgets>
        <render-mode><text type="html" location="${template_server_header}"/></render-mode>
        <render-mode><text type="html" location="${template_server_order}"/></render-mode>
        <render-mode><text type="html" location="${template_server_footer}"/></render-mode>
    </widgets>
</screen>
