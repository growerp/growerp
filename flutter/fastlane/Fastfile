def normalized_env(key)
  ENV[key].to_s.gsub("\r", "").strip
end

def required_env!(key)
  value = normalized_env(key)
  UI.user_error!("Missing required environment variable #{key}.") if value.empty?
  value
end

def optional_env(key)
  value = normalized_env(key)
  value.empty? ? nil : value
end

def release_pending_versions(app, platform_filter)
  require "spaceship"
  versions = app.get_app_store_versions(
    filter: { "appStoreState" => "PENDING_DEVELOPER_RELEASE", "platform" => platform_filter }
  )
  released = false
  versions.each do |ver|
    UI.message("Releasing #{ver.version_string} (#{platform_filter}) to free the submit slot")
    ver.create_app_store_version_release_request
    UI.success("Released v#{ver.version_string}")
    released = true
  end
  released
end

# States a version can only reach by having been submitted to Apple — live,
# queued, or bounced back. What matters is that the listing was complete enough
# to enter review, not that review ever passed: a DEVELOPER_REJECTED version was
# submitted and withdrawn, and can be filled in and submitted again.
#
# A platform with no version in any of these has never been submitted at all, so
# all it has is the PREPARE_FOR_SUBMISSION version App Store Connect creates with
# the app record. That one has no completed listing and deliver rejects it with
# "appStoreVersions ... is not in valid state. This resource cannot be reviewed",
# so those get a TestFlight upload until the first version is submitted by hand.
#
# Both state fields are checked: appVersionState is current and appStoreState
# deprecated, their vocabularies differ (READY_FOR_DISTRIBUTION vs
# READY_FOR_SALE), and Apple does not populate them uniformly across apps.
SUBMITTED_STATES = %w[
  READY_FOR_SALE READY_FOR_DISTRIBUTION
  PROCESSING_FOR_APP_STORE PROCESSING_FOR_DISTRIBUTION
  PENDING_DEVELOPER_RELEASE PENDING_APPLE_RELEASE
  IN_REVIEW WAITING_FOR_REVIEW ACCEPTED
  DEVELOPER_REJECTED REJECTED METADATA_REJECTED INVALID_BINARY
  REPLACED_WITH_NEW_VERSION DEVELOPER_REMOVED_FROM_SALE REMOVED_FROM_SALE
].freeze

def ever_submitted?(versions)
  versions.any? do |v|
    SUBMITTED_STATES.include?(v.app_store_state) ||
      SUBMITTED_STATES.include?(v.app_version_state)
  end
end

# A submission queued but not yet picked up by a reviewer can be cancelled
# without interrupting anyone, which returns its version to an editable state.
# An IN_REVIEW submission is left alone and simply blocks the run.
# Returns true when a submission was actually cancelled.
def cancel_waiting_review_submission(app, bundle_id, platform_filter)
  submission = app.get_in_progress_review_submission(platform: platform_filter)
  return false if submission.nil? || submission.state != "WAITING_FOR_REVIEW"

  UI.important(
    "#{bundle_id} (#{platform_filter}) has a WAITING_FOR_REVIEW submission; " \
    "cancelling it to make the version editable."
  )
  submission.cancel_submission
  true
end

# How long to wait for App Store Connect to accept the new version. Releasing
# or cancelling the previous one is not instant: the released version travels
# through PENDING_APPLE_RELEASE and the app-level App Info stays locked while it
# does, so a single check right after the request reports a false "blocked".
SETTLE_ATTEMPTS = 30
SETTLE_INTERVAL = 20

# Make App Store Connect ready to accept `version_string`, creating the App
# Store version if it doesn't exist yet, and return true once it is ready.
#
# Apple allows one editable version at a time, so the previous one has to go
# first: a version in PENDING_DEVELOPER_RELEASE is released, one merely queued
# for review is cancelled. Both take minutes to settle, hence the poll.
#
# Returns false only for a never-published app, whose first version Apple cannot
# review from CI — that one still gets a TestFlight upload. Every other blocker
# raises, so a green stable-track run always means the build was submitted.
def prepare_edit_version!(api_key, bundle_id, platform_filter, version_string)
  require "spaceship"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  app = Spaceship::ConnectAPI::App.find(bundle_id)
  UI.user_error!("App not found: #{bundle_id}") unless app

  versions = app.get_app_store_versions(filter: { "platform" => platform_filter })
  unless ever_submitted?(versions)
    UI.important(
      "#{bundle_id} (#{platform_filter}) has never been submitted for review; uploading " \
      "to TestFlight and skipping review submission. Complete the store listing and " \
      "submit the first version by hand, then stable-track runs will submit."
    )
    return false
  end

  release_pending_versions(app, platform_filter)
  cancel_waiting_review_submission(app, bundle_id, platform_filter)

  SETTLE_ATTEMPTS.times do |attempt|
    edit = app.get_edit_app_store_version(platform: platform_filter)
    outcome = "reused"
    if edit.nil? || edit.version_string != version_string
      outcome = edit.nil? ? "created" : "renamed"
      begin
        # Creates the version when there is none, renames a leftover editable
        # one (e.g. a rejected version from a previous cycle) otherwise.
        app.ensure_version!(version_string, platform: platform_filter)
        edit = app.get_edit_app_store_version(platform: platform_filter)
      rescue StandardError => e
        UI.verbose("Cannot set version #{version_string} yet: #{e.message}")
        edit = nil
      end
    end

    # deliver also needs an editable App Info (app-level metadata: name,
    # category — a separate Apple resource from the version above) to submit.
    # While it's locked, upload_to_app_store retries "Cannot find edit app info"
    # for ~20 minutes and then hard-fails, so wait for it here instead.
    if edit && edit.version_string == version_string && app.fetch_edit_app_info
      UI.success(
        "#{bundle_id} (#{platform_filter}): editable version #{version_string} ready (#{outcome})."
      )
      return true
    end

    blocker = app.get_pending_release_app_store_version(platform: platform_filter) ||
              app.get_in_review_app_store_version(platform: platform_filter)
    reason = if blocker
               "v#{blocker.version_string} is #{blocker.app_version_state}"
             elsif edit
               "App Info is still locked"
             else
               "no editable version yet"
             end
    UI.message(
      "#{bundle_id} (#{platform_filter}): waiting for the submit slot — " \
      "#{reason} (#{attempt + 1}/#{SETTLE_ATTEMPTS})"
    )
    sleep(SETTLE_INTERVAL) unless attempt == SETTLE_ATTEMPTS - 1
  end

  blocker = app.get_pending_release_app_store_version(platform: platform_filter) ||
            app.get_in_review_app_store_version(platform: platform_filter)
  held = blocker ? " v#{blocker.version_string} is #{blocker.app_version_state}." : ""
  UI.user_error!(
    "#{bundle_id} (#{platform_filter}): App Store Connect did not accept version " \
    "#{version_string} within #{SETTLE_ATTEMPTS * SETTLE_INTERVAL / 60} minutes.#{held} " \
    "Clear the blocking version — release-approved.yml releases an approved build, " \
    "or reject the submission in App Store Connect — and re-run."
  )
end

# Shorter wait than the binary lanes get: nothing in the metadata lanes frees
# the submit slot, so this only rides out a lock that is already clearing.
METADATA_ATTEMPTS = 10

# Apple counts a submitted version as "editable" (spaceship's
# get_edit_app_store_version filter includes WAITING_FOR_REVIEW) and does accept
# text metadata for it, but refuses screenshot changes with "Can't Delete
# Screenshot After Submit for review". So for the metadata lanes a version in
# that state is not editable at all.
def awaiting_review?(version)
  version.app_version_state == "WAITING_FOR_REVIEW" ||
    version.app_store_state == "WAITING_FOR_REVIEW"
end

# Take a version queued for review back out of the queue so its screenshots can
# be replaced. A WAITING_FOR_REVIEW submission has no reviewer assigned yet, so
# cancelling costs only queue position, and the caller puts the version straight
# back in once the upload is done. An IN_REVIEW submission is left alone —
# await_editable_version! then reports it as the blocker.
#
# Returns true when a submission was cancelled, meaning the caller must re-submit.
def unsubmit_for_metadata!(app, bundle_id, platform_filter)
  return false unless cancel_waiting_review_submission(app, bundle_id, platform_filter)

  METADATA_ATTEMPTS.times do |attempt|
    edit = app.get_edit_app_store_version(platform: platform_filter)
    unless edit && awaiting_review?(edit)
      UI.success(
        "#{bundle_id} (#{platform_filter}): submission cancelled; the version takes " \
        "screenshots again and is re-submitted after the upload."
      )
      return true
    end
    UI.message(
      "#{bundle_id} (#{platform_filter}): waiting for the cancelled submission to clear " \
      "(#{attempt + 1}/#{METADATA_ATTEMPTS})"
    )
    sleep(SETTLE_INTERVAL) unless attempt == METADATA_ATTEMPTS - 1
  end

  UI.user_error!(
    "#{bundle_id} (#{platform_filter}): v#{app.get_edit_app_store_version(platform: platform_filter)&.version_string} " \
    "is still WAITING_FOR_REVIEW #{METADATA_ATTEMPTS * SETTLE_INTERVAL / 60} minutes after " \
    "cancelling its submission. Re-run once App Store Connect has settled."
  )
end

# The version metadata gets written to. deliver needs an editable App Store
# version *and* an editable App Info — name, subtitle and privacy URL live on
# the app, not on the version — and Apple exposes neither while the previous
# version is in review or still being released.
#
# Raises when there is nothing to write to, rather than exiting green having
# uploaded nothing: a listing that silently stayed stale is worse than a red run.
def await_editable_version!(app, bundle_id, platform_filter)
  METADATA_ATTEMPTS.times do |attempt|
    edit = app.get_edit_app_store_version(platform: platform_filter)
    submitted = !edit.nil? && awaiting_review?(edit)
    if edit && !submitted && app.fetch_edit_app_info
      UI.success("#{bundle_id} (#{platform_filter}): writing metadata to v#{edit.version_string}.")
      return edit
    end

    blocker = app.get_pending_release_app_store_version(platform: platform_filter) ||
              app.get_in_review_app_store_version(platform: platform_filter)
    reason = if submitted
               "v#{edit.version_string} is WAITING_FOR_REVIEW"
             elsif blocker
               "v#{blocker.version_string} is #{blocker.app_version_state}"
             elsif edit
               "App Info is still locked"
             else
               "no editable version"
             end
    UI.message(
      "#{bundle_id} (#{platform_filter}): waiting for an editable version — " \
      "#{reason} (#{attempt + 1}/#{METADATA_ATTEMPTS})"
    )
    sleep(SETTLE_INTERVAL) unless attempt == METADATA_ATTEMPTS - 1
  end

  UI.user_error!(
    "#{bundle_id} (#{platform_filter}): no editable version to write metadata to — " \
    "every version is in review or live. Create the next version in App Store Connect, " \
    "or run publish-binary.yml first: it creates the version metadata attaches to."
  )
end

# Marketing version the binary carries, read from the pubspec the bump-version
# job produced. Same source the build used, so the two cannot disagree.
def target_version(app_name)
  pubspec = File.expand_path("../packages/#{app_name}/pubspec.yaml", __dir__)
  match = File.read(pubspec).match(/^version:\s*(\d+\.\d+\.\d+)/)
  UI.user_error!("No version found in #{pubspec}") unless match
  match[1]
end

# States in which a version has not gone live yet, so its release type still
# decides whether Apple publishes it automatically.
UNRELEASED_STATES = %w[
  PREPARE_FOR_SUBMISSION READY_FOR_REVIEW WAITING_FOR_REVIEW IN_REVIEW ACCEPTED
  PROCESSING_FOR_APP_STORE PENDING_APPLE_RELEASE PENDING_DEVELOPER_RELEASE
].freeze

# deliver only writes releaseType when automatic_release is passed, and the
# value is otherwise inherited from whatever App Store Connect already had. A
# version left on AFTER_APPROVAL goes live the moment review passes, skipping
# the release gate, so check every unreleased version and force MANUAL.
def ensure_manual_release(api_key, bundle_id, platform_filter)
  require "spaceship"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  app = Spaceship::ConnectAPI::App.find(bundle_id)
  UI.user_error!("App not found: #{bundle_id}") unless app

  versions = app.get_app_store_versions(filter: { "platform" => platform_filter })
               .select { |v| UNRELEASED_STATES.include?(v.app_store_state) }
  if versions.empty?
    UI.important("No unreleased #{platform_filter} version for #{bundle_id}; release type unchanged.")
    return
  end

  versions.each do |ver|
    if ver.release_type == Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::MANUAL
      UI.success("v#{ver.version_string} (#{platform_filter}) already releases manually.")
      next
    end
    UI.important("v#{ver.version_string} (#{platform_filter}) release type is " \
                 "#{ver.release_type || 'unset'}; setting it to MANUAL.")
    ver.update(attributes: {
      release_type: Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::MANUAL
    })
    UI.success("v#{ver.version_string} (#{platform_filter}) now releases manually.")
  end
end

# One-time signing bootstrap for a bundle ID that has no match profile yet.
# The regular codesign lanes run readonly, so they can never create the first
# certificate/profile for a new vertical. Run this manually (it WRITES to the
# certificates repo) via the match-bootstrap workflow.
# Requires the bundle ID to already exist in the Apple Developer portal and the
# app record to exist in App Store Connect.
lane :bootstrap_signing do
  setup_ci if ENV["CI"]
  app_name  = required_env!("APP_NAME")
  platform  = required_env!("MATCH_PLATFORM")   # "ios" or "macos"
  bundle_id = "org.growerp.#{app_name}"

  api_key = app_store_connect_api_key(
    key_id:                required_env!("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id:             required_env!("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content:           required_env!("APP_STORE_CONNECT_API_KEY_CONTENT"),
    is_key_content_base64: true,
    in_house:              false
  )
  options = {
    type: "appstore",
    platform: platform,
    app_identifier: [bundle_id],
    git_url: required_env!("MATCH_GIT_URL"),
    readonly: false,
    api_key: api_key
  }
  options[:additional_cert_types] = ["mac_installer_distribution"] if platform == "macos"
  # Regenerate the provisioning profile even if one exists — needed when a
  # freshly-minted profile doesn't reconcile with the current certificates and
  # the export fails with "profile doesn't include signing certificate ...".
  options[:force] = true if optional_env("MATCH_FORCE") == "true"
  auth = optional_env("MATCH_GIT_BASIC_AUTHORIZATION")
  options[:git_basic_authorization] = auth if auth
  sync_code_signing(**options)
  UI.success("Signing assets ready for #{bundle_id} (#{platform})")
end

lane :codesign do
  setup_ci if ENV["CI"]
  app_name = required_env!("APP_NAME")

  api_key = app_store_connect_api_key(
    key_id:                required_env!("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id:             required_env!("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content:           required_env!("APP_STORE_CONNECT_API_KEY_CONTENT"),
    is_key_content_base64: true,
    in_house:              false
  )
  options = {
    type: "appstore",
    platform: "ios",
    app_identifier: ["org.growerp.#{app_name}"],
    git_url: required_env!("MATCH_GIT_URL"),
    readonly: true,
    api_key: api_key
  }
  auth = optional_env("MATCH_GIT_BASIC_AUTHORIZATION")
  options[:git_basic_authorization] = auth if auth
  sync_code_signing(**options)

  if ENV["GITHUB_ENV"]
    bundle_id = "org.growerp.#{app_name}"
    profile_name = ENV["sigh_#{bundle_id}_appstore_profile-name"].to_s.strip
    unless profile_name.empty?
      File.open(ENV["GITHUB_ENV"], "a") { |f| f.puts "MATCH_IOS_PROFILE_NAME=#{profile_name}" }
      UI.message("MATCH_IOS_PROFILE_NAME=#{profile_name}")
    end
  end
end

lane :ci_build do
  app_name = required_env!("APP_NAME")
  bundle_id = "org.growerp.#{app_name}"
  profile_name = required_env!("MATCH_IOS_PROFILE_NAME")
  workspace_path = File.expand_path("../packages/#{app_name}/ios/Runner.xcworkspace", __dir__)
  # Dart obfuscation is driven by Xcode build settings, not the flutter CLI:
  # xcode_backend.dart forwards DART_OBFUSCATION / SPLIT_DEBUG_INFO straight to
  # `flutter assemble`, so passing them as xcargs is what makes gym's archive
  # obfuscated. Without SPLIT_DEBUG_INFO the Dart frames in App Store crash
  # reports are unreadable, so the CI job uploads this directory.
  symbols_path = File.expand_path("../packages/#{app_name}/build/symbols", __dir__)
  FileUtils.mkdir_p(symbols_path)
  build_app(
    workspace: workspace_path,
    scheme: "Runner",
    export_method: "app-store",
    export_options: {
      method: "app-store",
      provisioningProfiles: {
        bundle_id => profile_name
      }
    },
    buildlog_path: "/tmp/xcodebuild-ios-logs",
    disable_xcpretty: true,
    xcargs: [
      "GCC_OPTIMIZATION_LEVEL=s",
      "SWIFT_COMPILATION_MODE=wholemodule",
      "DART_OBFUSCATION=true",
      "SPLIT_DEBUG_INFO=\"#{symbols_path}\"",
      "CODE_SIGN_STYLE=Manual",
      "DEVELOPMENT_TEAM=P64T65C668",
      "PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\""
    ].join(" ")
  )
end

lane :upload do
  api_key = app_store_connect_api_key(
    key_id:                required_env!("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id:             required_env!("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content:           required_env!("APP_STORE_CONNECT_API_KEY_CONTENT"),
    is_key_content_base64: true,
    in_house:              false
  )
  submit_for_review = ENV.fetch("SUBMIT_FOR_REVIEW", "false") == "true"
  if submit_for_review
    app_name = required_env!("APP_NAME")
    # Creates the App Store version the build is about to fill. Only a
    # never-published app returns false (TestFlight); anything else raises.
    submit_for_review = prepare_edit_version!(
      api_key, "org.growerp.#{app_name}", "IOS", target_version(app_name)
    )
  end

  if submit_for_review
    # stable: create App Store version if missing, upload release notes, submit for review
    app_name      = required_env!("APP_NAME")
    metadata_path = File.expand_path("../packages/#{app_name}/ios/fastlane/metadata", __dir__)
    upload_to_app_store(
      api_key:                    api_key,
      app_identifier:             "org.growerp.#{app_name}",
      submit_for_review:          true,
      automatic_release:          false,
      run_precheck_before_submit: false,
      skip_metadata:              false,
      metadata_path:              metadata_path,
      skip_screenshots:           true,
      force:                      true
    )
    ensure_manual_release(api_key, "org.growerp.#{app_name}", "IOS")
  else
    # beta: upload to TestFlight only
    upload_to_testflight(
      api_key:                 api_key,
      itc_provider:            "P64T65C668",
      skip_submission:         true,
      notify_external_testers: false
    )
  end
end

lane :upload_metadata do
  app_name = required_env!("APP_NAME")
  api_key = app_store_connect_api_key(
    key_id:                required_env!("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id:             required_env!("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content:           required_env!("APP_STORE_CONNECT_API_KEY_CONTENT"),
    is_key_content_base64: true,
    in_house:              false
  )
  metadata_path    = File.expand_path("../packages/#{app_name}/ios/fastlane/metadata", __dir__)
  screenshots_path = File.expand_path("../packages/#{app_name}/ios/fastlane/screenshots", __dir__)
  has_screenshots  = Dir.exist?(screenshots_path) && !Dir.empty?(screenshots_path)

  # Metadata and screenshots can only be uploaded to an editable version
  # (not yet submitted for review). Editing the live version is intentionally
  # disabled — fastlane 2.232.2 has a bug (promotional_text NilClass) when
  # upload_to_app_store targets a "Ready for Sale" version via edit_live: true.
  require "spaceship"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  bundle_id = "org.growerp.#{app_name}"
  asc_app = Spaceship::ConnectAPI::App.find(bundle_id)
  UI.user_error!("App not found: #{bundle_id}") unless asc_app

  # A version already queued for review keeps its screenshots frozen, so it comes
  # out of the queue for the upload and goes straight back in below.
  resubmit = unsubmit_for_metadata!(asc_app, bundle_id, "IOS")

  await_editable_version!(asc_app, bundle_id, "IOS")

  options = {
    api_key:                    api_key,
    app_identifier:             bundle_id,
    skip_binary_upload:         true,
    skip_screenshots:           !has_screenshots,
    overwrite_screenshots:      has_screenshots,
    screenshots_path:           screenshots_path,
    metadata_path:              metadata_path,
    submit_for_review:          resubmit,
    run_precheck_before_submit: false,
    skip_app_version_update:    true,
    force:                      true,
  }
  # Only set when re-submitting: deliver writes releaseType whenever the option is
  # present, and the metadata-only path must not touch it.
  options[:automatic_release] = false if resubmit

  upload_to_app_store(options)
  ensure_manual_release(api_key, bundle_id, "IOS") if resubmit
end

lane :codesign_macos do
  setup_ci if ENV["CI"]

  api_key = app_store_connect_api_key(
    key_id:                required_env!("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id:             required_env!("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content:           required_env!("APP_STORE_CONNECT_API_KEY_CONTENT"),
    is_key_content_base64: true,
    in_house:              false
  )
  options = {
    type: "appstore",
    additional_cert_types: ["mac_installer_distribution"],
    platform: "macos",
    app_identifier: [required_env!("BUNDLE_ID")],
    git_url: required_env!("MATCH_GIT_URL"),
    readonly: true,
    api_key: api_key
  }
  auth = optional_env("MATCH_GIT_BASIC_AUTHORIZATION")
  options[:git_basic_authorization] = auth if auth
  sync_code_signing(**options)

  # After sync_code_signing, Match sets sigh_<bundle_id>_appstore_macos_profile-name
  # and sigh_<bundle_id>_appstore_macos_profile-path in the environment.
  # Write them to GITHUB_ENV so subsequent shell steps can use them directly,
  # avoiding fragile directory scans that break when Xcode changes install paths.
  if ENV["GITHUB_ENV"]
    bundle_id = required_env!("BUNDLE_ID")
    profile_name = ENV["sigh_#{bundle_id}_appstore_macos_profile-name"].to_s.strip
    profile_path = ENV["sigh_#{bundle_id}_appstore_macos_profile-path"].to_s.strip

    UI.user_error!("Match did not set profile-name for #{bundle_id}") if profile_name.empty?
    UI.user_error!("Match did not set profile-path for #{bundle_id}") if profile_path.empty?

    unless File.exist?(profile_path)
      UI.user_error!(
        "Match reported profile at #{profile_path} but the file does not exist on disk. " \
        "The profile may not have been installed to the Xcode UserData directory. " \
        "Run 'fastlane match appstore --platform macos' on a Mac to re-push the profiles."
      )
    end

    File.open(ENV["GITHUB_ENV"], "a") do |f|
      f.puts "MATCH_PROFILE_NAME=#{profile_name}"
      f.puts "MATCH_PROFILE_PATH=#{profile_path}"
    end
    UI.message("MATCH_PROFILE_NAME=#{profile_name}")
    UI.message("MATCH_PROFILE_PATH=#{profile_path}")
  end
end

lane :upload_macos do
  key_id      = required_env!("APP_STORE_CONNECT_API_KEY_ID")
  issuer_id   = required_env!("APP_STORE_CONNECT_API_ISSUER_ID")
  key_content = required_env!("APP_STORE_CONNECT_API_KEY_CONTENT")

  api_key = app_store_connect_api_key(
    key_id:                key_id,
    issuer_id:             issuer_id,
    key_content:           key_content,
    is_key_content_base64: true,
    in_house:              false
  )

  app_name   = required_env!("MATRIX_APP")
  # Use absolute path so both build_macos and upload_macos agree on location
  export_dir = File.expand_path("../../packages/#{app_name}/build/export", __dir__)

  pkg = Dir["#{export_dir}/*.pkg"].first
  UI.user_error!("No .pkg found in #{export_dir}") if pkg.nil?

  submit_for_review = ENV.fetch("SUBMIT_FOR_REVIEW", "false") == "true"
  # Creates the App Store version the build is about to fill. Only a
  # never-published app returns false (TestFlight); anything else raises.
  if submit_for_review
    submit_for_review = prepare_edit_version!(
      api_key, "org.growerp.#{app_name}", "MAC_OS", target_version(app_name)
    )
  end

  if submit_for_review
    metadata_path = File.expand_path("../packages/#{app_name}/macos/fastlane/metadata", __dir__)
    upload_to_app_store(
      api_key:                    api_key,
      app_identifier:             "org.growerp.#{app_name}",
      pkg:                        pkg,
      platform:                   "osx",
      skip_metadata:              false,
      metadata_path:              metadata_path,
      skip_screenshots:           true,
      submit_for_review:          true,
      automatic_release:          false,
      run_precheck_before_submit: false,
      force:                      true
    )
    ensure_manual_release(api_key, "org.growerp.#{app_name}", "MAC_OS")
  else
    upload_to_testflight(
      api_key:                 api_key,
      pkg:                     pkg,
      skip_submission:         true,
      notify_external_testers: false
    )
  end
end

# Check App Store Connect for versions in PENDING_DEVELOPER_RELEASE and release them.
# Required env vars:
#   ASC_PLATFORM            — "IOS" or "MAC_OS"
#   BUNDLE_ID               — e.g. org.growerp.admin
#   APP_STORE_CONNECT_API_KEY_ID / _ISSUER_ID / _KEY_CONTENT
#
# Writes "released=true|false" to $GITHUB_OUTPUT when running in CI.
lane :release_approved do
  platform_filter = required_env!("ASC_PLATFORM")
  bundle_id       = required_env!("BUNDLE_ID")

  api_key = app_store_connect_api_key(
    key_id:                required_env!("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id:             required_env!("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content:           required_env!("APP_STORE_CONNECT_API_KEY_CONTENT"),
    is_key_content_base64: true,
    in_house:              false
  )

  require "spaceship"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

  app = Spaceship::ConnectAPI::App.find(bundle_id)
  UI.user_error!("App not found for bundle ID: #{bundle_id}") unless app

  released = release_pending_versions(app, platform_filter)
  UI.message("No versions in PENDING_DEVELOPER_RELEASE for #{bundle_id} (#{platform_filter})") unless released

  if ENV["GITHUB_OUTPUT"]
    File.open(ENV["GITHUB_OUTPUT"], "a") { |f| f.puts "released=#{released}" }
  end
end

lane :upload_metadata_macos do
  app_name  = required_env!("MATRIX_APP")
  bundle_id = required_env!("BUNDLE_ID")
  api_key = app_store_connect_api_key(
    key_id:                required_env!("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id:             required_env!("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content:           required_env!("APP_STORE_CONNECT_API_KEY_CONTENT"),
    is_key_content_base64: true,
    in_house:              false
  )
  metadata_path    = File.expand_path("../packages/#{app_name}/macos/fastlane/metadata", __dir__)
  screenshots_path = File.expand_path("../packages/#{app_name}/macos/fastlane/screenshots", __dir__)
  has_screenshots  = Dir.exist?(screenshots_path) && !Dir.empty?(screenshots_path)

  # Metadata and screenshots can only be uploaded to an editable version.
  # No edit_live — fastlane 2.232.2 promotional_text NilClass bug on live versions.
  require "spaceship"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  asc_app = Spaceship::ConnectAPI::App.find(bundle_id)
  UI.user_error!("App not found: #{bundle_id}") unless asc_app

  # See upload_metadata: screenshots are frozen while the version sits in review.
  resubmit = unsubmit_for_metadata!(asc_app, bundle_id, "MAC_OS")

  await_editable_version!(asc_app, bundle_id, "MAC_OS")

  options = {
    api_key:                    api_key,
    platform:                   "osx",
    app_identifier:             bundle_id,
    skip_binary_upload:         true,
    skip_screenshots:           !has_screenshots,
    overwrite_screenshots:      has_screenshots,
    screenshots_path:           screenshots_path,
    metadata_path:              metadata_path,
    submit_for_review:          resubmit,
    run_precheck_before_submit: false,
    skip_app_version_update:    true,
    force:                      true,
  }
  options[:automatic_release] = false if resubmit

  upload_to_app_store(options)
  ensure_manual_release(api_key, bundle_id, "MAC_OS") if resubmit
end

lane :build_macos do
  setup_ci if ENV["CI"]

  app       = required_env!("MATRIX_APP")
  build_num = required_env!("MACOS_BUILD_NUMBER")
  profile   = required_env!("MATCH_PROFILE_NAME")
  bundle_id = required_env!("BUNDLE_ID")

  # See ci_build: obfuscation has to travel as Xcode build settings.
  symbols_path = File.expand_path("../packages/#{app}/build/symbols", __dir__)
  FileUtils.mkdir_p(symbols_path)

  build_mac_app(
    workspace:            "packages/#{app}/macos/Runner.xcworkspace",
    scheme:               "Runner",
    configuration:        "Release",
    export_method:        "app-store",
    codesigning_identity: "Apple Distribution",
    # Pin the .pkg installer identity so it always lands in the exportOptionsPlist.
    # gym's auto-detection is unreliable (works for some apps, silently omits it
    # for others); when the key is absent Xcode auto-picks and then fails with
    # "provisioning profile doesn't include signing certificate 3rd Party Mac
    # Developer Installer". Setting it explicitly makes every app behave like the
    # already-working ones.
    installer_cert_name:  "3rd Party Mac Developer Installer: Johannes Bakker (P64T65C668)",
    xcargs: [
      "CURRENT_PROJECT_VERSION=#{build_num}",
      "DEVELOPMENT_TEAM=P64T65C668",
      "DART_OBFUSCATION=true",
      "SPLIT_DEBUG_INFO=\"#{symbols_path}\"",
      "CODE_SIGN_STYLE=Manual",
      "PROVISIONING_PROFILE_SPECIFIER=\"#{profile}\""
    ].join(" "),
    export_options: {
      provisioningProfiles: {
        bundle_id => profile
      }
    },
    output_directory: File.expand_path("../../packages/#{app}/build/export", __dir__),
    buildlog_path:    "/tmp/xcodebuild-macos-logs"
  )
end