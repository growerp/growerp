<?xml version="1.0" encoding="UTF-8"?>
<!-- Agent trust foundation: gate, scope, tenant-pin, log and (when required) queue for
     human approval every tool/service action an ADK agent attempts. Lives in moqui-adk
     because it owns AdkAgentConfig / AdkActionLog / AdkApproval and the GrowERP ChatRoom.
     moqui-mcp calls govern#AgentAction only when it is defined (isServiceDefined guard),
     so the MCP server still works when moqui-adk is not installed. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ─────────────────────────────────────────────────────────────────────────
         check#TokenAllowance — may this tenant spend more LLM tokens this month?
         Own key (explicit apiKey or an LlmConfig row for the provider): only the cap the
         tenant set on itself (SystemSettings.ownTokenLimit). System key: the per tenant
         override (SystemSettings.llmMonthlyTokenLimit) else the GrowERP wide free allowance
         (SystemDefault.llmMonthlyTokenLimit); 0/empty = unlimited. Used before every agent
         run (AdkManager) and every governed tool call.
         ───────────────────────────────────────────────────────────────────────── -->
    <service verb="check" noun="TokenAllowance" authenticate="false">
        <in-parameters>
            <parameter name="ownerPartyId"/>
            <parameter name="llmProvider" default-value="gemini"/>
            <parameter name="apiKey"/>
        </in-parameters>
        <out-parameters>
            <parameter name="allowed" type="Boolean"/>
            <parameter name="message"/>
            <parameter name="tokensUsed" type="Long"/>
            <parameter name="tokenLimit" type="Long"/>
        </out-parameters>
        <actions>
            <set field="allowed" from="true"/>
            <if condition="!ownerPartyId || ownerPartyId == '_NA_'"><return/></if>

            <set field="hasOwnKey" from="apiKey ? true : false"/>
            <if condition="!hasOwnKey">
                <entity-find-one entity-name="growerp.general.LlmConfig" value-field="llmConfig"/>
                <set field="hasOwnKey" from="llmConfig?.apiKey ? true : false"/>
            </if>
            <entity-find-one entity-name="growerp.general.SystemSettings" value-field="ownerSettings"/>
            <if condition="hasOwnKey">
                <set field="tokenLimit" from="ownerSettings?.ownTokenLimit ?: 0" type="Long"/>
                <else-if condition="ownerSettings?.llmMonthlyTokenLimit != null">
                    <set field="tokenLimit" from="ownerSettings.llmMonthlyTokenLimit" type="Long"/>
                </else-if>
                <else>
                    <entity-find-one entity-name="growerp.general.SystemDefault" value-field="sysDefault"
                        auto-field-map="[defaultId: 'SYSTEM']"/>
                    <!-- no row at all (upgraded install, seed not loaded) → seed value -->
                    <set field="tokenLimit" type="Long"
                        from="sysDefault == null ? 100000 : (sysDefault.llmMonthlyTokenLimit ?: 0)"/>
                </else>
            </if>
            <if condition="tokenLimit &lt;= 0"><return/></if>

            <set field="startOfMonth" from="new java.sql.Timestamp(java.time.LocalDate.now().withDayOfMonth(1)
                .atStartOfDay(java.time.ZoneId.systemDefault()).toInstant().toEpochMilli())"/>
            <!-- grouped view: one row per owner, summed in SQL -->
            <entity-find entity-name="moqui.adk.AdkOwnerTokenSummary" list="usageList">
                <econdition field-name="ownerPartyId"/>
                <econdition field-name="actionTime" operator="greater-equals" from="startOfMonth"/>
                <select-field field-name="ownerPartyId,tokensTotal"/>
            </entity-find>
            <set field="tokensUsed" from="usageList.sum { (it.tokensTotal ?: 0) as long } ?: 0" type="Long"/>
            <if condition="tokensUsed &gt;= tokenLimit">
                <set field="allowed" from="false"/>
                <set field="message" from="hasOwnKey
                    ? &quot;Own monthly LLM token limit reached (${tokensUsed} of ${tokenLimit} tokens). Raise or clear it in System Setup -> AI Settings.&quot;
                    : &quot;Free monthly LLM allowance used (${tokensUsed} of ${tokenLimit} tokens). Please add your own API Key in System Setup -> AI Settings.&quot;"/>
            </if>
        </actions>
    </service>

    <!-- ─────────────────────────────────────────────────────────────────────────
         govern#AgentAction — pre-execution decision for one agent service call.
         Returns decision = allowed | blocked | pending, plus owner-pinned parameters.
         Always writes an AdkActionLog row; for pending it also creates an AdkApproval
         and posts an approval card to the agent's approval chat room.
         ───────────────────────────────────────────────────────────────────────── -->
    <service verb="govern" noun="AgentAction" authenticate="false" transaction-timeout="60">
        <description>Gate an agent's service call: classify verb, enforce scope, pin tenant,
            audit-log, and queue write actions for human approval per the agent's writePolicy.</description>
        <in-parameters>
            <parameter name="configId"/>
            <!-- coordinator that delegated to this agent, when part of a team (Phase 4) -->
            <parameter name="parentConfigId"/>
            <parameter name="toolName"/>
            <parameter name="serviceName" required="true"/>
            <parameter name="parameters" type="Map"><default>[:]</default></parameter>
            <parameter name="adkSessionId"/>
        </in-parameters>
        <out-parameters>
            <!-- allowed: caller may execute serviceName(parameters)
                 blocked: caller must NOT execute; surface message to the agent
                 pending: queued for approval; caller must NOT execute -->
            <parameter name="decision"/>
            <parameter name="parameters" type="Map"/>
            <parameter name="message"/>
            <parameter name="adkActionLogId"/>
        </out-parameters>
        <actions>
            <!-- Resolve the agent config (and therefore the tenant) -->
            <if condition="configId">
                <entity-find-one entity-name="moqui.adk.AdkAgentConfig" value-field="cfg"
                    auto-field-map="[adkAgentConfigId: configId]"/>
            </if>

            <!-- Classify + decide. Uses the Moqui service-definition API (Java), so Groovy. -->
            <script><![CDATA[
                def sd = ec.service.getServiceDefinition(serviceName)
                // Moqui verb convention mirrors authz-action derivation: these are reads,
                // everything else (create/update/delete/store/send/...) is a write.
                def READ_VERBS = ['get','find','search','view','list','check','calculate',
                                  'validate','count','export'] as Set
                // Implicit entity-auto CRUD (create#/get#/update#/delete#<Entity>) has NO
                // ServiceDefinition, so fall back to the verb prefix of the service name —
                // otherwise every entity-auto call is misclassified as a write.
                def verb = sd?.verb ?: (serviceName?.contains('#') ? serviceName.substring(0, serviceName.indexOf('#')) : '')
                verbClass = READ_VERBS.contains(verb) ? 'read' : 'write'

                def pinned = new LinkedHashMap(parameters ?: [:])
                ownerPartyId = cfg?.ownerPartyId
                agentPartyId = cfg?.agentPartyId
                // Does the target accept an ownerPartyId? Defined services: read the in-params.
                // Entity-auto CRUD: inspect the entity's fields so tenant-pinning still applies.
                def acceptsOwner = false
                if (sd != null) {
                    acceptsOwner = sd.getInParameterNames()?.contains('ownerPartyId') ?: false
                } else if (serviceName?.contains('#')) {
                    try {
                        String entName = serviceName.substring(serviceName.indexOf('#') + 1)
                        def ed = ec.entity.getEntityDefinition(entName)
                        acceptsOwner = ed?.getAllFieldNames()?.contains('ownerPartyId') ?: false
                    } catch (ignored) { }
                }
                tenantViolation = false
                if (ownerPartyId && acceptsOwner) {
                    if (pinned.ownerPartyId && (pinned.ownerPartyId as String) != (ownerPartyId as String))
                        tenantViolation = true
                    pinned.ownerPartyId = ownerPartyId   // pin to the agent's own tenant
                }
                parameters = pinned

                // New agents are created with explicit safe defaults (readOnly/approve) by
                // AdkServices.update#AgentConfig. A null here therefore means a legacy row
                // created before governance existed → treat as unrestricted so existing
                // agents (e.g. the CI Monitor) keep working until an admin scopes them.
                def toolMode    = cfg?.toolMode ?: 'full'
                def writePolicy = cfg?.writePolicy ?: 'allow'
                decision = 'allowed'
                message  = null

                if (tenantViolation) {
                    decision = 'blocked'
                    message  = "Cross-tenant access denied: agent may only act on its own company."
                } else if (cfg == null) {
                    // No agent config resolved (e.g. MCP called outside an ADK agent, or
                    // configId not propagated). Allow but flag — preserves legacy behaviour.
                    decision = 'allowed'
                    message  = 'ungoverned: no agent config resolved'
                } else {
                    if (toolMode == 'readOnly' && verbClass == 'write') {
                        decision = 'blocked'
                        message  = "This agent is read-only and may not run '${serviceName}'."
                    } else if (toolMode == 'scoped') {
                        def globs = ((cfg.serviceAllowlist ?: '') as String).split(/[,\s]+/).findAll { it }
                        def ok = globs.any { g ->
                            // glob → regex: quote the literal parts, '*' → '.*'
                            // (do NOT Pattern.quote the whole glob first — quote() wraps in
                            // \Q..\E so the '*' is never found as '\*' and stays literal)
                            def rx = '^' + g.split(/\*/, -1).collect {
                                it ? java.util.regex.Pattern.quote(it) : ''
                            }.join('.*') + '$'
                            serviceName ==~ rx
                        }
                        if (!ok) {
                            decision = 'blocked'
                            message  = "'${serviceName}' is not in this agent's allowed-service list."
                        }
                    }
                    if (decision == 'allowed') {
                        def allowance = ec.service.sync().name('AdkGovernanceServices.check#TokenAllowance')
                            .parameters([ownerPartyId: ownerPartyId, apiKey: cfg?.apiKey,
                                         llmProvider: cfg?.llmProvider ?: 'gemini']).call()
                        if (allowance?.allowed == false) {
                            decision = 'blocked'
                            message = allowance.message
                        }
                    }
                    if (decision == 'allowed' && verbClass == 'write') {
                        // Direction-ambiguous services: create#Order/Invoice/Payment/Shipment
                        // (and their update# siblings) are shared by sales AND purchase — the
                        // only thing that tells them apart is a 'sales' boolean buried in the
                        // call's own parameters, which a serviceAllowlist glob can never see.
                        // A misconfigured writePolicy=allow could otherwise let an agent meant
                        // only for one direction quietly write the other. Force human review on
                        // these regardless of the agent's own writePolicy.
                        def effectiveWritePolicy = writePolicy
                        if (writePolicy == 'allow') {
                            def directionAmbiguous = [
                                'create#Order', 'update#Order', 'create#Invoice', 'update#Invoice',
                                'create#Payment', 'update#Payment', 'create#Shipment'
                            ]
                            if (directionAmbiguous.any { serviceName?.endsWith(".${it}") }) {
                                effectiveWritePolicy = 'approve'
                            }
                        }
                        if (effectiveWritePolicy == 'block') {
                            decision = 'blocked'
                            message  = "Write actions are disabled for this agent."
                        } else if (effectiveWritePolicy == 'approve') {
                            decision = 'pending'
                            message  = "Action queued for human approval before it runs."
                        }
                    }
                }
                argsJson = groovy.json.JsonOutput.toJson(pinned)
            ]]></script>

            <!-- Audit log (always) -->
            <service-call name="create#moqui.adk.AdkActionLog" out-map="logOut"
                in-map="[ownerPartyId: ownerPartyId, configId: configId, parentConfigId: parentConfigId,
                         adkSessionId: adkSessionId, agentPartyId: agentPartyId, toolName: toolName,
                         serviceName: serviceName, argsJson: argsJson, verbClass: verbClass,
                         decision: decision, reason: message, actionTime: ec.user.nowTimestamp,
                         tokensIn: 0, tokensOut: 0, tokensTotal: 0]"/>
            <set field="adkActionLogId" from="logOut.adkActionLogId"/>

            <!-- Pending → create approval + post an approval card to the agent's chat room -->
            <if condition="decision == 'pending'">
                <service-call name="create#moqui.adk.AdkApproval" out-map="apprOut"
                    in-map="[ownerPartyId: ownerPartyId, adkActionLogId: adkActionLogId,
                             configId: configId, serviceName: serviceName, argsJson: argsJson,
                             status: 'pending', requestedByUserId: ec.user.userId,
                             requestTime: ec.user.nowTimestamp]"/>
                <if condition="cfg?.approvalChatRoomId">
                    <set field="cardText" from="'🔔 Approval needed — agent &quot;' + (cfg.agentName ?: 'Agent') +
                        '&quot; wants to run ' + serviceName + '\n' + argsJson +
                        '\nApprove/Reject in ADK → Approvals (id ' + apprOut.adkApprovalId + ').'"/>
                    <service-call name="AdkGovernanceServices.post#AgentChatMessage"
                        in-map="[chatRoomId: cfg.approvalChatRoomId, ownerPartyId: ownerPartyId,
                                 agentName: cfg.agentName, content: cardText]"/>
                </if>
            </if>
        </actions>
    </service>

    <!-- record#AgentResult — post-execution: stash a short result + token usage on the log row -->
    <service verb="record" noun="AgentResult" authenticate="false">
        <description>Attach execution result summary and token usage to an AdkActionLog row.</description>
        <in-parameters>
            <parameter name="adkActionLogId" required="true"/>
            <parameter name="resultSummary"/>
            <parameter name="tokensIn"  type="Long"/>
            <parameter name="tokensOut" type="Long"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="moqui.adk.AdkActionLog" value-field="row" for-update="true"/>
            <if condition="row">
                <set field="row.resultSummary" from="resultSummary != null ? (resultSummary.toString().take(2000)) : row.resultSummary"/>
                <if condition="tokensIn != null"><set field="row.tokensIn" from="tokensIn"/></if>
                <if condition="tokensOut != null"><set field="row.tokensOut" from="tokensOut"/></if>
                <if condition="tokensIn != null || tokensOut != null">
                    <set field="row.tokensTotal" from="(row.tokensIn ?: 0) + (row.tokensOut ?: 0)"/>
                </if>
                <entity-update value-field="row"/>
            </if>
        </actions>
    </service>

    <!-- ─────────────────────────────────────────────────────────────────────────
         approve / reject — decide a pending AdkApproval. Owner-scoped: callerOwnerPartyId
         must match the approval's ownerPartyId. On approve, runs the stored service.
         ───────────────────────────────────────────────────────────────────────── -->
    <service verb="approve" noun="AdkApproval" authenticate="false" transaction-timeout="300">
        <description>Approve a pending agent action and execute the stored service.</description>
        <in-parameters>
            <parameter name="adkApprovalId" required="true"/>
            <parameter name="callerOwnerPartyId"/>
            <parameter name="decidedByUserId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="status"/>
            <parameter name="resultSummary"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.adk.AdkApproval" value-field="appr" for-update="true"/>
            <if condition="appr == null"><return error="true" message="Approval not found"/></if>
            <if condition="callerOwnerPartyId &amp;&amp; appr.ownerPartyId != callerOwnerPartyId">
                <return error="true" message="Not authorized: approval belongs to another company."/>
            </if>
            <if condition="appr.status != 'pending'">
                <return error="true" message="Approval already ${appr.status}."/>
            </if>
            <script><![CDATA[
                def args = appr.argsJson ? new groovy.json.JsonSlurper().parseText(appr.argsJson as String) : [:]
                def res
                try {
                    res = ec.service.sync().name(appr.serviceName as String).parameters(args).call()
                    resultSummary = groovy.json.JsonOutput.toJson(res).take(2000)
                    status = 'approved'
                } catch (Exception e) {
                    resultSummary = "Execution failed: ${e.message}"
                    status = 'approved'   // decision stands; record the failure
                }
            ]]></script>
            <set field="appr.status" value="approved"/>
            <set field="appr.decidedByUserId" from="decidedByUserId ?: ec.user.userId"/>
            <set field="appr.decisionTime" from="ec.user.nowTimestamp"/>
            <entity-update value-field="appr"/>
            <if condition="appr.adkActionLogId">
                <service-call name="AdkGovernanceServices.record#AgentResult"
                    in-map="[adkActionLogId: appr.adkActionLogId, resultSummary: resultSummary]"/>
                <entity-find-one entity-name="moqui.adk.AdkActionLog" value-field="lg" for-update="true"
                    auto-field-map="[adkActionLogId: appr.adkActionLogId]"/>
                <if condition="lg"><set field="lg.decision" value="approved"/><entity-update value-field="lg"/></if>
            </if>
        </actions>
    </service>

    <service verb="reject" noun="AdkApproval" authenticate="false">
        <description>Reject a pending agent action; the stored service is never run.</description>
        <in-parameters>
            <parameter name="adkApprovalId" required="true"/>
            <parameter name="callerOwnerPartyId"/>
            <parameter name="decidedByUserId"/>
        </in-parameters>
        <out-parameters><parameter name="status"/></out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.adk.AdkApproval" value-field="appr" for-update="true"/>
            <if condition="appr == null"><return error="true" message="Approval not found"/></if>
            <if condition="callerOwnerPartyId &amp;&amp; appr.ownerPartyId != callerOwnerPartyId">
                <return error="true" message="Not authorized: approval belongs to another company."/>
            </if>
            <if condition="appr.status != 'pending'">
                <return error="true" message="Approval already ${appr.status}."/>
            </if>
            <set field="appr.status" value="rejected"/>
            <set field="appr.decidedByUserId" from="decidedByUserId ?: ec.user.userId"/>
            <set field="appr.decisionTime" from="ec.user.nowTimestamp"/>
            <entity-update value-field="appr"/>
            <set field="status" value="rejected"/>
            <if condition="appr.adkActionLogId">
                <entity-find-one entity-name="moqui.adk.AdkActionLog" value-field="lg" for-update="true"
                    auto-field-map="[adkActionLogId: appr.adkActionLogId]"/>
                <if condition="lg"><set field="lg.decision" value="rejected"/><entity-update value-field="lg"/></if>
            </if>
        </actions>
    </service>

    <!-- post#AgentChatMessage — shared helper: post a system message to a GrowERP chat room
         (creating the room if needed) and push it over WebSocket to the other members.
         Mirrors the proven path in AdkSchedulerServices. -->
    <service verb="post" noun="AgentChatMessage" authenticate="false">
        <in-parameters>
            <parameter name="chatRoomId" required="true"/>
            <parameter name="ownerPartyId"/>
            <parameter name="agentName"/>
            <parameter name="content" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="growerp.general.ChatRoom" value-field="chatRoom"
                auto-field-map="[chatRoomId: chatRoomId]" disable-authz="true"/>
            <if condition="!chatRoom">
                <entity-make-value entity-name="growerp.general.ChatRoom" value-field="newRoom"/>
                <set field="newRoom.chatRoomId"   from="chatRoomId"/>
                <set field="newRoom.chatRoomName" value="ADK: ${agentName ?: 'Agent'}"/>
                <set field="newRoom.isPrivate"    value="N"/>
                <set field="newRoom.isActive"     value="Y"/>
                <set field="newRoom.ownerPartyId" from="ownerPartyId"/>
                <entity-create value-field="newRoom"/>
            </if>
            <entity-find entity-name="moqui.security.UserAccount" list="sysUserList">
                <econdition field-name="username" value="SystemSupport"/>
                <limit>1</limit>
            </entity-find>
            <set field="fromUserId" from="sysUserList ? sysUserList[0].userId : null"/>
            <if condition="!fromUserId"><return/></if>
            <service-call name="create#growerp.general.ChatMessage" disable-authz="true"
                in-map="[chatRoomId: chatRoomId, fromUserId: fromUserId, content: content]"/>
            <entity-find entity-name="growerp.general.ChatRoomMember" list="chatMembers" for-update="true">
                <econdition field-name="chatRoomId" from="chatRoomId"/>
                <econdition field-name="isActive" value="Y"/>
            </entity-find>
            <set field="pushUserIds" from="[]"/>
            <iterate list="chatMembers" entry="member">
                <if condition="member.userId != fromUserId">
                    <set field="member.hasRead" value="N"/>
                    <entity-update value-field="member"/>
                    <script>pushUserIds.add(member.userId as String)</script>
                </if>
            </iterate>
            <if condition="pushUserIds">
                <script><![CDATA[
                    org.moqui.impl.webapp.ChatEndpoint.pushToMembers(
                        groovy.json.JsonOutput.toJson([
                            chatRoom  : [chatRoomId: chatRoomId],
                            fromUserId: fromUserId,
                            content   : content,
                        ]),
                        pushUserIds)
                ]]></script>
            </if>
        </actions>
    </service>

    <!-- expire#AdkApprovals — housekeeping: flip stale pending rows to expired -->
    <service verb="expire" noun="AdkApprovals" authenticate="false">
        <actions>
            <entity-find entity-name="moqui.adk.AdkApproval" list="stale" for-update="true">
                <econdition field-name="status" value="pending"/>
                <econdition field-name="expireTime" operator="less" from="ec.user.nowTimestamp"/>
                <econdition field-name="expireTime" operator="is-not-null"/>
            </entity-find>
            <iterate list="stale" entry="row">
                <set field="row.status" value="expired"/>
                <entity-update value-field="row"/>
            </iterate>
        </actions>
    </service>

    <!-- The tenant's agent user: MCP tool calls of an ADK agent run as this user (instead of
         SystemSupport) so services that resolve the tenant from the logged-in user
         (get#RelatedCompanyAndOwner) read and write inside the agent's own company.
         Same party as AdkChatServices.ensure#AgentChatUser. The account has no password
         (internal login only) and the least internal group, GROWERP_M_EMPLOYEE; which
         services the agent may call is still decided by govern#AgentAction. -->
    <service verb="ensure" noun="AgentUser" authenticate="anonymous-all">
        <in-parameters>
            <parameter name="ownerPartyId" required="true"/>
            <parameter name="adkAgentConfigId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="agentUsername"/>
        </out-parameters>
        <actions>
            <if condition="ownerPartyId == '_NA_'"><return/></if>
            <if condition="adkAgentConfigId">
                <entity-find-one entity-name="moqui.adk.AdkAgentConfig" value-field="cfg"
                    auto-field-map="[adkAgentConfigId: adkAgentConfigId]"/>
            </if>
            <set field="agentPartyId" from="cfg?.agentPartyId ?: ('AGENT_' + ownerPartyId)"/>
            <entity-find-one entity-name="mantle.party.Party" value-field="agentParty"
                auto-field-map="[partyId: agentPartyId]" for-update="true"/>
            <if condition="!agentParty">
                <service-call name="create#mantle.party.Party"
                    in-map="[partyId: agentPartyId, partyTypeEnumId: 'PtyPerson', ownerPartyId: ownerPartyId]"/>
                <service-call name="create#mantle.party.Person"
                    in-map="[partyId: agentPartyId, firstName: 'AI', lastName: 'Agent']"/>
                <else-if condition="!agentParty.ownerPartyId">
                    <!-- party created earlier by ensure#AgentChatUser without an owner -->
                    <set field="agentParty.ownerPartyId" from="ownerPartyId"/>
                    <entity-update value-field="agentParty"/>
                </else-if>
                <else-if condition="agentParty.ownerPartyId != ownerPartyId">
                    <return error="true" message="Agent party ${agentPartyId} belongs to another company."/>
                </else-if>
            </if>
            <!-- employee of the tenant's main company -->
            <entity-find entity-name="mantle.party.PartyDetailAndRole" list="companyList" limit="1">
                <econdition field-name="ownerPartyId" from="ownerPartyId"/>
                <econdition field-name="partyTypeEnumId" value="PtyOrganization"/>
                <econdition field-name="roleTypeId" value="OrgInternal"/>
            </entity-find>
            <if condition="companyList">
                <entity-find entity-name="mantle.party.PartyRelationship" list="empRels" limit="1">
                    <econdition field-name="fromPartyId" from="agentPartyId"/>
                    <econdition field-name="toPartyId" from="companyList[0].partyId"/>
                    <econdition field-name="relationshipTypeEnumId" value="PrtEmployee"/>
                    <date-filter/>
                </entity-find>
                <if condition="!empRels">
                    <service-call name="create#mantle.party.PartyRelationship"
                        in-map="[fromPartyId: agentPartyId, fromRoleTypeId: 'Employee',
                                 toPartyId: companyList[0].partyId, toRoleTypeId: 'OrgInternal',
                                 relationshipTypeEnumId: 'PrtEmployee', fromDate: ec.user.nowTimestamp]"/>
                </if>
            </if>
            <!-- enabled account without a password: only an internal login can use it -->
            <entity-find entity-name="moqui.security.UserAccount" list="agentAccts" limit="1" for-update="true">
                <econdition field-name="partyId" from="agentPartyId"/>
            </entity-find>
            <if condition="agentAccts">
                <set field="agentAcct" from="agentAccts[0]"/>
                <if condition="agentAcct.disabled == 'Y'">
                    <set field="agentAcct.disabled" value="N"/>
                    <entity-update value-field="agentAcct"/>
                </if>
                <set field="agentUserId" from="agentAcct.userId"/>
                <set field="agentUsername" from="agentAcct.username"/>
                <else>
                    <set field="agentUsername" from="'agent-' + agentPartyId"/>
                    <service-call name="create#moqui.security.UserAccount" out-map="newAcct"
                        in-map="[partyId: agentPartyId, username: agentUsername,
                                 userFullName: 'AI Agent', disabled: 'N', requirePasswordChange: 'N']"/>
                    <set field="agentUserId" from="newAcct.userId"/>
                </else>
            </if>
            <entity-find entity-name="moqui.security.UserGroupMember" list="groupMembers" limit="1">
                <econdition field-name="userId" from="agentUserId"/>
                <econdition field-name="userGroupId" value="GROWERP_M_EMPLOYEE"/>
                <date-filter/>
            </entity-find>
            <if condition="!groupMembers">
                <service-call name="create#moqui.security.UserGroupMember"
                    in-map="[userGroupId: 'GROWERP_M_EMPLOYEE', userId: agentUserId, fromDate: ec.user.nowTimestamp]"/>
            </if>
        </actions>
    </service>

</services>
