<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- Clone "_NA_" template AdkAgentConfig/AdkAgentTeamMember rows into a tenant, restricted
         either to one teamName or to an explicit list of template ids (the agent-catalog
         picker). Shared by enable#MarketingAgentTeam (teamName "Marketing Team"), load#AgentTeam
         (teamName given -> clones a whole named team, e.g. "GrowERP Operations Team") and the
         catalog picker (adkAgentConfigIds given -> clones exactly the selected agents).
         Idempotent: re-running upserts agents by (ownerPartyId, agentName) and skips team links
         that already exist. No GROWERP block here: whether GROWERP itself may load a given team
         is a per-caller decision (enable#MarketingAgentTeam blocks it — GROWERP runs its own
         marketing agents; load#AgentTeam does not — the Operations Team is a generic team
         GROWERP-the-company can use for its own ERP operations too). -->
    <service verb="clone" noun="AgentTeam" transaction-timeout="600">
        <in-parameters>
            <parameter name="ownerPartyId" required="true"/>
            <parameter name="teamName"/>
            <parameter name="adkAgentConfigIds" type="List">
                <description>Explicit template ids to clone instead of a whole teamName (the
                    function-catalog picker). Any selected specialist's coordinator is
                    auto-included even if not itself selected, since a specialist is unreachable
                    without one.</description>
            </parameter>
        </in-parameters>
        <actions>
            <if condition="ownerPartyId == '_NA_'">
                <return message="Agent team not loaded for owner ${ownerPartyId}"/>
            </if>

            <!-- Auto-include the coordinator of any selected specialist, so picking a specialist
                 alone from the catalog still leaves it reachable. -->
            <if condition="adkAgentConfigIds">
                <script>
                    def selectedIds = new LinkedHashSet(adkAgentConfigIds)
                    ec.entity.find('moqui.adk.AdkAgentTeamMember').condition('ownerPartyId', '_NA_').list().each { tm ->
                        if (selectedIds.contains(tm.memberConfigId)) selectedIds.add(tm.coordinatorConfigId)
                    }
                    adkAgentConfigIds = selectedIds as List
                </script>
            </if>

            <!-- 1. Clone each template agent config into the tenant. update#AgentConfig (no id)
                 upserts by (ownerPartyId, agentName), assigns agentPartyId and registers the
                 runtime. Map template id -> new tenant id for the team links below. -->
            <set field="idMap" from="[:]"/>
            <if condition="adkAgentConfigIds">
                <then>
                    <entity-find entity-name="moqui.adk.AdkAgentConfig" list="templates">
                        <econdition field-name="ownerPartyId" value="_NA_"/>
                        <econdition field-name="adkAgentConfigId" operator="in" from="adkAgentConfigIds"/>
                        <order-by field-name="adkAgentConfigId"/>
                    </entity-find>
                </then>
                <else>
                    <entity-find entity-name="moqui.adk.AdkAgentConfig" list="templates">
                        <econdition field-name="ownerPartyId" value="_NA_"/>
                        <econdition field-name="teamName" from="teamName" ignore-if-empty="true"/>
                        <order-by field-name="adkAgentConfigId"/>
                    </entity-find>
                </else>
            </if>
            <iterate list="templates" entry="tmpl">
                <service-call name="AdkServices.update#AgentConfig" out-map="cfgOut"
                    in-map="[ownerPartyId: ownerPartyId,
                             agentName: tmpl.agentName, modelName: tmpl.modelName,
                             llmProvider: tmpl.llmProvider, instruction: tmpl.instruction,
                             description: tmpl.description,
                             scheduleExpression: tmpl.scheduleExpression,
                             scheduleEnabled: tmpl.scheduleEnabled,
                             schedulePrompt: tmpl.schedulePrompt,
                             toolMode: tmpl.toolMode, serviceAllowlist: tmpl.serviceAllowlist,
                             writePolicy: tmpl.writePolicy, websiteChat: tmpl.websiteChat,
                             agentRole: tmpl.agentRole, orchestrationType: tmpl.orchestrationType,
                             loopMaxIterations: tmpl.loopMaxIterations, teamName: tmpl.teamName]"/>
                <script>idMap[tmpl.adkAgentConfigId] = cfgOut.adkAgentConfigId</script>
                <!-- Scheduled agents need a room to report output/errors to. ChatRoom ids are a
                     global PK, so a literal id can't be hardcoded in the _NA_ template (it would
                     collide across tenants) — self-reference the newly-sequenced config id instead,
                     which is unique per tenant. -->
                <if condition="tmpl.scheduleEnabled == 'Y'">
                    <service-call name="AdkServices.update#AgentConfig"
                        in-map="[adkAgentConfigId: cfgOut.adkAgentConfigId, ownerPartyId: ownerPartyId,
                                 agentName: tmpl.agentName, modelName: tmpl.modelName,
                                 llmProvider: tmpl.llmProvider, instruction: tmpl.instruction,
                                 description: tmpl.description,
                                 scheduleExpression: tmpl.scheduleExpression,
                                 scheduleEnabled: tmpl.scheduleEnabled,
                                 schedulePrompt: tmpl.schedulePrompt,
                                 scheduleChatRoomId: cfgOut.adkAgentConfigId,
                                 toolMode: tmpl.toolMode, serviceAllowlist: tmpl.serviceAllowlist,
                                 writePolicy: tmpl.writePolicy, websiteChat: tmpl.websiteChat,
                                 agentRole: tmpl.agentRole, orchestrationType: tmpl.orchestrationType,
                                 loopMaxIterations: tmpl.loopMaxIterations, teamName: tmpl.teamName]"/>
                </if>
            </iterate>

            <!-- 2. Clone team membership with remapped coordinator/member ids. Only links whose
                 coordinator AND member were both just cloned above are considered, so a teamName
                 filter naturally restricts membership to that team too. -->
            <set field="coordIds" from="[] as Set"/>
            <entity-find entity-name="moqui.adk.AdkAgentTeamMember" list="teamTemplates">
                <econdition field-name="ownerPartyId" value="_NA_"/>
                <order-by field-name="sequenceNum"/>
            </entity-find>
            <iterate list="teamTemplates" entry="tm">
                <set field="newCoord"  from="idMap[tm.coordinatorConfigId]"/>
                <set field="newMember" from="idMap[tm.memberConfigId]"/>
                <if condition="newCoord &amp;&amp; newMember">
                    <entity-find entity-name="moqui.adk.AdkAgentTeamMember" list="existing">
                        <econdition field-name="ownerPartyId" from="ownerPartyId"/>
                        <econdition field-name="coordinatorConfigId" from="newCoord"/>
                        <econdition field-name="memberConfigId" from="newMember"/>
                    </entity-find>
                    <if condition="!existing">
                        <service-call name="create#moqui.adk.AdkAgentTeamMember"
                            in-map="[ownerPartyId: ownerPartyId, coordinatorConfigId: newCoord,
                                     memberConfigId: newMember, sequenceNum: tm.sequenceNum,
                                     delegationMode: tm.delegationMode ?: 'tool', enabled: 'Y']"/>
                    </if>
                    <script>coordIds.add(newCoord)</script>
                </if>
            </iterate>
            <!-- rebuild each coordinator runtime so it picks up its team members -->
            <iterate list="coordIds" entry="cid">
                <script>org.moqui.adk.AdkManager.reloadConfig(cid as String)</script>
            </iterate>
        </actions>
    </service>

</services>
