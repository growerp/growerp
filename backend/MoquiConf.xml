<?xml version="1.0" encoding="UTF-8"?>
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-2.1.xsd">

    <!-- can be overridden in the docker-compose.yml env setting: paymentGatewayConfigId: 'STRIPE' -->
    <default-property name="paymentGatewayConfigId" value="TEST_APPROVE" /><!-- STRIPE -->
    <default-property name="default_locale" value="UTC" />
    <default-property name="default_time_zone" value="UTC" />
    <default-property name="database_time_zone" value="UTC" />

    <!-- Bitronix defaults to 60s (see bitronix-default-config.properties in moqui-framework), which
         is not enough for the demo data load that runs as one transaction in the
         login#User -> complete#TenantSetup -> setup#SpecificApp -> load#DemoData chain. On expiry the
         transaction is marked rollback-only and the next entity find fails with a misleading
         "Cannot get connection, transaction not in operable status" error. Read by Bitronix as a
         System property, which default-property sets before the transaction facade initialises. -->
    <default-property name="bitronix.tm.timer.defaultTransactionTimeout" value="600" />

    <server-stats bin-length-seconds="900" visit-enabled="false" visit-ip-info-on-login="true"
        visitor-enabled="false">
        <artifact-stats type="AT_XML_SCREEN" persist-bin="false" persist-hit="false" />
        <artifact-stats type="AT_XML_SCREEN_CONTENT" persist-bin="false" persist-hit="false" />
        <artifact-stats type="AT_XML_SCREEN_TRANS" persist-bin="false" persist-hit="false" />
        <!-- AT_SERVICE hits feed the OwnerPersonRestRequest view entity used by the REST usage
             statistics services in GeneralServices100.xml; keep here so it applies in every
             environment (component conf merges before the runtime conf) -->
        <artifact-stats type="AT_SERVICE" persist-bin="true" persist-hit="true" />
        <artifact-stats type="AT_ENTITY" persist-bin="false" />
    </server-stats>

    <webapp-list>
        <!-- require-session-token=false: anonymous public POSTs (assessment submit,
             Register, etc.) cannot obtain the CSRF token when embedded in an iframe whose
             parent page already minted the session token. Authenticated requests (api_key/
             JWT) are exempt regardless, so this only relaxes anonymous non-GET endpoints. -->
        <webapp name="webroot" require-session-token="false">
            <!-- Notification Message Endpoint -->
            <endpoint path="/chat" class="org.moqui.impl.webapp.ChatEndpoint"
                timeout="3600000" enabled="true" />
        </webapp>
    </webapp-list>


    <!-- REST authorization caches. check#RestAccess runs on every REST leaf, so
         neither the path to domain lookup nor the per organization access map can
         be recomputed per request. The owner map is cleared explicitly by every
         menu write (clear#OwnerDomainAccessCache); the idle expiry is only a
         backstop. -->
    <cache-list>
        <cache name="growerp.security.restDomain" max-elements="2000"
            expire-time-idle="3600" eviction-strategy="least-recently-used"/>
        <cache name="growerp.security.restPatterns" max-elements="10"
            expire-time-idle="3600" eviction-strategy="least-recently-used"/>
        <cache name="growerp.security.ownerDomain" max-elements="2000"
            expire-time-idle="3600" eviction-strategy="least-recently-used"/>
    </cache-list>

    <screen-facade>
        <screen location="component://webroot/screen/webroot.xml">
            <subscreens-item name="growerp" menu-include="false" no-sub-path="true"
                location="component://growerp/screen/rest.xml"/>
        </screen>
    </screen-facade>

</moqui-conf>