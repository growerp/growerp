    <service verb="update" noun="SocialPost" authenticate="true">
        <in-parameters>
            <parameter name="postId" required="true" />
            <parameter name="pseudoId" />
            <parameter name="planId" />
            <parameter name="type" />
            <parameter name="platform" />
            <parameter name="headline" />
            <parameter name="draftContent" />
            <parameter name="finalContent" />
            <parameter name="status" />
            <parameter name="scheduledDate" type="Long" />
        </in-parameters>
        <out-parameters>
            <parameter name="postId" />
            <parameter name="pseudoId" />
            <parameter name="planId" />
            <parameter name="type" />
            <parameter name="platform" />
            <parameter name="headline" />
            <parameter name="draftContent" />
            <parameter name="finalContent" />
            <parameter name="status" />
            <parameter name="scheduledDate" type="Timestamp" />
            <parameter name="createdDate" type="Timestamp" />
            <parameter name="lastModifiedDate" type="Timestamp" />
        </out-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />

            <!-- Get existing post to verify ownership -->
            <entity-find-one entity-name="growerp.marketing.SocialPost" value-field="post">
                <field-map field-name="postId" />
            </entity-find-one>
            <if condition="!post">
                <return error="true" message="Social post not found" />
            </if>

            <!-- Verify ownership via content plan if planId exists -->
            <if condition="post.planId">
                <entity-find-one entity-name="growerp.marketing.ContentPlan" value-field="plan">
                    <field-map field-name="planId" from="post.planId" />
                </entity-find-one>
                <if condition="plan &amp;&amp; plan.ownerPartyId != ownerPartyId">
                    <return error="true" message="Access denied to this social post" />
                </if>
            </if>

            <!-- Convert scheduledDate from Long to Timestamp if provided -->
            <set field="scheduledDateTs"
                from="scheduledDate ? new java.sql.Timestamp(scheduledDate) : post.scheduledDate" />

            <service-call name="update#growerp.marketing.SocialPost"
                in-map="[
                    postId: postId,
                    pseudoId: pseudoId ?: post.pseudoId,
                    planId: planId ?: post.planId,
                    type: type ?: post.type,
                    platform: platform ?: post.platform,
                    headline: headline ?: post.headline,
                    draftContent: draftContent ?: post.draftContent,
                    finalContent: finalContent ?: post.finalContent,
                    status: status ?: post.status,
                    scheduledDate: scheduledDateTs,
                    lastModifiedDate: ec.user.nowTimestamp
                ]" />

            <!-- Return updated post -->
            <entity-find-one entity-name="growerp.marketing.SocialPost" value-field="updatedPost">
                <field-map field-name="postId" />
            </entity-find-one>

            <set field="pseudoId" from="updatedPost.pseudoId" />
            <set field="planId" from="updatedPost.planId" />
            <set field="type" from="updatedPost.type" />
            <set field="platform" from="updatedPost.platform" />
            <set field="headline" from="updatedPost.headline" />
            <set field="draftContent" from="updatedPost.draftContent" />
            <set field="finalContent" from="updatedPost.finalContent" />
            <set field="status" from="updatedPost.status" />
            <set field="scheduledDate" from="updatedPost.scheduledDate" />
            <set field="createdDate" from="updatedPost.createdDate" />
            <set field="lastModifiedDate" from="updatedPost.lastModifiedDate" />
        </actions>
    </service>

    <service verb="delete" noun="SocialPost" authenticate="true">
        <in-parameters>
            <parameter name="postId" required="true" />
        </in-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />

            <entity-find-one entity-name="growerp.marketing.SocialPost" value-field="post">
                <field-map field-name="postId" />
            </entity-find-one>
            <if condition="!post">
                <return error="true" message="Social post not found" />
            </if>

            <!-- Verify ownership via content plan if planId exists -->
            <if condition="post.planId">
                <entity-find-one entity-name="growerp.marketing.ContentPlan" value-field="plan">
                    <field-map field-name="planId" from="post.planId" />
                </entity-find-one>
                <if condition="plan &amp;&amp; plan.ownerPartyId != ownerPartyId">
                    <return error="true" message="Access denied to this social post" />
                </if>
            </if>

            <service-call name="delete#growerp.marketing.SocialPost"
                in-map="[postId: postId]" />
        </actions>
    </service>

    <service verb="draft" noun="SocialPost" authenticate="true">
        <description>Draft a full social post using AI.</description>
        <in-parameters>
            <parameter name="postId" required="true" />
        </in-parameters>
        <out-parameters>
            <parameter name="content" />
            <parameter name="hashtags" type="List" />
        </out-parameters>
        <actions>
            <script location="component://growerp/service/draftSocialPostWithAI.groovy" />
        </actions>
    </service>

    <service verb="get" noun="MarketingDashboard">
        <description>Aggregates for the marketing dashboard tile: the social post
            status funnel and the content counters, scoped to the owner company.</description>
        <out-parameters>
            <parameter name="postSummary" type="List" />
            <parameter name="totalPosts" type="Integer" />
            <parameter name="contentToApprove" type="Integer" />
            <parameter name="activePlans" type="Integer" />
            <parameter name="newEngagements" type="Integer" />
        </out-parameters>
        <actions>
            <service-call out-map="context"
                name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner" />

            <!-- social post funnel. A failed publish keeps status READY and only
                 stamps publishError, so failed posts are READY posts with an error
                 and the scheduled count has to exclude them to avoid double counting -->
            <entity-find-count count-field="draftPosts"
                entity-name="growerp.marketing.SocialPost">
                <econdition field-name="ownerPartyId" />
                <econdition field-name="status" value="DRAFT" />
            </entity-find-count>
            <entity-find-count count-field="scheduledPosts"
                entity-name="growerp.marketing.SocialPost">
                <econdition field-name="ownerPartyId" />
                <econdition field-name="status" value="READY" />
                <econdition field-name="scheduledDate" operator="is-not-null" />
                <econdition field-name="publishError" operator="is-null" />
            </entity-find-count>
            <!-- backlog: ready to go out but not scheduled on a date yet -->
            <entity-find-count count-field="backlogPosts"
                entity-name="growerp.marketing.SocialPost">
                <econdition field-name="ownerPartyId" />
                <econdition field-name="status" value="READY" />
                <econdition field-name="scheduledDate" operator="is-null" />
            </entity-find-count>
            <entity-find-count count-field="publishedPosts"
                entity-name="growerp.marketing.SocialPost">
                <econdition field-name="ownerPartyId" />
                <econdition field-name="status" value="PUBLISHED" />
            </entity-find-count>
            <entity-find-count count-field="failedPosts"
                entity-name="growerp.marketing.SocialPost">
                <econdition field-name="ownerPartyId" />
                <econdition field-name="status" value="READY" />
                <econdition field-name="publishError" operator="is-not-null" />
            </entity-find-count>
            <set field="postSummary" from="[
                [status: 'DRAFT', count: draftPosts],
                [status: 'SCHEDULED', count: scheduledPosts],
                [status: 'BACKLOG', count: backlogPosts],
                [status: 'PUBLISHED', count: publishedPosts],
                [status: 'FAILED', count: failedPosts]]" />

            <!-- content counters -->
            <entity-find-count count-field="totalPosts"
                entity-name="growerp.marketing.SocialPost">
                <econdition field-name="ownerPartyId" />
            </entity-find-count>
            <!-- content waiting for approval blocks everything downstream -->
            <entity-find-count count-field="contentToApprove"
                entity-name="growerp.marketing.MasterContent">
                <econdition field-name="ownerPartyId" />
                <econdition field-name="status" value="DRAFT" />
            </entity-find-count>
            <entity-find-count count-field="activePlans"
                entity-name="growerp.marketing.ContentPlan">
                <econdition field-name="ownerPartyId" />
                <econdition field-name="status" value="ACTIVE" />
            </entity-find-count>
            <entity-find-count count-field="newEngagements"
                entity-name="growerp.marketing.SocialEngagement">
                <econdition field-name="ownerPartyId" />
                <econdition field-name="status" value="NEW" />
            </entity-find-count>
        </actions>
    </service>

    <service verb="get" noun="SocialEngagement">
        <description>Engagement signals recorded on the company's social posts</description>
        <in-parameters>
            <parameter name="postId" />
            <parameter name="start" type="Integer" default-value="0" />
            <parameter name="limit" type="Integer" default-value="50" />
        </in-parameters>
        <out-parameters>
            <parameter name="socialEngagements" type="List" />
        </out-parameters>
        <actions>
            <service-call out-map="context"
                name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner" />
            <entity-find entity-name="growerp.marketing.SocialEngagement" list="engagements"
                offset="start" limit="limit">
                <econdition field-name="ownerPartyId" from="ownerPartyId" />
                <econdition field-name="postId" ignore-if-empty="true" />
                <order-by field-name="-createdDate" />
            </entity-find>
            <set field="socialEngagements" from="[]" />
            <iterate list="engagements" entry="engagement">
                <script>socialEngagements.add([engagementId: engagement.engagementId,
                    postId: engagement.postId, platform: engagement.platform,
                    engagementType: engagement.engagementType,
                    userName: engagement.userName,
                    userProfileUrl: engagement.userProfileUrl,
                    note: engagement.note, status: engagement.status,
                    createdDate: engagement.createdDate
                        ? engagement.createdDate.toString() + 'z' : null])</script>
            </iterate>
        </actions>
    </service>

    <service verb="create" noun="SocialEngagement">
        <description>Record an engagement signal (like/comment/share/DM reply) on a post</description>
        <in-parameters>
            <parameter name="socialEngagement" type="Map" required="true">
                <parameter name="postId" />
                <parameter name="platform" />
                <parameter name="engagementType" />
                <parameter name="userName" />
                <parameter name="userProfileUrl" />
                <parameter name="note" />
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="engagementId" />
        </out-parameters>
        <actions>
            <service-call out-map="context"
                name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner" />
            <service-call name="create#growerp.marketing.SocialEngagement" out-map="context"
                in-map="[ownerPartyId: ownerPartyId,
                    postId: socialEngagement.postId,
                    platform: socialEngagement.platform,
                    engagementType: socialEngagement.engagementType ?: 'COMMENT',
                    userName: socialEngagement.userName,
                    userProfileUrl: socialEngagement.userProfileUrl,
                    note: socialEngagement.note,
                    status: 'NEW', createdDate: ec.user.nowTimestamp]" />
        </actions>
    </service>

    <service verb="convert" noun="EngagementToLead">
        <description>Convert an engagement signal into a Lead with a follow-up to-do</description>
        <in-parameters>
            <parameter name="engagementId" required="true" />
            <parameter name="email" required="true" />
        </in-parameters>
        <out-parameters>
            <parameter name="partyId" />
        </out-parameters>
        <actions>
            <service-call out-map="context"
                name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner" />
            <entity-find entity-name="growerp.marketing.SocialEngagement" list="engagements"
                for-update="true" limit="1">
                <econdition field-name="engagementId" from="engagementId" />
                <econdition field-name="ownerPartyId" from="ownerPartyId" />
            </entity-find>
            <if condition="!engagements">
                <return error="true" message="engagement ${engagementId} not found!" />
            </if>
            <set field="engagement" from="engagements[0]" />
            <service-call name="growerp.100.PartyServices100.create#User" out-map="userOut"
                ignore-error="true">
                <field-map field-name="user"
                    from="[
                        firstName: engagement.userName ?: 'social',
                        lastName: engagement.platform ?: 'engagement',
                        email: email,
                        role: 'Lead',
                        userGroupId: 'GROWERP_M_OTHER',
                    ]" />
            </service-call>
            <set field="partyId" from="userOut?.user?.partyId" />
            <service-call name="growerp.100.ActivityServices100.create#Activity"
                ignore-error="true"
                in-map="[activity: [
                    activityType: 'todo',
                    activityName: 'Follow up ' + (engagement.userName ?: 'engagement') +
                        ' (' + (engagement.platform ?: '') + ' ' +
                        (engagement.engagementType ?: '') + ')',
                    statusId: 'progress',
                    description: engagement.note,
                    thirdParty: partyId ? [partyId: partyId] : null]]" />
            <set field="engagement.status" value="CONTACTED" />
            <entity-update value-field="engagement" />
        </actions>
    </service>

</services>