<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========================================================= -->
    <!--  Master Content Services                                  -->
    <!--  Author one platform-neutral piece, then adapt it into    -->
    <!--  per-platform SocialPost / campaign-message children.     -->
    <!--  Designed as agent tools: scoped verb#Noun, idempotent,   -->
    <!--  owner-scoped, REST-registered (growerp.rest.xml).        -->
    <!-- ========================================================= -->

    <service verb="list" noun="MasterContents" authenticate="true">
        <description>List platform-neutral master content pieces for the owner.</description>
        <in-parameters>
            <parameter name="searchString" />
            <parameter name="masterContentId" />
            <parameter name="pseudoId" />
            <parameter name="planId" />
            <parameter name="contentType" />
            <parameter name="status" />
            <parameter name="start" type="Integer" />
            <parameter name="limit" type="Integer" />
        </in-parameters>
        <out-parameters>
            <parameter name="masterContents" type="List" />
        </out-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />

            <!-- normalize null (param omitted) to '' so the LIKE conditions below become
                 the benign '%%' wildcard instead of the literal string '%null%' -->
            <set field="searchString" from="searchString ?: ''" />

            <entity-find entity-name="growerp.marketing.MasterContent" list="masterContents"
                offset="start" limit="limit">
                <econdition field-name="ownerPartyId" />
                <econdition field-name="masterContentId" from="masterContentId" ignore-if-empty="true" />
                <econdition field-name="planId" from="planId" ignore-if-empty="true" />
                <econdition field-name="contentType" from="contentType" ignore-if-empty="true" />
                <econdition field-name="status" from="status" ignore-if-empty="true" />
                <econditions combine="or">
                    <econdition field-name="pseudoId" operator="like" value="%${searchString}%"
                        ignore-if-empty="true" ignore-case="true" />
                    <econdition field-name="title" operator="like" value="%${searchString}%"
                        ignore-if-empty="true" ignore-case="true" />
                    <econdition field-name="pnpType" operator="like" value="%${searchString}%"
                        ignore-if-empty="true" ignore-case="true" />
                </econditions>
                <order-by field-name="-lastModifiedDate" />
            </entity-find>
        </actions>
    </service>

    <service verb="create" noun="MasterContent" authenticate="true">
        <description>Create a platform-neutral master content piece.</description>
        <in-parameters>
            <parameter name="pseudoId" />
            <parameter name="planId" />
            <parameter name="contentType" default-value="POSTING">
                <description>POSTING, ARTICLE or MESSAGE</description>
            </parameter>
            <parameter name="pnpType" default-value="OTHER">
                <description>PAIN, NEWS, PRIZE or OTHER</description>
            </parameter>
            <parameter name="title" />
            <parameter name="body" />
            <parameter name="callToAction" />
            <parameter name="targetUrl" />
            <parameter name="teaserMode" default-value="N">
                <description>Y = adapted posts are teasers linking to targetUrl</description>
            </parameter>
            <parameter name="status" default-value="DRAFT" />
        </in-parameters>
        <out-parameters>
            <parameter name="masterContentId" />
            <parameter name="pseudoId" />
            <parameter name="planId" />
            <parameter name="contentType" />
            <parameter name="pnpType" />
            <parameter name="title" />
            <parameter name="body" />
            <parameter name="callToAction" />
            <parameter name="targetUrl" />
            <parameter name="teaserMode" />
            <parameter name="articlePath" />
            <parameter name="status" />
            <parameter name="approvedDate" type="Timestamp" />
            <parameter name="createdDate" type="Timestamp" />
            <parameter name="lastModifiedDate" type="Timestamp" />
        </out-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />
            <if condition="!ownerPartyId">
                <return error="true" message="User not authenticated or no party associated" />
            </if>
            <if condition="teaserMode == 'Y' &amp;&amp; !targetUrl">
                <return error="true" message="Teaser mode needs a target URL: the link to the full article" />
            </if>

            <if condition="!pseudoId">
                <service-call name="growerp.100.GeneralServices100.getNext#PseudoId"
                    in-map="[ownerPartyId: ownerPartyId, seqName: 'MasterContent']"
                    out-map="context" />
                <set field="pseudoId" from="seqNum" />
            </if>

            <service-call name="create#growerp.marketing.MasterContent" out-map="context"
                in-map="[
                    ownerPartyId: ownerPartyId,
                    pseudoId: pseudoId,
                    planId: planId,
                    contentType: contentType,
                    pnpType: pnpType,
                    title: title,
                    body: body,
                    callToAction: callToAction,
                    targetUrl: targetUrl,
                    teaserMode: teaserMode == 'Y' ? 'Y' : 'N',
                    status: status,
                    createdDate: ec.user.nowTimestamp,
                    lastModifiedDate: ec.user.nowTimestamp
                ]" />

            <entity-find-one entity-name="growerp.marketing.MasterContent" value-field="mc">
                <field-map field-name="masterContentId" />
            </entity-find-one>
            <set field="planId" from="mc.planId" />
            <set field="contentType" from="mc.contentType" />
            <set field="pnpType" from="mc.pnpType" />
            <set field="title" from="mc.title" />
            <set field="body" from="mc.body" />
            <set field="callToAction" from="mc.callToAction" />
            <set field="targetUrl" from="mc.targetUrl" />
            <set field="teaserMode" from="mc.teaserMode" />
            <set field="articlePath" from="mc.articlePath" />
            <set field="status" from="mc.status" />
            <set field="approvedDate" from="mc.approvedDate" />
            <set field="createdDate" from="mc.createdDate" />
            <set field="lastModifiedDate" from="mc.lastModifiedDate" />
        </actions>
    </service>

    <service verb="update" noun="MasterContent" authenticate="true">
        <in-parameters>
            <parameter name="masterContentId" required="true" />
            <parameter name="pseudoId" />
            <parameter name="planId" />
            <parameter name="contentType" />
            <parameter name="pnpType" />
            <parameter name="title" />
            <parameter name="body" />
            <parameter name="callToAction" />
            <parameter name="targetUrl" />
            <parameter name="teaserMode" />
            <parameter name="status" />
        </in-parameters>
        <out-parameters>
            <parameter name="masterContentId" />
            <parameter name="pseudoId" />
            <parameter name="planId" />
            <parameter name="contentType" />
            <parameter name="pnpType" />
            <parameter name="title" />
            <parameter name="body" />
            <parameter name="callToAction" />
            <parameter name="targetUrl" />
            <parameter name="teaserMode" />
            <parameter name="articlePath" />
            <parameter name="status" />
            <parameter name="approvedDate" type="Timestamp" />
            <parameter name="createdDate" type="Timestamp" />
            <parameter name="lastModifiedDate" type="Timestamp" />
        </out-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />

            <entity-find-one entity-name="growerp.marketing.MasterContent" value-field="mc">
                <field-map field-name="masterContentId" />
            </entity-find-one>
            <if condition="!mc">
                <return error="true" message="Master content not found" />
            </if>
            <if condition="mc.ownerPartyId != ownerPartyId">
                <return error="true" message="Access denied to this master content" />
            </if>
            <if condition="(teaserMode ?: mc.teaserMode) == 'Y' &amp;&amp; !(targetUrl ?: mc.targetUrl)">
                <return error="true" message="Teaser mode needs a target URL: the link to the full article" />
            </if>

            <service-call name="update#growerp.marketing.MasterContent"
                in-map="[
                    masterContentId: masterContentId,
                    pseudoId: pseudoId ?: mc.pseudoId,
                    planId: planId ?: mc.planId,
                    contentType: contentType ?: mc.contentType,
                    pnpType: pnpType ?: mc.pnpType,
                    title: title ?: mc.title,
                    body: body ?: mc.body,
                    callToAction: callToAction ?: mc.callToAction,
                    targetUrl: targetUrl ?: mc.targetUrl,
                    teaserMode: teaserMode ?: mc.teaserMode,
                    status: status ?: mc.status,
                    lastModifiedDate: ec.user.nowTimestamp
                ]" />

            <entity-find-one entity-name="growerp.marketing.MasterContent" value-field="updated">
                <field-map field-name="masterContentId" />
            </entity-find-one>
            <set field="pseudoId" from="updated.pseudoId" />
            <set field="planId" from="updated.planId" />
            <set field="contentType" from="updated.contentType" />
            <set field="pnpType" from="updated.pnpType" />
            <set field="title" from="updated.title" />
            <set field="body" from="updated.body" />
            <set field="callToAction" from="updated.callToAction" />
            <set field="targetUrl" from="updated.targetUrl" />
            <set field="teaserMode" from="updated.teaserMode" />
            <set field="articlePath" from="updated.articlePath" />
            <set field="status" from="updated.status" />
            <set field="approvedDate" from="updated.approvedDate" />
            <set field="createdDate" from="updated.createdDate" />
            <set field="lastModifiedDate" from="updated.lastModifiedDate" />
        </actions>
    </service>

    <service verb="approve" noun="MasterContent" authenticate="true">
        <description>Human approval gate for auto-publishing. Setting approvedDate lets the
            publish#ScheduledSocialPosts scheduler auto-publish every SocialPost adapted from
            this master piece. approve=N clears approvedDate (revokes future auto-publishes;
            already-PUBLISHED posts are unaffected).</description>
        <in-parameters>
            <parameter name="masterContentId" required="true" />
            <parameter name="approve" default-value="Y" />
        </in-parameters>
        <out-parameters>
            <parameter name="masterContentId" />
            <parameter name="pseudoId" />
            <parameter name="planId" />
            <parameter name="contentType" />
            <parameter name="pnpType" />
            <parameter name="title" />
            <parameter name="body" />
            <parameter name="callToAction" />
            <parameter name="targetUrl" />
            <parameter name="teaserMode" />
            <parameter name="articlePath" />
            <parameter name="status" />
            <parameter name="approvedDate" type="Timestamp" />
            <parameter name="createdDate" type="Timestamp" />
            <parameter name="lastModifiedDate" type="Timestamp" />
        </out-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />

            <entity-find-one entity-name="growerp.marketing.MasterContent" value-field="mc">
                <field-map field-name="masterContentId" />
            </entity-find-one>
            <if condition="!mc">
                <return error="true" message="Master content not found" />
            </if>
            <if condition="mc.ownerPartyId != ownerPartyId">
                <return error="true" message="Access denied to this master content" />
            </if>

            <service-call name="update#growerp.marketing.MasterContent"
                in-map="[
                    masterContentId: masterContentId,
                    approvedDate: approve == 'Y' ? ec.user.nowTimestamp : null,
                    lastModifiedDate: ec.user.nowTimestamp
                ]" />
            <!-- an article written from an idea goes onto the website only now: nothing a
                 human has not approved becomes public. Revoking keeps the page (the teasers
                 that already went out still link to it). -->
            <if condition="approve == 'Y' &amp;&amp; mc.articlePath">
                <service-call name="growerp.100.MasterContentServices100.publish#ArticlePage"
                    in-map="[masterContentId: masterContentId]" />
            </if>

            <entity-find-one entity-name="growerp.marketing.MasterContent" value-field="updated">
                <field-map field-name="masterContentId" />
            </entity-find-one>
            <set field="pseudoId" from="updated.pseudoId" />
            <set field="planId" from="updated.planId" />
            <set field="contentType" from="updated.contentType" />
            <set field="pnpType" from="updated.pnpType" />
            <set field="title" from="updated.title" />
            <set field="body" from="updated.body" />
            <set field="callToAction" from="updated.callToAction" />
            <set field="targetUrl" from="updated.targetUrl" />
            <set field="teaserMode" from="updated.teaserMode" />
            <set field="articlePath" from="updated.articlePath" />
            <set field="status" from="updated.status" />
            <set field="approvedDate" from="updated.approvedDate" />
            <set field="createdDate" from="updated.createdDate" />
            <set field="lastModifiedDate" from="updated.lastModifiedDate" />
        </actions>
    </service>

    <service verb="delete" noun="MasterContent" authenticate="true">
        <in-parameters>
            <parameter name="masterContentId" required="true" />
        </in-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />
            <entity-find-one entity-name="growerp.marketing.MasterContent" value-field="mc">
                <field-map field-name="masterContentId" />
            </entity-find-one>
            <if condition="!mc">
                <return error="true" message="Master content not found" />
            </if>
            <if condition="mc.ownerPartyId != ownerPartyId">
                <return error="true" message="Access denied to this master content" />
            </if>
            <service-call name="delete#growerp.marketing.MasterContent"
                in-map="[masterContentId: masterContentId]" />
        </actions>
    </service>

    <service verb="generate" noun="MasterContent" authenticate="true">
        <description>AI-write one platform-neutral master content piece for a persona and PNP angle.</description>
        <in-parameters>
            <parameter name="personaId" />
            <parameter name="planId" />
            <parameter name="contentType" default-value="POSTING">
                <description>POSTING, ARTICLE or MESSAGE</description>
            </parameter>
            <parameter name="pnpType" default-value="OTHER">
                <description>PAIN, NEWS, PRIZE or OTHER</description>
            </parameter>
            <parameter name="title" />
            <parameter name="brief" />
            <parameter name="targetUrl" />
        </in-parameters>
        <out-parameters>
            <parameter name="masterContentId" />
            <parameter name="pseudoId" />
            <parameter name="title" />
            <parameter name="body" />
            <parameter name="callToAction" />
        </out-parameters>
        <actions>
            <script location="component://growerp/service/generateMasterContentWithAI.groovy" />
        </actions>
    </service>

    <!-- ========================================================= -->
    <!--  adapt#ContentForPlatform: the "author once → fan out"    -->
    <!--  core. For each platform, AI-adapts the master body and:  -->
    <!--    POSTING / ARTICLE  -> creates a READY SocialPost        -->
    <!--    MESSAGE (+campaign) -> merges adapted text into the     -->
    <!--                            campaign platformSettings        -->
    <!--  Idempotent: skips a platform that already has a SocialPost -->
    <!--  for this master piece.                                    -->
    <!-- ========================================================= -->
    <!-- AI adaptation of one piece for one platform. Isolated as its own
         service so the GeminiAiUtil class resolves at script scope (the same
         proven pattern as generate#PlatformMessage) — it does not resolve
         inside a closure in the loop below. -->
    <service verb="adapt" noun="PlatformContent" authenticate="true">
        <in-parameters>
            <parameter name="title" />
            <parameter name="body" required="true" />
            <parameter name="platform" required="true" />
            <parameter name="contentType" required="true" />
            <parameter name="callToAction" />
            <parameter name="targetUrl" />
            <parameter name="teaser" type="Boolean" default="false">
                <description>true = write a short teaser that links to targetUrl for the full text</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="adaptedContent" />
            <parameter name="aiError"><description>why the AI call failed, when it did</description></parameter>
        </out-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner" out-map="relInfo" />
            <script>
                def GeminiAiUtil = ec.resource.script("component://growerp/service/GeminiAiUtil.groovy", null)
                // a failed AI call is returned, not raised: raising marks the caller's
                // transaction rollback-only and hides the reason (e.g. allowance used up)
                try {
                    adaptedContent = GeminiAiUtil.generateAdaptedContent(ec, title, body,
                        platform, contentType, callToAction, targetUrl, relInfo.ownerPartyId, teaser)
                } catch (Exception e) {
                    ec.logger.warn("adapt#PlatformContent ${platform} failed: ${e.message}")
                    adaptedContent = null
                    aiError = e.message
                }
            </script>
        </actions>
    </service>

    <service verb="adapt" noun="ContentForPlatform" authenticate="true">
        <description>Adapt one MasterContent piece to per-platform children. Default platforms =
            all enabled PlatformConfiguration for the owner. Creates READY SocialPost items for
            POSTING/ARTICLE; for MESSAGE merges the adapted template into the given campaign's
            platformSettings. Skips platforms already adapted (idempotent).</description>
        <in-parameters>
            <parameter name="masterContentId" required="true" />
            <parameter name="platforms" type="List">
                <description>Subset of EMAIL,LINKEDIN,TWITTER,MEDIUM,SUBSTACK,FACEBOOK; default = all enabled</description>
            </parameter>
            <parameter name="campaignId">
                <description>For MESSAGE content: the campaign whose platformSettings to update</description>
            </parameter>
            <parameter name="scheduledDate" type="Long">
                <description>Schedule for the created SocialPosts (epoch ms). When left empty
                    the next free day is picked, so pieces spread over the coming days instead
                    of all publishing on the next scheduler tick.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="adaptedCount" type="Integer" />
            <parameter name="skippedCount" type="Integer" />
            <parameter name="socialPostIds" type="List" />
        </out-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />
            <if condition="!ownerPartyId">
                <return error="true" message="User not authenticated or no party associated" />
            </if>

            <entity-find-one entity-name="growerp.marketing.MasterContent" value-field="mc">
                <field-map field-name="masterContentId" />
            </entity-find-one>
            <if condition="!mc">
                <return error="true" message="Master content not found: ${masterContentId}" />
            </if>
            <if condition="mc.ownerPartyId != ownerPartyId">
                <return error="true" message="Access denied to this master content" />
            </if>
            <if condition="!mc.body">
                <return error="true" message="Master content has no body to adapt" />
            </if>
            <if condition="mc.teaserMode == 'Y' &amp;&amp; !mc.targetUrl">
                <return error="true" message="Teaser mode needs a target URL: the link to the full article" />
            </if>

            <!-- Default platform list = enabled PlatformConfiguration for this owner -->
            <if condition="!platforms">
                <entity-find entity-name="growerp.marketing.PlatformConfiguration" list="configs">
                    <econdition field-name="ownerPartyId" />
                    <econdition field-name="isEnabled" value="Y" />
                </entity-find>
                <set field="platforms" from="configs.collect { it.platform }" />
                <!-- SUBSTACK_NOTE has no configuration row of its own: it shares the
                     SUBSTACK credentials, so it can never appear in the list above. -->
                <if condition="platforms.contains('SUBSTACK') &amp;&amp; !platforms.contains('SUBSTACK_NOTE')">
                    <set field="platforms" from="platforms + ['SUBSTACK_NOTE']" />
                </if>
            </if>
            <if condition="!platforms">
                <return error="true"
                    message="No platforms given and no enabled PlatformConfiguration found for owner" />
            </if>

            <!-- No schedule given: hand this piece the next day the owner has nothing
                 scheduled on yet, starting tomorrow. Without it every variant is created
                 with an empty scheduledDate, which publish#ScheduledSocialPosts reads as
                 "publish now" - so a week of content goes out on one tick and never
                 appears on the content calendar. All platform variants of one piece share
                 the slot: cross-posting the same piece at once is wanted, it is separate
                 pieces landing together that is not. -->
            <if condition="!scheduledDate">
                <!-- 10:00 UTC: the hour the weekly content agent's prompt already uses, so
                     hand-adapted and agent-adapted pieces land at the same time of day -->
                <set field="slotHourUtc" value="10" type="Integer" />
                <set field="slotDay"
                    from="java.time.LocalDate.now(java.time.ZoneOffset.UTC).plusDays(1)" />
                <set field="slotFound" from="false" type="Boolean" />
                <!-- bounded walk: a full year of taken days means something is wrong and
                     the piece is better off on a taken day than in an endless loop -->
                <set field="daysTried" from="0" type="Integer" />
                <while condition="!slotFound &amp;&amp; daysTried &lt; 365">
                    <set field="dayStartTs"
                        from="new java.sql.Timestamp(slotDay.atStartOfDay(java.time.ZoneOffset.UTC)
                              .toInstant().toEpochMilli())" />
                    <set field="dayEndTs"
                        from="new java.sql.Timestamp(slotDay.plusDays(1)
                              .atStartOfDay(java.time.ZoneOffset.UTC).toInstant().toEpochMilli())" />
                    <entity-find-count entity-name="growerp.marketing.SocialPost"
                        count-field="takenCount">
                        <econdition field-name="ownerPartyId" />
                        <econdition field-name="scheduledDate" operator="greater-equals"
                            from="dayStartTs" />
                        <econdition field-name="scheduledDate" operator="less" from="dayEndTs" />
                    </entity-find-count>
                    <if condition="takenCount == 0">
                        <set field="slotFound" from="true" type="Boolean" />
                        <else>
                            <set field="slotDay" from="slotDay.plusDays(1)" />
                            <set field="daysTried" from="daysTried + 1" type="Integer" />
                        </else>
                    </if>
                </while>
                <set field="scheduledDate"
                    from="slotDay.atTime(slotHourUtc, 0).toInstant(java.time.ZoneOffset.UTC)
                          .toEpochMilli()" type="Long" />
            </if>

            <!-- Preflight: an AI key must be found the way the AI call finds it (the tenant's
                 own key in System Setup, else the system default provider's key) -->
            <script>aiKeyFound = ec.resource.script("component://growerp/service/GeminiAiUtil.groovy", null)
                .hasApiKey(ec, ownerPartyId)</script>
            <if condition="!aiKeyFound">
                <return error="true"
                    message="AI key not configured: add one in System Setup -> AI Settings before adapting content." />
            </if>

            <set field="adaptedCount" from="0" type="Integer" />
            <set field="skippedCount" from="0" type="Integer" />
            <set field="socialPostIds" from="[]" />

            <iterate list="platforms" entry="platformRaw">
                <set field="platform" from="platformRaw.toString().toUpperCase()" />

                <!-- Broadcast posts get the link tagged per platform, so reads on the
                     website (ContentRead) are counted per master piece and platform.
                     1:1 messages keep the plain link. -->
                <set field="platformUrl" from="mc.targetUrl" />
                <if condition="mc.targetUrl &amp;&amp; mc.contentType != 'MESSAGE'">
                    <set field="platformUrl" from="mc.targetUrl + (mc.targetUrl.contains('?') ? '&amp;' : '?') +
                        'utm_source=' + platform.toLowerCase() +
                        '&amp;utm_medium=' + (platform in ['EMAIL', 'SUBSTACK'] ? 'email' : 'social') +
                        '&amp;utm_campaign=' + java.net.URLEncoder.encode(mc.pseudoId ?: mc.masterContentId, 'UTF-8')" />
                </if>
                <!-- AI-adapt the body for this platform; ignore-error so one
                     platform failing does not abort the rest of the loop -->
                <set field="adaptedContent" from="null" />
                <set field="aiError" from="null" />
                <service-call out-map="context" ignore-error="true"
                    name="growerp.100.MasterContentServices100.adapt#PlatformContent"
                    in-map="[title: mc.title, body: mc.body, platform: platform,
                             contentType: mc.contentType, callToAction: mc.callToAction,
                             targetUrl: platformUrl,
                             teaser: mc.teaserMode == 'Y' &amp;&amp; mc.contentType != 'MESSAGE']" />
                <if condition="!adaptedContent">
                    <set field="lastAiError" from="aiError ?: lastAiError" />
                    <continue />
                </if>

                <if condition="mc.contentType == 'MESSAGE' &amp;&amp; campaignId">
                    <!-- 1:1 message: merge the adapted template into the campaign settings -->
                    <service-call
                        name="growerp.100.MasterContentServices100.merge#CampaignPlatformMessage"
                        in-map="[campaignId: campaignId, platform: platform,
                                 messageTemplate: adaptedContent]" />
                    <set field="adaptedCount" from="adaptedCount + 1" type="Integer" />
                <else>
                    <!-- POSTING / ARTICLE: idempotent create of a READY SocialPost -->
                    <entity-find-one entity-name="growerp.marketing.SocialPost"
                        value-field="existingPost">
                        <field-map field-name="masterContentId" />
                        <field-map field-name="platform" />
                        <field-map field-name="ownerPartyId" />
                    </entity-find-one>
                    <if condition="existingPost">
                        <set field="skippedCount" from="skippedCount + 1" type="Integer" />
                    <else>
                        <service-call out-map="createResult"
                            name="growerp.100.MarketingServices100.create#SocialPost"
                            in-map="[planId: mc.planId, type: mc.pnpType ?: 'OTHER',
                                     platform: platform, headline: mc.title,
                                     draftContent: mc.callToAction, finalContent: adaptedContent,
                                     status: 'READY', scheduledDate: scheduledDate]" />
                        <!-- stamp the source master piece onto the post -->
                        <service-call name="update#growerp.marketing.SocialPost"
                            in-map="[postId: createResult.postId,
                                     masterContentId: masterContentId]" />
                        <set field="socialPostIds" from="socialPostIds + [createResult.postId]" />
                        <set field="adaptedCount" from="adaptedCount + 1" type="Integer" />
                    </else>
                    </if>
                </else>
                </if>
            </iterate>

            <!-- Nothing created and nothing skipped => every AI adaptation failed -->
            <if condition="adaptedCount == 0 &amp;&amp; skippedCount == 0">
                <return error="true"
                    message="No content was adapted, the AI call failed for every platform: ${lastAiError ?: 'see the server log'}" />
            </if>

            <!-- Mark the master piece adapted if anything succeeded -->
            <if condition="adaptedCount > 0">
                <service-call name="update#growerp.marketing.MasterContent"
                    in-map="[masterContentId: masterContentId, status: 'ADAPTED',
                             lastModifiedDate: ec.user.nowTimestamp]" />
            </if>
        </actions>
    </service>

    <!-- ========================================================= -->
    <!--  Content ideas: raw text and/or an article URL handed in   -->
    <!--  by a person, turned into a ~500 word website article      -->
    <!-- ========================================================= -->
    <service verb="list" noun="ContentIdeas" authenticate="true">
        <description>List the owner's content ideas in their order (sequenceNum): the next one to use is on top.</description>
        <in-parameters>
            <parameter name="searchString" />
            <parameter name="start" type="Integer" />
            <parameter name="limit" type="Integer" />
        </in-parameters>
        <out-parameters>
            <parameter name="contentIdeas" type="List" />
        </out-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />
            <set field="searchString" from="searchString ?: ''" />
            <entity-find entity-name="growerp.marketing.ContentIdea" list="contentIdeas"
                offset="start" limit="limit">
                <econdition field-name="ownerPartyId" />
                <econditions combine="or">
                    <econdition field-name="pseudoId" operator="like" value="%${searchString}%"
                        ignore-if-empty="true" ignore-case="true" />
                    <econdition field-name="title" operator="like" value="%${searchString}%"
                        ignore-if-empty="true" ignore-case="true" />
                    <econdition field-name="sourceUrl" operator="like" value="%${searchString}%"
                        ignore-if-empty="true" ignore-case="true" />
                </econditions>
                <order-by field-name="sequenceNum" />
                <order-by field-name="createdDate" />
            </entity-find>
        </actions>
    </service>

    <service verb="create" noun="ContentIdea" authenticate="true">
        <description>Hand in raw material for an article: pasted text or notes, the URL of an
            article, or both (both are used).</description>
        <in-parameters>
            <parameter name="title" />
            <parameter name="rawText" allow-html="any" />
            <parameter name="sourceUrl" />
        </in-parameters>
        <out-parameters>
            <parameter name="contentIdea" type="Map" />
        </out-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />
            <if condition="!ownerPartyId">
                <return error="true" message="User not authenticated or no party associated" />
            </if>
            <if condition="!rawText?.trim() &amp;&amp; !sourceUrl?.trim() &amp;&amp; !title?.trim()">
                <return error="true" message="Give an idea, some text, an article URL, or both" />
            </if>
            <if condition="sourceUrl &amp;&amp; !(sourceUrl ==~ /(?i)https?:\/\/.+/)">
                <return error="true" message="The article URL must start with http:// or https://" />
            </if>
            <service-call name="growerp.100.GeneralServices100.getNext#PseudoId"
                in-map="[ownerPartyId: ownerPartyId, seqName: 'ContentIdea']" out-map="seqOut" />
            <!-- a new idea goes to the end of the list -->
            <entity-find entity-name="growerp.marketing.ContentIdea" list="lastIdeas" limit="1">
                <econdition field-name="ownerPartyId" />
                <order-by field-name="-sequenceNum" />
            </entity-find>
            <service-call name="create#growerp.marketing.ContentIdea" out-map="created"
                in-map="[ownerPartyId: ownerPartyId, pseudoId: seqOut.seqNum, title: title,
                    sequenceNum: (lastIdeas ? (lastIdeas[0].sequenceNum ?: 0) : 0) + 1,
                    rawText: rawText, sourceUrl: sourceUrl?.trim(),
                    createdDate: ec.user.nowTimestamp]" />
            <entity-find-one entity-name="growerp.marketing.ContentIdea" value-field="contentIdea">
                <field-map field-name="ideaId" from="created.ideaId" />
            </entity-find-one>
        </actions>
    </service>

    <service verb="update" noun="ContentIdea" authenticate="true">
        <in-parameters>
            <parameter name="ideaId" required="true" />
            <parameter name="title" />
            <parameter name="rawText" allow-html="any" />
            <parameter name="sourceUrl" />
        </in-parameters>
        <out-parameters>
            <parameter name="contentIdea" type="Map" />
        </out-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />
            <entity-find-one entity-name="growerp.marketing.ContentIdea" value-field="idea" />
            <if condition="!idea || idea.ownerPartyId != ownerPartyId">
                <return error="true" message="Content idea not found" />
            </if>
            <if condition="sourceUrl &amp;&amp; !(sourceUrl ==~ /(?i)https?:\/\/.+/)">
                <return error="true" message="The article URL must start with http:// or https://" />
            </if>
            <service-call name="update#growerp.marketing.ContentIdea"
                in-map="[ideaId: ideaId, title: title ?: idea.title,
                    rawText: rawText != null ? rawText : idea.rawText,
                    sourceUrl: sourceUrl != null ? sourceUrl.trim() : idea.sourceUrl]" />
            <entity-find-one entity-name="growerp.marketing.ContentIdea" value-field="contentIdea" />
        </actions>
    </service>

    <service verb="reorder" noun="ContentIdeas" authenticate="true">
        <description>Put the owner's ideas in the given order (first = next to use). Ideas left
            out keep their place after the given ones.</description>
        <in-parameters>
            <parameter name="ideaIds" type="List" required="true" />
        </in-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />
            <set field="seq" from="0" type="Integer" />
            <iterate list="ideaIds" entry="orderedId">
                <entity-find-one entity-name="growerp.marketing.ContentIdea" value-field="idea"
                    for-update="true">
                    <field-map field-name="ideaId" from="orderedId" />
                </entity-find-one>
                <if condition="idea &amp;&amp; idea.ownerPartyId == ownerPartyId">
                    <set field="seq" from="seq + 1" type="Integer" />
                    <set field="idea.sequenceNum" from="seq" type="Integer" />
                    <entity-update value-field="idea" />
                </if>
            </iterate>
        </actions>
    </service>

    <service verb="delete" noun="ContentIdea" authenticate="true">
        <in-parameters>
            <parameter name="ideaId" required="true" />
        </in-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />
            <entity-find-one entity-name="growerp.marketing.ContentIdea" value-field="idea" />
            <if condition="!idea || idea.ownerPartyId != ownerPartyId">
                <return error="true" message="Content idea not found" />
            </if>
            <entity-delete value-field="idea" />
        </actions>
    </service>

    <service verb="write" noun="ArticleFromIdea" authenticate="true" transaction-timeout="300">
        <description>Turn one content idea into a ~500 word article in the house voice and delete
            the idea: the pasted text and the fetched article URL are both used as material. Creates a DRAFT
            MasterContent (contentType ARTICLE, teaser mode on) whose targetUrl is the website page
            the article goes to; the page itself is written when the piece is approved
            (approve#MasterContent), so nothing becomes public without a human. Adapting it per
            platform afterwards gives teasers that link to the article.</description>
        <in-parameters>
            <parameter name="ideaId" required="true" />
            <parameter name="pnpType" default-value="OTHER">
                <description>PAIN, NEWS, PRIZE or OTHER</description>
            </parameter>
            <parameter name="planId" />
            <parameter name="personaId"><description>default: the owner's first persona</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="masterContentId" />
            <parameter name="pseudoId" />
            <parameter name="title" />
            <parameter name="targetUrl" />
        </out-parameters>
        <actions>
            <script location="component://growerp/service/writeArticleFromIdeaWithAI.groovy" />
        </actions>
    </service>

    <service verb="publish" noun="ArticlePage" authenticate="true">
        <description>Write an approved article (MasterContent with articlePath) as a page of the
            owner's website and refresh the 'articles' index page that lists all of them. Article
            pages live under the hidden '_articles/' folder, so they do not each become a menu
            item; the index page is the one menu entry.</description>
        <in-parameters>
            <parameter name="masterContentId" required="true" />
        </in-parameters>
        <actions>
            <service-call name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"
                out-map="context" />
            <entity-find-one entity-name="growerp.marketing.MasterContent" value-field="mc" />
            <if condition="!mc || mc.ownerPartyId != ownerPartyId || !mc.articlePath">
                <return error="true" message="No article to publish for ${masterContentId}" />
            </if>
            <entity-find entity-name="mantle.product.store.ProductStore" list="stores">
                <econdition field-name="organizationPartyId" from="companyPartyId" />
            </entity-find>
            <if condition="!stores">
                <return error="true" message="The company has no website to publish the article on" />
            </if>
            <!-- page and index text are built in Groovy (string work); the pages are plain
                 markdown, a ${...} in the text is shown as is -->
            <entity-find entity-name="growerp.marketing.MasterContent" list="articles">
                <econdition field-name="ownerPartyId" />
                <econdition field-name="articlePath" operator="is-not-null" />
                <econdition field-name="approvedDate" operator="is-not-null" />
                <order-by field-name="-approvedDate" />
            </entity-find>
            <script><![CDATA[
                def summary = { String body ->
                    String plain = (body ?: '').replaceAll(/[#*_`>\[\]]/, '').readLines()
                        .collect { it.trim() }.find { it.length() > 40 } ?: ''
                    if (plain.length() > 155) {
                        int cut = plain.substring(0, 155).lastIndexOf(' ')
                        plain = plain.substring(0, cut > 0 ? cut : 155) + '...'
                    }
                    return plain.replace('-->', '')
                }
                pageText = "<!-- description: ${summary(mc.body)} -->\n# ${mc.title}\n\n" +
                    "${mc.body}\n\n" + (mc.callToAction ? "**${mc.callToAction}**\n" : '')
                StringBuilder idx = new StringBuilder("<!-- description: All articles -->\n# Articles\n\n")
                for (a in articles) {
                    String date = a.approvedDate.toLocalDateTime().toLocalDate().toString()
                    idx.append("### [${a.title}](/content/${a.articlePath})\n${date} - ${summary(a.body)}\n\n")
                }
                indexText = idx.toString()
            ]]></script>
            <service-call name="growerp.100.WebsiteTranslationServices100.store#TranslatedPage"
                in-map="[productStoreId: stores[0].productStoreId, pagePath: mc.articlePath,
                    text: pageText, contentType: 'md', sequenceNum: 900]" />
            <service-call name="growerp.100.WebsiteTranslationServices100.store#TranslatedPage"
                in-map="[productStoreId: stores[0].productStoreId, pagePath: 'articles',
                    text: indexText, contentType: 'md', sequenceNum: 899]" />
            <script>ec.cache.getCache('growerp.seo.index').clear()</script>
        </actions>
    </service>

    <!-- Merge an adapted 1:1 message template into a campaign's platformSettings
         JSON. Groovy is used only for the JSON parse/serialize (Java API). -->
    <service verb="merge" noun="CampaignPlatformMessage" authenticate="true">
        <in-parameters>
            <parameter name="campaignId" required="true" />
            <parameter name="platform" required="true" />
            <parameter name="messageTemplate" required="true" />
        </in-parameters>
        <actions>
            <entity-find-one entity-name="mantle.marketing.campaign.MarketingCampaign"
                value-field="campaign">
                <field-map field-name="marketingCampaignId" from="campaignId" />
            </entity-find-one>
            <if condition="!campaign">
                <return error="true" message="Campaign ${campaignId} not found" />
            </if>
            <script><![CDATA[
                import groovy.json.JsonSlurper
                import groovy.json.JsonOutput
                def settings = [:]
                if (campaign.platformSettings) {
                    try { settings = new JsonSlurper().parseText(campaign.platformSettings as String) }
                    catch (ignored) { settings = [:] }
                }
                def key = platform.toLowerCase()
                def entry = (settings[key] instanceof Map) ? settings[key] : [:]
                entry.messageTemplate = messageTemplate
                settings[key] = entry
                newPlatformSettings = JsonOutput.toJson(settings)
            ]]></script>
            <service-call name="update#mantle.marketing.campaign.MarketingCampaign"
                in-map="[marketingCampaignId: campaignId,
                         platformSettings: newPlatformSettings]" />
        </actions>
    </service>

</services>
