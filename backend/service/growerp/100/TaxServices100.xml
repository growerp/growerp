<!--
    Sales tax. Mantle calls the store's tax gateway whenever an order changes; the
    LOCAL gateway points at calculate#SalesTaxGrowerp. A tenant without rows in
    growerp.tax.TaxRate gets no tax lines, so nothing changes until rates are added.
-->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-2.1.xsd">

    <service verb="get" noun="TaxRates">
        <description>The tax rates of the tenant and whether its store prices include tax.</description>
        <out-parameters>
            <parameter name="taxRates" type="List" />
            <parameter name="pricesIncludeTax" type="Boolean" />
        </out-parameters>
        <actions>
            <service-call out-map="context"
                name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner" />
            <entity-find entity-name="growerp.tax.TaxRate" list="rates">
                <econdition field-name="ownerPartyId" />
                <order-by field-name="taxName" />
            </entity-find>
            <set field="taxRates" from="[]" />
            <iterate list="rates" entry="rate">
                <service-call name="growerp.100.TaxServices100.get#TaxRateOut" out-map="rateOut"
                    in-map="[rate: rate]" />
                <script>taxRates.add(rateOut.taxRate)</script>
            </iterate>
            <entity-find entity-name="mantle.product.store.ProductStore" list="stores" limit="1">
                <econdition field-name="organizationPartyId" from="companyPartyId" />
            </entity-find>
            <set field="pricesIncludeTax" from="stores &amp;&amp; stores[0].pricesIncludeTax == 'Y'" />
        </actions>
    </service>

    <service verb="get" noun="TaxRateOut">
        <description>Internal: a rate the way the frontend reads it.</description>
        <in-parameters>
            <parameter name="rate" type="Map" required="true" />
        </in-parameters>
        <out-parameters>
            <parameter name="taxRate" type="Map" />
        </out-parameters>
        <actions>
            <if condition="rate.productCategoryId">
                <entity-find-one entity-name="mantle.product.category.ProductCategory"
                    value-field="taxCategory">
                    <field-map field-name="productCategoryId" from="rate.productCategoryId" />
                </entity-find-one>
            </if>
            <set field="taxRate"
                from="[taxRateId: rate.taxRateId, taxAuthorityId: rate.taxAuthorityId,
                    taxName: rate.taxName, taxPercentage: rate.taxPercentage,
                    productCategoryId: rate.productCategoryId,
                    categoryName: taxCategory?.categoryName,
                    taxShipping: rate.taxShipping == 'Y',
                    fromDate: rate.fromDate, thruDate: rate.thruDate]" />
        </actions>
    </service>

    <service verb="create" noun="TaxRate">
        <in-parameters>
            <parameter name="taxRate" type="Map" required="true">
                <parameter name="taxName" />
                <parameter name="taxPercentage" type="BigDecimal" required="true" />
                <parameter name="productCategoryId" />
                <parameter name="taxShipping" type="Boolean" />
                <parameter name="fromDate" type="Timestamp" />
                <parameter name="thruDate" type="Timestamp" />
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="taxRate" type="Map" />
        </out-parameters>
        <actions>
            <service-call out-map="context"
                name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner" />
            <!-- a tax authority per tenant: what mantle's tax lines and exemptions point at -->
            <entity-find entity-name="mantle.other.tax.TaxAuthority" list="authorities" limit="1">
                <econdition field-name="taxAuthPartyId" from="ownerPartyId" />
            </entity-find>
            <if condition="authorities">
                <set field="taxAuthorityId" from="authorities[0].taxAuthorityId" />
                <else>
                    <service-call name="create#mantle.other.tax.TaxAuthority" out-map="context"
                        in-map="[taxAuthPartyId: ownerPartyId]" />
                </else>
            </if>
            <service-call name="create#growerp.tax.TaxRate" out-map="created"
                in-map="[ownerPartyId: ownerPartyId, taxAuthorityId: taxAuthorityId,
                    productCategoryId: taxRate.productCategoryId, taxName: taxRate.taxName,
                    taxPercentage: taxRate.taxPercentage,
                    taxShipping: taxRate.taxShipping ? 'Y' : 'N',
                    fromDate: taxRate.fromDate, thruDate: taxRate.thruDate]" />
            <entity-find-one entity-name="growerp.tax.TaxRate" value-field="rate">
                <field-map field-name="taxRateId" from="created.taxRateId" />
            </entity-find-one>
            <service-call name="growerp.100.TaxServices100.get#TaxRateOut" out-map="context"
                in-map="[rate: rate]" />
        </actions>
    </service>

    <service verb="update" noun="TaxRate">
        <in-parameters>
            <parameter name="taxRate" type="Map" required="true">
                <parameter name="taxRateId" required="true" />
                <parameter name="taxName" />
                <parameter name="taxPercentage" type="BigDecimal" />
                <parameter name="productCategoryId" />
                <parameter name="taxShipping" type="Boolean" />
                <parameter name="fromDate" type="Timestamp" />
                <parameter name="thruDate" type="Timestamp" />
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="taxRate" type="Map" />
        </out-parameters>
        <actions>
            <service-call out-map="context"
                name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner" />
            <entity-find-one entity-name="growerp.tax.TaxRate" value-field="rate" for-update="true">
                <field-map field-name="taxRateId" from="taxRate.taxRateId" />
            </entity-find-one>
            <if condition="rate == null || rate.ownerPartyId != ownerPartyId">
                <return error="true" message="Tax rate ${taxRate.taxRateId} not found" />
            </if>
            <if condition="taxRate.taxName != null">
                <set field="rate.taxName" from="taxRate.taxName" />
            </if>
            <if condition="taxRate.taxPercentage != null">
                <set field="rate.taxPercentage" from="taxRate.taxPercentage" />
            </if>
            <if condition="taxRate.containsKey('productCategoryId')">
                <set field="rate.productCategoryId" from="taxRate.productCategoryId ?: null" />
            </if>
            <if condition="taxRate.taxShipping != null">
                <set field="rate.taxShipping" from="taxRate.taxShipping ? 'Y' : 'N'" />
            </if>
            <if condition="taxRate.containsKey('fromDate')">
                <set field="rate.fromDate" from="taxRate.fromDate" />
            </if>
            <if condition="taxRate.containsKey('thruDate')">
                <set field="rate.thruDate" from="taxRate.thruDate" />
            </if>
            <entity-update value-field="rate" />
            <service-call name="growerp.100.TaxServices100.get#TaxRateOut" out-map="context"
                in-map="[rate: rate]" />
        </actions>
    </service>

    <service verb="delete" noun="TaxRate">
        <in-parameters>
            <parameter name="taxRateId" required="true" />
        </in-parameters>
        <actions>
            <service-call out-map="context"
                name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner" />
            <entity-find-one entity-name="growerp.tax.TaxRate" value-field="rate" />
            <if condition="rate == null || rate.ownerPartyId != ownerPartyId">
                <return error="true" message="Tax rate ${taxRateId} not found" />
            </if>
            <entity-delete value-field="rate" />
        </actions>
    </service>

    <service verb="update" noun="TaxSettings">
        <description>Whether the POS prices of the store include tax.</description>
        <in-parameters>
            <parameter name="pricesIncludeTax" type="Boolean" required="true" />
        </in-parameters>
        <actions>
            <service-call out-map="context"
                name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner" />
            <entity-find entity-name="mantle.product.store.ProductStore" list="stores" for-update="true">
                <econdition field-name="organizationPartyId" from="companyPartyId" />
            </entity-find>
            <iterate list="stores" entry="store">
                <set field="store.pricesIncludeTax" from="pricesIncludeTax ? 'Y' : 'N'" />
                <entity-update value-field="store" />
            </iterate>
        </actions>
    </service>

    <service verb="get" noun="ActiveTaxRates">
        <description>Internal: the rates of the owner that apply now.</description>
        <in-parameters>
            <parameter name="ownerPartyId" required="true" />
        </in-parameters>
        <out-parameters>
            <parameter name="rates" type="List" />
        </out-parameters>
        <actions>
            <entity-find entity-name="growerp.tax.TaxRate" list="rates">
                <date-filter />
                <econdition field-name="ownerPartyId" />
            </entity-find>
        </actions>
    </service>

    <service verb="get" noun="ProductTaxRate">
        <description>Internal: which of the given rates applies to a product. A rate of one of
            its categories beats the default rate. Null when no rate applies.</description>
        <in-parameters>
            <parameter name="rates" type="List" required="true" />
            <parameter name="productId" />
        </in-parameters>
        <out-parameters>
            <parameter name="rate" type="Map" />
        </out-parameters>
        <actions>
            <set field="categoryIds" from="[]" />
            <if condition="productId">
                <entity-find entity-name="mantle.product.category.ProductCategoryMember"
                    list="members">
                    <date-filter />
                    <econdition field-name="productId" />
                </entity-find>
                <set field="categoryIds" from="members*.productCategoryId" />
            </if>
            <set field="rate"
                from="rates.find({ it.productCategoryId in categoryIds })
                    ?: rates.find({ !it.productCategoryId })" />
        </actions>
    </service>

    <service verb="calculate" noun="NetUnitAmount">
        <description>The unit amount without tax of a line priced with tax included. Tax is
            taken from the line, not from the unit, so that the line total is exact.</description>
        <in-parameters>
            <parameter name="ownerPartyId" required="true" />
            <parameter name="productId" />
            <parameter name="grossUnitAmount" type="BigDecimal" required="true" />
            <parameter name="quantity" type="BigDecimal" required="true" />
        </in-parameters>
        <out-parameters>
            <parameter name="unitAmount" type="BigDecimal" />
            <parameter name="taxPercentage" type="BigDecimal" />
        </out-parameters>
        <actions>
            <set field="unitAmount" from="grossUnitAmount" />
            <set field="taxPercentage" from="0.0" />
            <service-call name="growerp.100.TaxServices100.get#ActiveTaxRates" out-map="active"
                in-map="[ownerPartyId: ownerPartyId]" />
            <if condition="!active.rates">
                <return />
            </if>
            <set field="product" from="productId ? ec.entity.find('mantle.product.Product').condition('productId', productId).one() : null" />
            <if condition="product?.taxable == 'N'">
                <return />
            </if>
            <service-call name="growerp.100.TaxServices100.get#ProductTaxRate" out-map="applied"
                in-map="[rates: active.rates, productId: productId]" />
            <if condition="applied.rate == null">
                <return />
            </if>
            <set field="taxPercentage" from="applied.rate.taxPercentage" />
            <set field="lineNet"
                from="(grossUnitAmount * quantity * 100.0).divide(100.0 + taxPercentage, 2, BigDecimal.ROUND_HALF_UP)" />
            <set field="unitAmount" from="lineNet.divide(quantity, 5, BigDecimal.ROUND_HALF_UP)" />
        </actions>
    </service>

    <service verb="calculate" noun="SalesTaxGrowerp">
        <description>The tax gateway of the LOCAL config. Tax on top of the amount, except
            for an order of the POS channel in a store with tax in the price: there the
            OrderItem holds the net amount and unitListPrice the shelf price, and tax is the
            difference.</description>
        <implements service="mantle.other.TaxServices.calculate#SalesTax" />
        <actions>
            <set field="taxResults" from="[]" />
            <entity-find-one entity-name="mantle.party.Party" value-field="organization">
                <field-map field-name="partyId" from="organizationPartyId" />
            </entity-find-one>
            <if condition="!organization?.ownerPartyId">
                <return />
            </if>
            <service-call name="growerp.100.TaxServices100.get#ActiveTaxRates" out-map="active"
                in-map="[ownerPartyId: organization.ownerPartyId]" />
            <if condition="!active.rates">
                <return />
            </if>
            <entity-find entity-name="mantle.other.tax.TaxAuthorityParty" list="exemptions" limit="1">
                <date-filter />
                <econdition field-name="partyId" from="customerPartyId" />
                <econdition field-name="taxAuthorityId" from="active.rates[0].taxAuthorityId" />
                <econdition field-name="isExempt" value="Y" />
            </entity-find>
            <if condition="exemptions">
                <return />
            </if>

            <set field="inclusiveOrderId" from="null" />
            <if condition="referenceId?.contains(':')">
                <set field="orderId" from="referenceId.split(':')[0]" />
                <entity-find-one entity-name="mantle.order.OrderHeader" value-field="orderHeader" />
                <if condition="orderHeader?.salesChannelEnumId == 'ScPos'">
                    <entity-find-one entity-name="mantle.product.store.ProductStore" value-field="store">
                        <field-map field-name="productStoreId" from="orderHeader.productStoreId" />
                    </entity-find-one>
                    <if condition="store?.pricesIncludeTax == 'Y'">
                        <set field="inclusiveOrderId" from="orderId" />
                    </if>
                </if>
            </if>

            <iterate list="items" entry="item">
                <if condition="item.itemTypeEnumId in ['ItemDiscount', 'ItemSalesTax', 'ItemVatTax']">
                    <continue />
                </if>
                <service-call name="growerp.100.TaxServices100.get#ProductTaxRate" out-map="applied"
                    in-map="[rates: active.rates, productId: item.productId]" />
                <if condition="applied.rate == null">
                    <continue />
                </if>
                <if condition="item.itemTypeEnumId == 'ItemShipping' &amp;&amp; applied.rate.taxShipping != 'Y'">
                    <continue />
                </if>
                <set field="base" from="(item.itemTotal ?: 0.0) + (item.discountTotal ?: 0.0)" />
                <set field="taxAmount"
                    from="(base * applied.rate.taxPercentage).divide(100.0, 2, BigDecimal.ROUND_HALF_UP)" />
                <if condition="inclusiveOrderId">
                    <entity-find-one entity-name="mantle.order.OrderItem" value-field="orderItem">
                        <field-map field-name="orderId" from="inclusiveOrderId" />
                        <field-map field-name="orderItemSeqId" from="item.itemId" />
                    </entity-find-one>
                    <if condition="orderItem?.unitListPrice != null">
                        <set field="taxAmount"
                            from="(orderItem.unitListPrice * item.quantity).setScale(2, BigDecimal.ROUND_HALF_UP) - base" />
                    </if>
                </if>
                <script>taxResults.add([itemId: item.itemId, taxQuantity: 1.0, taxAmount: taxAmount,
                    taxRate: applied.rate.taxPercentage / 100.0,
                    taxAuthorityId: applied.rate.taxAuthorityId,
                    taxName: applied.rate.taxName])</script>
            </iterate>
        </actions>
    </service>

    <service verb="calculate" noun="InvoiceTax">
        <description>Replace the tax lines of a sales invoice that was not made from an order.
            Does nothing for a purchase invoice or when the tenant has no rates, tax lines
            entered by hand then stay.</description>
        <in-parameters>
            <parameter name="invoiceId" required="true" />
        </in-parameters>
        <actions>
            <service-call out-map="context"
                name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner" />
            <entity-find-one entity-name="mantle.account.invoice.Invoice" value-field="invoice" />
            <if condition="invoice?.fromPartyId != companyPartyId">
                <return />
            </if>
            <service-call name="growerp.100.TaxServices100.get#ActiveTaxRates" out-map="active"
                in-map="[ownerPartyId: ownerPartyId]" />
            <if condition="!active.rates">
                <return />
            </if>
            <entity-delete-by-condition entity-name="mantle.account.invoice.InvoiceItem">
                <econdition field-name="invoiceId" />
                <econdition field-name="itemTypeEnumId" operator="in" value="ItemSalesTax,ItemVatTax" />
            </entity-delete-by-condition>
            <entity-find entity-name="mantle.account.invoice.InvoiceItem" list="invoiceItems">
                <econdition field-name="invoiceId" />
            </entity-find>
            <set field="items" from="[]" />
            <iterate list="invoiceItems" entry="invoiceItem">
                <if condition="invoiceItem.productId">
                    <entity-find-one entity-name="mantle.product.Product" value-field="product">
                        <field-map field-name="productId" from="invoiceItem.productId" />
                    </entity-find-one>
                    <if condition="product?.taxable == 'N'">
                        <continue />
                    </if>
                </if>
                <set field="itemQuantity" from="invoiceItem.quantity != null ? invoiceItem.quantity : 1.0" />
                <script>items.add([itemId: invoiceItem.invoiceItemSeqId,
                    itemTypeEnumId: invoiceItem.itemTypeEnumId, quantity: itemQuantity,
                    unitAmount: invoiceItem.amount, productId: invoiceItem.productId,
                    itemTotal: (itemQuantity * (invoiceItem.amount ?: 0.0)).setScale(2, BigDecimal.ROUND_HALF_UP)])</script>
            </iterate>
            <service-call name="growerp.100.TaxServices100.calculate#SalesTaxGrowerp" out-map="tax"
                in-map="[referenceId: invoiceId, taxGatewayConfigId: 'LOCAL', items: items,
                    customerPartyId: invoice.toPartyId, organizationPartyId: invoice.fromPartyId]" />
            <iterate list="tax.taxResults" entry="taxResult">
                <if condition="!taxResult.taxAmount">
                    <continue />
                </if>
                <service-call name="mantle.account.InvoiceServices.create#InvoiceItem"
                    in-map="[invoiceId: invoiceId, itemTypeEnumId: 'ItemSalesTax',
                        parentItemSeqId: taxResult.itemId, quantity: 1.0,
                        amount: taxResult.taxAmount, description: taxResult.taxName,
                        taxAuthorityId: taxResult.taxAuthorityId]" />
            </iterate>
        </actions>
    </service>

    <service verb="migrate" noun="TaxGateway">
        <description>Point the LOCAL tax gateway at GrowERP and give stores without a gateway
            the LOCAL one. No tax is charged until a tenant adds rates.</description>
        <out-parameters>
            <parameter name="storesUpdated" type="Integer" />
        </out-parameters>
        <actions>
            <entity-find-one entity-name="mantle.other.tax.TaxGatewayConfig" value-field="gateway"
                for-update="true">
                <field-map field-name="taxGatewayConfigId" value="LOCAL" />
            </entity-find-one>
            <set field="gateway.calculateServiceName"
                value="growerp.100.TaxServices100.calculate#SalesTaxGrowerp" />
            <entity-update value-field="gateway" />
            <entity-find entity-name="mantle.product.store.ProductStore" list="stores" for-update="true">
                <econdition field-name="taxGatewayConfigId" operator="is-null" />
            </entity-find>
            <set field="storesUpdated" from="stores.size()" type="Integer" />
            <iterate list="stores" entry="store">
                <set field="store.taxGatewayConfigId" value="LOCAL" />
                <entity-update value-field="store" />
            </iterate>
        </actions>
    </service>
</services>
