<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========================================================= -->
    <!--  MCP Browser Automation Services                          -->
    <!-- ========================================================= -->

    <service verb="test" noun="MCPConnection">
        <description>Test MCP browsermcp connection</description>
        <out-parameters>
            <parameter name="success" type="Boolean"/>
            <parameter name="message"/>
        </out-parameters>
        <actions>
            <script><![CDATA[
                import groovy.json.JsonOutput
                import groovy.json.JsonSlurper
                import java.net.http.HttpClient
                import java.net.http.HttpRequest
                import java.net.http.HttpResponse
                import java.time.Duration
                
                success = false
                message = ""
                
                try {
                    def mcpServerUrl = "http://localhost:3000"
                    def httpClient = HttpClient.newBuilder()
                        .connectTimeout(Duration.ofSeconds(10))
                        .build()
                    
                    // Simple test - navigate to example.com
                    def requestBody = [
                        jsonrpc: "2.0",
                        id: System.currentTimeMillis(),
                        method: "tools/call",
                        params: [
                            name: "mcp_browsermcp_browser_navigate",
                            arguments: [url: "https://example.com"]
                        ]
                    ]
                    
                    def request = HttpRequest.newBuilder()
                        .uri(URI.create("${mcpServerUrl}/mcp"))
                        .header("Content-Type", "application/json")
                        .POST(HttpRequest.BodyPublishers.ofString(JsonOutput.toJson(requestBody)))
                        .timeout(Duration.ofMinutes(1))
                        .build()
                    
                    def response = httpClient.send(request, HttpResponse.BodyHandlers.ofString())
                    
                    if (response.statusCode() == 200) {
                        success = true
                        message = "Successfully connected to browsermcp and navigated to example.com"
                    } else {
                        message = "MCP server returned status ${response.statusCode()}: ${response.body()}"
                    }
                    
                } catch (java.net.ConnectException e) {
                    message = "Failed to connect to browsermcp on localhost:3000. Is browsermcp running?"
                    ec.logger.warn("MCP connection test failed: ${e.message}")
                } catch (Exception e) {
                    message = "Failed to connect to browsermcp: ${e.message}"
                    ec.logger.error("MCP connection test failed", e)
                }
            ]]></script>
        </actions>
    </service>

    <service verb="process" noun="CampaignAutomation">
        <description>
            Drain a campaign's PENDING messages, per platform, up to dailyLimitPerPlatform per day.
            Main entry point called by the scheduler (run#AllCampaignAutomation) or manually.
            Owner-scoped: only processes campaigns belonging to the calling user's company.
        </description>
        <in-parameters>
            <parameter name="marketingCampaignId" required="true"/>
            <parameter name="ownerPartyId">
                <description>Pass explicitly from the headless scheduler; derived from the
                    logged-in user when omitted.</description>
            </parameter>
            <parameter name="maxAttempts" type="Integer" default-value="3">
                <description>Passed to send#OutreachMessage: attempts before a message is FAILED</description>
            </parameter>
            <parameter name="retryDelayMinutes" type="Integer" default-value="30">
                <description>A message attempted less than this many minutes ago is skipped, so a
                    manually triggered run cannot burn all its attempts at once.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="messagesProcessed" type="Integer"/>
            <parameter name="messagesSent" type="Integer"/>
            <parameter name="messagesFailed" type="Integer">
                <description>Attempts that did not send; those with attempts left stay PENDING</description>
            </parameter>
            <parameter name="campaignCompleted" type="Boolean">
                <description>Set when this run left no PENDING message and closed the campaign</description>
            </parameter>
        </out-parameters>
        <actions>
            <if condition="!ownerPartyId">
                <service-call out-map="context"
                    name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"/>
            </if>

            <entity-find-one entity-name="mantle.marketing.campaign.MarketingCampaign"
                value-field="campaign">
                <field-map field-name="marketingCampaignId"/>
                <field-map field-name="ownerPartyId"/>
            </entity-find-one>
            <if condition="!campaign">
                <return error="true" message="Campaign not found: ${marketingCampaignId}"/>
            </if>

            <set field="messagesProcessed" from="0" type="Integer"/>
            <set field="messagesSent" from="0" type="Integer"/>
            <set field="messagesFailed" from="0" type="Integer"/>

            <!-- Skip paused campaigns -->
            <if condition="campaign.isActive != 'Y'">
                <return/>
            </if>

            <!-- Outside this campaign's send window: the job ticks hourly, each campaign
                 decides which of those hours it uses. Hours are UTC, the zone the scheduler
                 runs in; a from greater than a to wraps over midnight. -->
            <if condition="campaign.sendFromHour != null &amp;&amp; campaign.sendToHour != null">
                <!-- explicit UTC: ec.user.nowCalendar would use the logged-in user's zone -->
                <set field="currentHour"
                    from="java.time.ZonedDateTime.now(java.time.ZoneOffset.UTC).getHour()"
                    type="Integer"/>
                <set field="fromHour" from="campaign.sendFromHour as int" type="Integer"/>
                <set field="toHour" from="campaign.sendToHour as int" type="Integer"/>
                <set field="inWindow" from="fromHour &lt;= toHour
                        ? (currentHour &gt;= fromHour &amp;&amp; currentHour &lt;= toHour)
                        : (currentHour &gt;= fromHour || currentHour &lt;= toHour)"/>
                <if condition="!inWindow">
                    <return/>
                </if>
            </if>

            <!-- Parse the JSON platforms array and compute start-of-day for the daily limit -->
            <script><![CDATA[
                import groovy.json.JsonSlurper
                // platforms is usually a JSON array (["LINKEDIN","EMAIL"]) but the UI sometimes
                // stores a bare List string ([LINKEDIN]); tolerate both plus a plain CSV.
                def raw = (campaign.platforms ?: '').toString().trim()
                if (raw.startsWith('[') && raw.contains('"')) {
                    platformList = new JsonSlurper().parseText(raw)
                } else {
                    platformList = raw.replaceAll(/[\[\]"']/, '').split(',')
                        .collect { it.trim().toUpperCase() }.findAll { it }
                }
                def cal = ec.user.nowCalendar
                cal.set(Calendar.HOUR_OF_DAY, 0); cal.set(Calendar.MINUTE, 0)
                cal.set(Calendar.SECOND, 0); cal.set(Calendar.MILLISECOND, 0)
                todayStart = new java.sql.Timestamp(cal.timeInMillis)
                retryCutoff = new java.sql.Timestamp(
                    ec.user.nowTimestamp.time - (retryDelayMinutes as long) * 60000L)
            ]]></script>

            <set field="dailyLimit" from="campaign.dailyLimitPerPlatform ?: 50" type="Integer"/>

            <iterate list="platformList" entry="plat">
                <!-- The server can only send EMAIL. Browser/assisted platforms (LINKEDIN) are
                     sent from the Flutter client - LinkedIn from the assisted send-queue
                     screen - so draining them here would both fail and steal messages out of
                     that queue. -->
                <if condition="plat != 'EMAIL'"><continue/></if>

                <!-- How many already went out today for this platform -->
                <entity-find-count entity-name="growerp.marketing.OutreachMessage"
                    count-field="sentToday">
                    <econdition field-name="marketingCampaignId"/>
                    <econdition field-name="platform" from="plat"/>
                    <econdition field-name="status" value="SENT"/>
                    <econdition field-name="sentDate" operator="greater-equals" from="todayStart"/>
                </entity-find-count>
                <set field="remaining" from="dailyLimit - sentToday" type="Integer"/>
                <if condition="remaining &lt;= 0"><continue/></if>

                <entity-find entity-name="growerp.marketing.OutreachMessage" list="pendingMessages"
                    limit="remaining">
                    <econdition field-name="marketingCampaignId"/>
                    <econdition field-name="platform" from="plat"/>
                    <econdition field-name="status" value="PENDING"/>
                    <!-- leave a retried message alone until the retry delay has passed -->
                    <econditions combine="or">
                        <econdition field-name="lastAttemptDate" operator="is-null"/>
                        <econdition field-name="lastAttemptDate" operator="less-than"
                            from="retryCutoff"/>
                    </econditions>
                    <order-by field-name="createdDate"/>
                </entity-find>

                <iterate list="pendingMessages" entry="pmsg">
                    <set field="messagesProcessed" from="messagesProcessed + 1"/>
                    <!-- Each message is its own unit of work: a hung SMTP connection can run
                         past the transaction timeout, and without force-new the remaining
                         messages would be refused with "transaction marked for rollback". -->
                    <service-call name="growerp.100.MCPAutomationServices100.send#OutreachMessage"
                        transaction="force-new" ignore-error="true"
                        in-map="[messageId: pmsg.messageId, platform: plat, ownerPartyId: ownerPartyId,
                                 maxAttempts: maxAttempts]"
                        out-map="sendOut"/>
                    <if condition="sendOut?.success">
                        <set field="messagesSent" from="messagesSent + 1"/>
                        <service-call name="growerp.100.OutreachServices100.update#CampaignMetrics"
                            transaction="force-new"
                            in-map="[marketingCampaignId: marketingCampaignId, incrementMessagesSent: true]"/>
                        <else>
                            <set field="messagesFailed" from="messagesFailed + 1"/>
                        </else>
                    </if>
                </iterate>
            </iterate>

            <!-- Nothing left to send: the campaign is done. Nothing used to write this status,
                 so campaigns stayed INPROGRESS forever even after every message had gone out.
                 FAILED messages do not hold it open, they are terminal: retry#OutreachMessages
                 puts them back to PENDING when a human wants another go. -->
            <entity-find-count entity-name="growerp.marketing.OutreachMessage"
                count-field="messagesLeft">
                <econdition field-name="marketingCampaignId"/>
                <econdition field-name="status" value="PENDING"/>
            </entity-find-count>
            <entity-find-count entity-name="growerp.marketing.OutreachMessage"
                count-field="messagesTotal">
                <econdition field-name="marketingCampaignId"/>
            </entity-find-count>
            <set field="campaignCompleted" from="false"/>
            <if condition="messagesLeft == 0 &amp;&amp; messagesTotal &gt; 0
                    &amp;&amp; campaign.statusId == 'MKTG_CAMP_INPROGRESS'">
                <service-call name="update#mantle.marketing.campaign.MarketingCampaign"
                    in-map="[marketingCampaignId: marketingCampaignId,
                             statusId: 'MKTG_CAMP_COMPLETED', isActive: 'N']"/>
                <set field="campaignCompleted" from="true"/>
            </if>
        </actions>
    </service>

    <service verb="run" noun="AllCampaignAutomation" authenticate="anonymous">
        <description>
            Scheduler entry point: process every active campaign for an owner. Runs from a headless
            ServiceJob (no logged-in user), so it logs in as the owner's main-company administrator
            (GROWERP_M_ADMIN) before doing any work. Pass ownerPartyId as a ServiceJobParameter.
        </description>
        <in-parameters>
            <parameter name="ownerPartyId">
                <description>Required when run headless; derived from the logged-in user when omitted.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="campaignsProcessed" type="Integer"/>
            <parameter name="messagesSent" type="Integer"/>
        </out-parameters>
        <actions>
            <!-- Headless run: authenticate as the owner's main-company administrator -->
            <if condition="!ec.user.userId">
                <if condition="!ownerPartyId">
                    <return error="true"
                        message="ownerPartyId is required when run without a logged-in user"/>
                </if>
                <entity-find entity-name="growerp.party.OwnerPersonDetailAndCompany"
                    list="adminList" limit="1" disable-authz="true">
                    <econdition field-name="ownerPartyId"/>
                    <econdition field-name="companyRole" value="OrgInternal"/>
                    <econdition field-name="userGroupId" value="GROWERP_M_ADMIN"/>
                    <econdition field-name="userDisabled" value="N" or-null="true"/>
                    <order-by field-name="userId"/>
                </entity-find>
                <set field="adminLogin" from="adminList ? adminList[0].loginName : null"/>
                <!-- No admin means this job can never do anything: an error return would
                     roll back, leave lastRunTime unwritten and repeat forever. Pause the
                     job instead, so the condition is reported once. -->
                <if condition="!adminLogin">
                    <!-- Groovy: the job runs without a user, so the write needs authz off -->
                    <script><![CDATA[
                        boolean alreadyDisabled = ec.artifactExecution.disableAuthz()
                        try {
                            def ownJob = ec.entity.find('moqui.service.job.ServiceJob')
                                .condition('jobName', 'CampaignAutomation_' + ownerPartyId)
                                .useCache(false).one()
                            if (ownJob != null && ownJob.paused != 'Y') {
                                ownJob.paused = 'Y'
                                ownJob.update()
                            }
                        } finally {
                            if (!alreadyDisabled) ec.artifactExecution.enableAuthz()
                        }
                    ]]></script>
                    <log level="warn"
                        message="No administrator user found for owner ${ownerPartyId}, campaign send job paused"/>
                    <set field="campaignsProcessed" from="0" type="Integer"/>
                    <set field="messagesSent" from="0" type="Integer"/>
                    <return/>
                </if>
                <script>ec.user.internalLoginUser(adminLogin)</script>
            </if>

            <if condition="!ownerPartyId">
                <service-call out-map="context"
                    name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"/>
            </if>

            <entity-find entity-name="mantle.marketing.campaign.MarketingCampaign"
                list="activeCampaigns">
                <econdition field-name="ownerPartyId"/>
                <econdition field-name="isActive" value="Y"/>
                <econdition field-name="statusId" value="MKTG_CAMP_INPROGRESS"/>
            </entity-find>

            <set field="campaignsProcessed" from="0" type="Integer"/>
            <set field="messagesSent" from="0" type="Integer"/>
            <iterate list="activeCampaigns" entry="camp">
                <service-call name="growerp.100.MCPAutomationServices100.process#CampaignAutomation"
                    in-map="[marketingCampaignId: camp.marketingCampaignId, ownerPartyId: ownerPartyId]"
                    out-map="procOut"/>
                <set field="campaignsProcessed" from="campaignsProcessed + 1"/>
                <set field="messagesSent" from="messagesSent + (procOut.messagesSent ?: 0)"/>
            </iterate>
        </actions>
    </service>

    <service verb="sync" noun="CampaignAutomationJob" authenticate="anonymous">
        <description>
            Make sure this owner has a send job. Without one its campaigns can go active and
            collect PENDING messages that are never sent: the scheduler only knows the jobs that
            exist. Called whenever a campaign is created, activated or started. The job ticks
            hourly all day; each campaign limits itself with sendFromHour/sendToHour.
        </description>
        <in-parameters>
            <parameter name="ownerPartyId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="jobName"/>
            <parameter name="created" type="Boolean"/>
        </out-parameters>
        <actions>
            <!-- _NA_ owns the parties that belong to no tenant (SYSTEM_SUPPORT). It is not
                 a PtyOwner, so the administrator lookup in run#AllCampaignAutomation can
                 never match it and the job would fail every hour forever. -->
            <if condition="ownerPartyId == '_NA_'">
                <set field="created" from="false"/>
                <return/>
            </if>
            <set field="jobName" from="'CampaignAutomation_' + ownerPartyId"/>
            <!-- cache=false: ServiceJob is cacheable and a cached value is not mutable -->
            <entity-find-one entity-name="moqui.service.job.ServiceJob" value-field="job"
                cache="false">
                <field-map field-name="jobName"/>
            </entity-find-one>
            <if condition="job">
                <set field="created" from="false"/>
                <else>
                    <service-call name="create#moqui.service.job.ServiceJob"
                        in-map="[jobName: jobName,
                                 description: 'Send PENDING outreach messages for ' + ownerPartyId,
                                 serviceName: 'growerp.100.MCPAutomationServices100.run#AllCampaignAutomation',
                                 cronExpression: '0 0 * * * ?',
                                 paused: 'N']"/>
                    <service-call name="create#moqui.service.job.ServiceJobParameter"
                        in-map="[jobName: jobName, parameterName: 'ownerPartyId',
                                 parameterValue: ownerPartyId]"/>
                    <set field="created" from="true"/>
                </else>
            </if>
        </actions>
    </service>

    <service verb="send" noun="OutreachMessage">
        <description>
            Send a single outreach message. Only EMAIL is sent here, through the company's own
            SMTP server. Every other platform (LINKEDIN) is sent from the Flutter client and is
            left untouched: LinkedIn messages stay PENDING for the assisted send-queue screen.
        </description>
        <in-parameters>
            <parameter name="messageId" required="true"/>
            <parameter name="platform" required="true">
                <description>EMAIL is sent; anything else returns success=false and leaves the
                    message alone</description>
            </parameter>
            <parameter name="ownerPartyId">
                <description>Pass explicitly from the headless scheduler; derived from the
                    logged-in user when omitted.</description>
            </parameter>
            <parameter name="maxAttempts" type="Integer" default-value="3">
                <description>A failed send stays PENDING (and is retried by the next automation
                    run) until this many attempts have been made, then becomes FAILED.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="success" type="Boolean"/>
            <parameter name="errorMessage"/>
            <parameter name="screenshotPath"/>
            <parameter name="attemptCount" type="Integer">
                <description>Attempts made including this one</description>
            </parameter>
            <parameter name="messageStatus">
                <description>Status written: SENT, PENDING (retry pending) or FAILED (attempts
                    exhausted, or a permanent failure that retrying cannot fix)</description>
            </parameter>
        </out-parameters>
        <actions>
            <if condition="!ownerPartyId">
                <service-call out-map="context"
                    name="growerp.100.GeneralServices100.get#RelatedCompanyAndOwner"/>
            </if>

            <!-- Get the message details -->
            <entity-find-one entity-name="growerp.marketing.OutreachMessage" value-field="message">
                <field-map field-name="messageId"/>
            </entity-find-one>
            
            <if condition="!message">
                <return error="true" message="Message not found: ${messageId}"/>
            </if>

            <!-- Only EMAIL is sent by the server. Not an error return: the caller must not
                 roll back, and the message must stay PENDING (keeping its attemptCount) so
                 the assisted send-queue screen still shows it. The out-parameters are set
                 explicitly, a bare return would look like a silent success. -->
            <if condition="platform != 'EMAIL'">
                <set field="success" from="false"/>
                <set field="errorMessage"
                    value="${platform} messages are sent from the app send queue, not by the server"/>
                <set field="messageStatus" from="message.status"/>
                <set field="attemptCount" from="message.attemptCount ?: 0" type="Integer"/>
                <return/>
            </if>

            <!-- Send via the tenant's active email server using the campaign subject +
                 this message body. Operates on the existing PENDING message; status
                 update happens below. -->
            <if condition="!message.recipientEmail">
                <!-- permanent: retrying cannot invent an address -->
                <set field="sendResult"
                    from="[success: false, permanent: true,
                           errorMessage: 'Recipient has no email address']"/>
                <else>
                    <!-- tenant-only email server, no SYSTEM fallback; check first so an
                         unconfigured tenant becomes a FAILED message, not a service error -->
                    <service-call name="growerp.100.GeneralServices100.get#ActiveEmailServer"
                        in-map="[ownerPartyId: ownerPartyId]" out-map="emailServerOut"/>
                    <if condition="!emailServerOut.emailConfigured">
                        <!-- permanent: a missing configuration is not a transient
                             glitch, retrying it hourly only hides the real problem -->
                        <set field="sendResult"
                            from="[success: false, permanent: true,
                                   errorMessage: 'No SMTP email server configured for this company, please enter the SMTP settings in the company settings']"/>
                        <else>
                            <entity-find-one entity-name="mantle.marketing.campaign.MarketingCampaign"
                                value-field="campaign">
                                <field-map field-name="marketingCampaignId" from="message.marketingCampaignId"/>
                            </entity-find-one>
                            <!-- unsubscribe served by pop-rest-store /nurture screen -->
                            <service-call name="growerp.100.NurtureServices100.get#TenantBaseUrl"
                                in-map="[ownerPartyId: ownerPartyId]" out-map="context"/>
                            <set field="unsubscribeUrl"
                                value="${baseUrl}/nurture/unsubscribe?email=${message.recipientEmail}&amp;campaign=${message.marketingCampaignId}"/>
                            <!-- Substitute placeholders here, not only when the message
                                 was imported: a hand-written subject, an edited body or
                                 one rewritten by the personalizer agent never passed
                                 through the import-time substitution. -->
                            <service-call name="growerp.100.OutreachServices100.personalize#OutreachText"
                                out-map="subjectOut"
                                in-map="[text: message.emailSubject ?: campaign?.emailSubject
                                             ?: 'Hello from GrowERP',
                                         recipientName: message.recipientName,
                                         recipientCompany: message.recipientCompany,
                                         recipientTitle: message.recipientTitle]"/>
                            <service-call name="growerp.100.OutreachServices100.personalize#OutreachText"
                                out-map="bodyOut"
                                in-map="[text: message.messageContent,
                                         recipientName: message.recipientName,
                                         recipientCompany: message.recipientCompany,
                                         recipientTitle: message.recipientTitle]"/>
                            <service-call name="growerp.100.OutreachServices100.render#OutreachEmailBody"
                                out-map="renderOut"
                                in-map="[bodyText: bodyOut.text,
                                         unsubscribeUrl: unsubscribeUrl]"/>
                            <set field="emailBody" from="renderOut.bodyHtml"/>
                            <!-- ignore-error + force-new: a send failure must not abort or
                                 poison this service's transaction; failure is recorded on
                                 the message -->
                            <service-call name="growerp.100.GeneralServices100.send#DirectEmail"
                                ignore-error="true" transaction="force-new" out-map="emailResult">
                                <field-map field-name="ownerPartyId"/>
                                <field-map field-name="toAddresses" from="message.recipientEmail"/>
                                <!-- per-message override wins over the campaign subject,
                                     placeholders already substituted above -->
                                <field-map field-name="subject" from="subjectOut.text"/>
                                <field-map field-name="bodyHtml" from="emailBody"/>
                            </service-call>
                            <!-- Success is the SMTP message id, NOT emailMessageId:
                                 emailMessageId only means the EmailMessage row was
                                 created, and Moqui's sendEmailMessage swallows SMTP
                                 errors, so an unreachable server would look sent. -->
                            <set field="sendResult"
                                from="emailResult?.messageId ? [success: true] :
                                    [success: false, errorMessage: 'Email send failed, see server log']"/>
                        </else>
                    </if>
                </else>
            </if>

            <set field="success" from="sendResult.success"/>
            <set field="errorMessage" from="sendResult.errorMessage"/>
            <set field="screenshotPath" from="sendResult.screenshotPath"/>

            <!-- A failed send is only terminal once the attempts run out: until then it stays
                 PENDING so the next automation run picks it up again. -->
            <set field="attemptCount" from="(message.attemptCount ?: 0) + 1" type="Integer"/>
            <set field="messageStatus"
                from="success ? 'SENT'
                      : ((sendResult.permanent || attemptCount &gt;= maxAttempts)
                         ? 'FAILED' : 'PENDING')"/>

            <!-- Update message status. force-new: an unreachable SMTP host blocks for its
                 full socket timeout, which can exceed the transaction timeout and leave the
                 calling transaction rollback-only. Without its own transaction the outcome
                 would be lost and the message would silently stay PENDING. -->
            <service-call name="update#growerp.marketing.OutreachMessage" transaction="force-new">
                <field-map field-name="messageId"/>
                <field-map field-name="status" from="messageStatus"/>
                <field-map field-name="sentDate" from="success ? ec.user.nowTimestamp : null"/>
                <field-map field-name="attemptCount" from="attemptCount"/>
                <field-map field-name="lastAttemptDate" from="ec.user.nowTimestamp"/>
                <!-- '' not null: entity-auto skips null fields, a stale error would survive -->
                <field-map field-name="errorMessage" from="success ? '' : errorMessage"/>
            </service-call>
        </actions>
    </service>

</services>
