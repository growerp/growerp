<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <!-- a placed order for a course product opens the course for the person who ordered it -->
    <seca id="OrderPlacedCourseSubscriptions" service="mantle.order.OrderServices.place#Order"
        when="post-service">
        <actions>
            <service-call name="growerp.100.CourseServices100.create#CourseOrderSubscriptions"
                in-map="[orderId: orderId]" />
        </actions>
    </seca>
</secas>
