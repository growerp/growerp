<entity-facade-xml type="seed-initial">

    <!--  GrowERP REST API security all separated by internalorg company-->
    <moqui.basic.Enumeration description="GrowERP Mobile User groups" enumId="GROWERPMOBILE"
        enumTypeId="UserGroupType" />
    <moqui.security.UserGroup userGroupId="GROWERP_M_SYSTEM" description="System Admin"
        groupTypeEnumId="GROWERPMOBILE" />
    <moqui.security.UserGroupMember userGroupId="GROWERP_M_SYSTEM" userId="SystemSupport"
        fromDate="1265184000000" />
    <moqui.security.UserGroup userGroupId="GROWERP_M_ADMIN" description="Admin"
        groupTypeEnumId="GROWERPMOBILE">
        <permissions userPermissionId="ORDER_APPROVE" fromDate="0" />
        <permissions userPermissionId="INVOICE_APPROVE" fromDate="0" />
    </moqui.security.UserGroup>
    <moqui.security.UserGroup userGroupId="GROWERP_M_EMPLOYEE" description="Employee"
        groupTypeEnumId="GROWERPMOBILE">
        <permissions userPermissionId="ORDER_APPROVE" fromDate="0" />
    </moqui.security.UserGroup>
    <moqui.security.UserGroup userGroupId="GROWERP_M_OTHER" description="Customer"
        groupTypeEnumId="GROWERPMOBILE" />
    <!-- DEPRECATED: these three were derived from the business role (Customer/Lead/Supplier),
         which is not a security concept. Outside users are GROWERP_M_OTHER; the relationship
         lives on the party Role. Kept only so existing UserGroupMember rows keep their FK -
         they are granted nothing. See GrowerpSecurityMigrationData.xml. -->
    <moqui.security.UserGroup userGroupId="GROWERP_M_CUSTOMER" description="Customer (deprecated)"
        groupTypeEnumId="GROWERPMOBILE" />
    <moqui.security.UserGroup userGroupId="GROWERP_M_LEAD" description="Lead (deprecated)"
        groupTypeEnumId="GROWERPMOBILE" />
    <moqui.security.UserGroup userGroupId="GROWERP_M_SUPPLIER" description="Supplier (deprecated)"
        groupTypeEnumId="GROWERPMOBILE" />

    <!-- Break glass only: the whole REST tree, inherited, for the system accounts.
         An inheritable ALWAYS+ALL grant here short circuits every leaf check
         (ArtifactExecutionFacadeImpl isPermitted), which is exactly why the
         GROWERP_M_ADMIN / _EMPLOYEE / _OTHER grants that used to sit here are gone:
         they made the whole API readable and writable by every signed in user. -->
    <moqui.security.ArtifactGroup artifactGroupId="GROWERP_API"
        description="GROWERP REST API (via root resource), system accounts only" />
    <moqui.security.ArtifactGroupMember artifactGroupId="GROWERP_API"
        artifactTypeEnumId="AT_REST_PATH"
        inheritAuthz="Y" artifactName="/growerp" />
    <!-- pop rest store -->
    <moqui.security.ArtifactGroupMember artifactGroupId="GROWERP_API"
        artifactTypeEnumId="AT_REST_PATH"
        inheritAuthz="Y" artifactName="/pop" />

    <!-- distinct ids: artifactAuthzId is the sole PK, and these two rows used to
         share GROWERPAPI_AUTHZ_ADMIN_SYS, so the framework ADMIN grant was silently
         overwritten by the GROWERP_M_SYSTEM one -->
    <moqui.security.ArtifactAuthz artifactAuthzId="GROWERPAPI_AUTHZ_ADMIN_FW" userGroupId="ADMIN"
        artifactGroupId="GROWERP_API" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" />
    <moqui.security.ArtifactAuthz artifactAuthzId="GROWERPAPI_AUTHZ_SYSTEM"
        userGroupId="GROWERP_M_SYSTEM"
        artifactGroupId="GROWERP_API" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" />

    <!-- The screen hosting the REST API must stay reachable for everyone; the
         guard below decides the actual endpoints. -->
    <moqui.security.ArtifactGroup artifactGroupId="GROWERP_API_SCREEN"
        description="Screen hosting the GROWERP REST API" />
    <moqui.security.ArtifactGroupMember artifactGroupId="GROWERP_API_SCREEN"
        artifactTypeEnumId="AT_XML_SCREEN"
        inheritAuthz="Y" artifactName="component://growerp/screen/rest.xml" />
    <moqui.security.ArtifactAuthz artifactAuthzId="GROWERPSCREEN_AUTHZ_SYSTEM"
        userGroupId="GROWERP_M_SYSTEM" artifactGroupId="GROWERP_API_SCREEN"
        authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" />
    <moqui.security.ArtifactAuthz artifactAuthzId="GROWERPSCREEN_AUTHZ_ADMIN"
        userGroupId="GROWERP_M_ADMIN" artifactGroupId="GROWERP_API_SCREEN"
        authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" />
    <moqui.security.ArtifactAuthz artifactAuthzId="GROWERPSCREEN_AUTHZ_EMPL"
        userGroupId="GROWERP_M_EMPLOYEE" artifactGroupId="GROWERP_API_SCREEN"
        authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" />
    <moqui.security.ArtifactAuthz artifactAuthzId="GROWERPSCREEN_AUTHZ_OTHER"
        userGroupId="GROWERP_M_OTHER" artifactGroupId="GROWERP_API_SCREEN"
        authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL" />

    <!-- The guard. One pattern over every REST leaf, with authzServiceName so the
         decision is made per organization at request time: ArtifactAuthz has no
         ownerPartyId and GrowERP tenancy is an application convention, so a static
         row per tenant is not possible.
         The pattern must match the LEAF and nothing above it: /growerp/100/.* does
         not match /growerp or /growerp/100, so the check happens per endpoint. That
         is what went wrong with the old blanket grant, whose member was plain
         /growerp: it matched an ancestor, and an inheritable allow there short
         circuited every leaf below it.

         inheritAuthz="Y" because authorizing the endpoint has to carry through to
         the service and entities it invokes. With "N" the REST path is allowed and
         then the service call is checked separately, finds no AT_SERVICE grant, and
         fails with "not authorized for View on Service ...".

         AUTHZA_ALL so the row matches every method; check#RestAccess tells view
         from write. Domains live in GrowerpRestDomainGroupData.xml. -->
    <moqui.security.ArtifactGroup artifactGroupId="GROWERP_REST_GUARDED"
        description="GrowERP REST API, authorized from the organization menu" />
    <moqui.security.ArtifactGroupMember artifactGroupId="GROWERP_REST_GUARDED"
        artifactTypeEnumId="AT_REST_PATH" nameIsPattern="Y" inheritAuthz="Y"
        artifactName="/growerp/100/.*" />

    <moqui.security.ArtifactAuthz artifactAuthzId="GROWERPGUARD_AUTHZ_ADMIN"
        userGroupId="GROWERP_M_ADMIN" artifactGroupId="GROWERP_REST_GUARDED"
        authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"
        authzServiceName="growerp.100.SecurityServices100.check#RestAccess" />
    <moqui.security.ArtifactAuthz artifactAuthzId="GROWERPGUARD_AUTHZ_EMPL"
        userGroupId="GROWERP_M_EMPLOYEE" artifactGroupId="GROWERP_REST_GUARDED"
        authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"
        authzServiceName="growerp.100.SecurityServices100.check#RestAccess" />
    <moqui.security.ArtifactAuthz artifactAuthzId="GROWERPGUARD_AUTHZ_OTHER"
        userGroupId="GROWERP_M_OTHER" artifactGroupId="GROWERP_REST_GUARDED"
        authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"
        authzServiceName="growerp.100.SecurityServices100.check#RestAccess" />

    <!-- Special Permissions -->
    <!-- in general users can read with the company, write access can be limited to other users and
    company info-->
    <userPermissions userPermissionId="GROWERP_M_ALL"
        description="Any action on any employee, any company" />
    <userPermissions userPermissionId="GROWERP_M_COMPANY"
        description="Any action on own company info" />
    <userPermissions userPermissionId="GROWERP_M_USERS"
        description="Any action on any employee in the same company" />
    <userPermissions userPermissionId="GROWERP_M_CUSTOMERS" description="Outside user group" />
    <!-- system group -->
    <userGroupPermissions userGroupId="GROWERP_M_SYSTEM" userPermissionId="GROWERP_M_ALL"
        fromDate="0" />
    <!-- company admin group -->
    <userGroupPermissions userGroupId="GROWERP_M_ADMIN" userPermissionId="GROWERP_M_COMPANY"
        fromDate="0" />
    <userGroupPermissions userGroupId="GROWERP_M_ADMIN" userPermissionId="GROWERP_M_USERS"
        fromDate="0" />
    <!-- company employee group -->
    <userGroupPermissions userGroupId="GROWERP_M_EMPLOYEE" userPermissionId="GROWERP_M_USERS"
        fromDate="0" />
    <!-- other groups -->
    <userGroupPermissions userGroupId="GROWERP_M_OTHER" userPermissionId="GROWERP_M_CUSTOMERS"
        fromDate="0" />
    <userGroupPermissions userGroupId="GROWERP_M_CUSTOMER" userPermissionId="GROWERP_M_CUSTOMERS"
        fromDate="0" />
    <userGroupPermissions userGroupId="GROWERP_M_LEAD" userPermissionId="GROWERP_M_CUSTOMERS"
        fromDate="0" />
    <userGroupPermissions userGroupId="GROWERP_M_SUPPLIER" userPermissionId="GROWERP_M_CUSTOMERS"
        fromDate="0" />

    <moqui.security.UserGroupPermission userGroupId="GROWERP_M_SYSTEM"
        userPermissionId="ADMIN_PASSWORD" fromDate="0" />
    <moqui.security.UserGroupPermission userGroupId="GROWERP_M_ADMIN"
        userPermissionId="ADMIN_PASSWORD" fromDate="0" />

</entity-facade-xml>