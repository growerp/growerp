<entity-facade-xml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-facade-3.xsd" type="seed">

    <!-- OKF (Open Knowledge Format) knowledge bundle: the markdown files live in the
         growerp component under okf/ (root page okf/growerp.md, concepts under
         okf/growerp/). Seeding the space here makes the okf_index / okf_load_concept /
         okf_follow MCP tools work on a fresh install without first running
         growerp.100.OkfServices100.export#OkfBundle; that export refreshes the files from
         the live entity definitions and adds the WikiPage rows needed for wiki serving. -->
    <moqui.resource.wiki.WikiSpace wikiSpaceId="GROWERP_OKF"
        description="GrowERP OKF knowledge bundle"
        restrictView="N"
        restrictUpdate="Y"
        rootPageLocation="component://growerp/okf/growerp.md"/>

</entity-facade-xml>
