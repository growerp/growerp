<entity-facade-xml type="seed">
    <!-- HR: leave types -->
    <moqui.basic.EnumerationType enumTypeId="HrLeaveType" description="HR Leave Type" />
    <moqui.basic.Enumeration enumId="HrltAnnual" enumTypeId="HrLeaveType" description="Annual"
        sequenceNum="1" />
    <moqui.basic.Enumeration enumId="HrltSick" enumTypeId="HrLeaveType" description="Sick"
        sequenceNum="2" />
    <moqui.basic.Enumeration enumId="HrltUnpaid" enumTypeId="HrLeaveType" description="Unpaid"
        sequenceNum="3" />

    <!-- HR: employee status -->
    <moqui.basic.StatusType statusTypeId="HrEmployeeStatus" description="HR Employee Status" />
    <moqui.basic.StatusItem statusId="HremOnboarding" statusTypeId="HrEmployeeStatus"
        description="Onboarding" sequenceNum="1" />
    <moqui.basic.StatusItem statusId="HremActive" statusTypeId="HrEmployeeStatus"
        description="Active" sequenceNum="2" />
    <moqui.basic.StatusItem statusId="HremOffboarded" statusTypeId="HrEmployeeStatus"
        description="Offboarded" sequenceNum="3" />
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="HremOnboarding"
        toStatusId="HremActive" transitionName="Activate" />
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="HremOnboarding"
        toStatusId="HremOffboarded" transitionName="Offboard" />
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="HremActive"
        toStatusId="HremOffboarded" transitionName="Offboard" />

    <!-- HR: leave request status -->
    <moqui.basic.StatusType statusTypeId="HrLeaveStatus" description="HR Leave Request Status" />
    <moqui.basic.StatusItem statusId="HrlsPending" statusTypeId="HrLeaveStatus"
        description="Pending" sequenceNum="1" />
    <moqui.basic.StatusItem statusId="HrlsApproved" statusTypeId="HrLeaveStatus"
        description="Approved" sequenceNum="2" />
    <moqui.basic.StatusItem statusId="HrlsRejected" statusTypeId="HrLeaveStatus"
        description="Rejected" sequenceNum="3" />
    <moqui.basic.StatusItem statusId="HrlsCancelled" statusTypeId="HrLeaveStatus"
        description="Cancelled" sequenceNum="4" />
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="HrlsPending"
        toStatusId="HrlsApproved" transitionName="Approve" />
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="HrlsPending"
        toStatusId="HrlsRejected" transitionName="Reject" />
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="HrlsPending"
        toStatusId="HrlsCancelled" transitionName="Cancel" />
</entity-facade-xml>
