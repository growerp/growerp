<entity-facade-xml type="seed">
    <!-- Application record -->
    <growerp.Application applicationId="AppShop"
        description="GrowERP Shop: point of sale for shops" />

    <!-- Menu configuration -->
    <growerp.menu.MenuConfiguration menuConfigurationId="SHOP_DEFAULT" appId="shop"
        name="Shop Menu" description="Default shop application menu structure"/>

    <!-- Menu items: the till is for every employee, the rest for the admin -->
    <growerp.menu.MenuItem menuItemId="SHOP_MAIN" menuConfigurationId="SHOP_DEFAULT"
        title="Checkout" route="/" iconName="point_of_sale" widgetName="PosCheckoutScreen" sequenceNum="10"/>
    <growerp.menu.MenuItem menuItemId="SHOP_CATALOG" menuConfigurationId="SHOP_DEFAULT"
        title="Catalog" route="/catalog" iconName="category" widgetName="ProductList" userGroupsJson='["GROWERP_M_SYSTEM","GROWERP_M_ADMIN"]' sequenceNum="20"/>
    <growerp.menu.MenuItem menuItemId="SHOP_INVENTORY" menuConfigurationId="SHOP_DEFAULT"
        title="Inventory" route="/inventory" iconName="warehouse" widgetName="LocationList" userGroupsJson='["GROWERP_M_SYSTEM","GROWERP_M_ADMIN"]' sequenceNum="30"/>
    <growerp.menu.MenuItem menuItemId="SHOP_ORDERS" menuConfigurationId="SHOP_DEFAULT"
        title="Orders" route="/orders" iconName="shopping_cart" widgetName="SalesOrderList" userGroupsJson='["GROWERP_M_SYSTEM","GROWERP_M_ADMIN"]' sequenceNum="40"/>
    <growerp.menu.MenuItem menuItemId="SHOP_SHIFTS" menuConfigurationId="SHOP_DEFAULT"
        title="Shifts" route="/shifts" iconName="receipt_long" widgetName="PosShiftList" userGroupsJson='["GROWERP_M_SYSTEM","GROWERP_M_ADMIN"]' sequenceNum="45"/>
    <growerp.menu.MenuItem menuItemId="SHOP_TAX" menuConfigurationId="SHOP_DEFAULT"
        title="Tax Rates" route="/taxRates" iconName="percent" widgetName="TaxRateList" userGroupsJson='["GROWERP_M_SYSTEM","GROWERP_M_ADMIN"]' sequenceNum="50"/>
    <growerp.menu.MenuItem menuItemId="SHOP_STAFF" menuConfigurationId="SHOP_DEFAULT"
        title="Staff" route="/staff" iconName="people" widgetName="UserListEmployee" userGroupsJson='["GROWERP_M_SYSTEM","GROWERP_M_ADMIN"]' sequenceNum="55"/>
    <growerp.menu.MenuItem menuItemId="SHOP_COMPANY" menuConfigurationId="SHOP_DEFAULT"
        title="Organization" route="/companies" iconName="business" widgetName="ShowCompanyDialog" userGroupsJson='["GROWERP_M_SYSTEM","GROWERP_M_ADMIN"]' sequenceNum="60"/>
    <growerp.menu.MenuItem menuItemId="SHOP_ABOUT" menuConfigurationId="SHOP_DEFAULT"
        title="About" route="/about" iconName="info" widgetName="AboutForm" sequenceNum="70"/>
</entity-facade-xml>
