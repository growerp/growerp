<!--
The names a hosted website shows, marked as localizable.

With enable-localization every read of the field looks for a moqui.basic.LocalizedEntityField
row for the current ec.user.locale and falls back to the stored value when there is none, so
nothing changes for a site that was never translated. PopRestStore store.xml sets the locale
from the /{locale}/ path prefix; the rows are written by
growerp.100.WebsiteTranslationServices100.translate#StoreEntityNames.

Only single primary key entities can be localized this way (EntityValueBase.getKnownField),
which all three are.
-->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <extend-entity entity-name="ProductStore" package="mantle.product.store">
        <field name="storeName" type="text-medium" enable-localization="true" />
    </extend-entity>

    <extend-entity entity-name="ProductCategory" package="mantle.product.category">
        <field name="categoryName" type="text-medium" enable-localization="true" />
        <field name="description" type="text-very-long" enable-localization="true" />
    </extend-entity>

    <extend-entity entity-name="Product" package="mantle.product">
        <field name="productName" type="text-medium" enable-localization="true" />
        <field name="description" type="text-long" enable-localization="true" />
    </extend-entity>

</entities>
