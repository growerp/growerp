<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========================================================= -->
    <!--  Website lead-capture forms                               -->
    <!-- ========================================================= -->
    <entity entity-name="WebsiteForm" package="growerp.website">
        <description>A lead-capture form rendered on the public website; submissions create Lead users.</description>
        <field name="formId" type="id" is-pk="true" />
        <field name="pseudoId" type="id" />
        <field name="ownerPartyId" type="id" />
        <field name="productStoreId" type="id" />
        <field name="formName" type="text-medium" />
        <field name="title" type="text-medium" />
        <field name="submitLabel" type="text-short" />
        <field name="successMessage" type="text-medium" />
        <!-- optional nurture sequence to enroll leads into on submit -->
        <field name="emailSequenceId" type="id" />
        <!-- optional EmailTemplate sent to the submitter on submit (e.g. document delivery) -->
        <field name="emailTemplateId" type="id" />
        <field name="createdDate" type="date-time" />

        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <relationship type="one" related="mantle.product.store.ProductStore">
            <key-map field-name="productStoreId" />
        </relationship>
    </entity>

    <entity entity-name="WebsiteFormField" package="growerp.website">
        <description>A single input field of a website lead-capture form.</description>
        <field name="formId" type="id" is-pk="true" />
        <field name="fieldId" type="id" is-pk="true" />
        <field name="sequenceNum" type="number-integer" />
        <field name="label" type="text-medium" />
        <field name="fieldType" type="text-short" /> <!-- text, email, phone, textarea -->
        <field name="isRequired" type="text-indicator" />

        <relationship type="one" related="growerp.website.WebsiteForm">
            <key-map field-name="formId" />
        </relationship>
    </entity>

    <entity entity-name="WebsiteFormSubmission" package="growerp.website">
        <description>A visitor submission of a website form; partyId is the created/matched Lead.</description>
        <field name="submissionId" type="id" is-pk="true" />
        <field name="formId" type="id" />
        <field name="ownerPartyId" type="id" />
        <field name="partyId" type="id" />
        <field name="submittedDate" type="date-time" />
        <field name="valuesJson" type="text-very-long" />

        <relationship type="one" related="growerp.website.WebsiteForm">
            <key-map field-name="formId" />
        </relationship>
        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="partyId" />
        </relationship>
    </entity>

    <!-- ========================================================= -->
    <!--  Website generator: convert an external site to an owner  -->
    <!-- ========================================================= -->
    <entity entity-name="WebsiteConversion" package="growerp.website">
        <description>One attempt to convert an existing website into a new GrowERP owner: scrape the
            source site, generate the pages and theme with AI, and install them with
            import#WebsiteOwner. Runs as a background job; this row carries the progress.</description>
        <field name="conversionId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" /><!-- who started the conversion -->
        <field name="sourceUrl" type="text-medium" />
        <field name="siteId" type="text-short" /><!-- id prefix of the generated content -->
        <field name="companyName" type="text-medium" />
        <field name="adminEmail" type="text-medium" />
        <field name="adminFirstName" type="text-medium" />
        <field name="adminLastName" type="text-medium" />
        <field name="currencyId" type="id" />
        <field name="fiscalYearStartMonth" type="number-integer" /><!-- 1, 4, 7 or 10 -->
        <field name="applicationId" type="id" />
        <field name="hostNames" type="text-medium" /><!-- comma separated -->
        <field name="maxPages" type="number-integer" />
        <!-- QUEUED, SCRAPING, GENERATING, IMPORTING, COMPLETED, FAILED -->
        <field name="status" type="text-short" />
        <field name="statusMessage" type="text-medium" />
        <field name="pageCount" type="number-integer" />
        <field name="imageCount" type="number-integer" />
        <!-- filled in when the import succeeded -->
        <field name="createdOwnerPartyId" type="id" />
        <field name="createdCompanyPartyId" type="id" />
        <field name="productStoreId" type="id" />
        <field name="generatedPassword" type="text-medium" encrypt="true" />
        <field name="errorMessage" type="text-long" />
        <field name="createdDate" type="date-time" />
        <field name="completedDate" type="date-time" />

        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <relationship type="one" title="Created" related="mantle.party.Party">
            <key-map field-name="createdCompanyPartyId" related="partyId" />
        </relationship>
        <relationship type="one" related="mantle.product.store.ProductStore">
            <key-map field-name="productStoreId" />
        </relationship>
    </entity>

    <!-- ========================================================= -->
    <!--  Website translation: translate a site into more locales  -->
    <!-- ========================================================= -->
    <entity entity-name="WebsiteTranslation" package="growerp.website">
        <description>One attempt to translate an owner's website into the locales the Flutter apps
            support. Every page is translated with AI and written back as a locale prefixed wiki
            page (pagePath 'th/about' next to 'about'). Runs as a background job; this row carries
            the progress.</description>
        <field name="translationId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" /><!-- whose website is translated -->
        <field name="productStoreId" type="id" />
        <field name="sourceLocale" type="text-short" /><!-- the language the pages are written in -->
        <field name="targetLocales" type="text-medium" /><!-- comma separated, e.g. 'th,nl' -->
        <field name="translateEntityNames" type="text-indicator" /><!-- store/category/product names -->
        <field name="overwriteExisting" type="text-indicator" />
        <!-- QUEUED, TRANSLATING, COMPLETED, FAILED -->
        <field name="status" type="text-short" />
        <field name="statusMessage" type="text-medium" />
        <field name="pageCount" type="number-integer" /><!-- source pages x target locales -->
        <field name="translatedCount" type="number-integer" />
        <field name="errorMessage" type="text-long" />
        <field name="createdDate" type="date-time" />
        <field name="completedDate" type="date-time" />

        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <relationship type="one" related="mantle.product.store.ProductStore">
            <key-map field-name="productStoreId" />
        </relationship>
    </entity>
</entities>
