<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========================================================= -->
    <!--  Course (Central Course Definition)                       -->
    <!-- ========================================================= -->
    <entity entity-name="Course" package="growerp.course">
        <description>Central course definition with title, objectives, and target audience.</description>
        <field name="courseId" type="id" is-pk="true" />
        <field name="pseudoId" type="id" />
        <field name="ownerPartyId" type="id" />
        <field name="title" type="text-medium" />
        <field name="description" type="text-very-long" />
        <field name="objectives" type="text-very-long" />
        <field name="targetPersonaId" type="id" />
        <field name="audience" type="text-long" /> <!-- free-text target audience, used by the AI -->
        <field name="difficulty" type="text-short" /> <!-- BEGINNER, INTERMEDIATE, ADVANCED -->
        <field name="estimatedDuration" type="number-integer" /> <!-- in minutes -->
        <field name="status" type="text-short" /> <!-- DRAFT, PUBLISHED, ARCHIVED -->
        <field name="coverImageUrl" type="text-long" />

        <field name="productId" type="id" />
        <field name="createdDate" type="date-time" />
        <field name="lastModifiedDate" type="date-time" />
        <field name="createdByUserLogin" type="text-short" />
        <!-- translations: a translated course is a copy, in languageId, of sourceCourseId -->
        <field name="languageId" type="text-short" /> <!-- e.g. en, nl, th; empty: the language of the title -->
        <field name="sourceCourseId" type="id" />
        <!-- learning experience -->
        <field name="requireInstructorReview" type="text-indicator" /> <!-- Y: projects count as done once reviewed -->
        <field name="sequentialUnlock" type="text-indicator" /> <!-- Y: a module opens once the previous is done -->
        <field name="pacing" type="text-short" /> <!-- SELF (default), COHORT -->
        <field name="cohortStartDate" type="date-time" /> <!-- COHORT: the day the group starts -->
        <field name="chatRoomId" type="id" /> <!-- course discussion -->
        <field name="lastReviewedDate" type="date-time" /> <!-- last check for outdated content -->

        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <relationship type="one" related="mantle.product.Product" title="Course">
            <key-map field-name="productId" />
        </relationship>
        <relationship type="one" related="growerp.marketing.MarketingPersona">
            <key-map field-name="targetPersonaId" related="personaId" />
        </relationship>
        <relationship type="many" related="growerp.course.CourseModule">
            <key-map field-name="courseId" />
        </relationship>
    </entity>

    <!-- ========================================================= -->
    <!--  Course Module (Logical Grouping of Lessons)              -->
    <!-- ========================================================= -->
    <entity entity-name="CourseModule" package="growerp.course">
        <description>Module grouping related lessons within a course.</description>
        <field name="moduleId" type="id" is-pk="true" />
        <field name="pseudoId" type="id" />
        <field name="courseId" type="id" />
        <field name="title" type="text-medium" />
        <field name="description" type="text-long" />
        <field name="sequenceNum" type="number-integer" />
        <field name="estimatedDuration" type="number-integer" /> <!-- in minutes -->
        <!-- JSON array [{title, bullets: [], notes}]; notes are the spoken narration -->
        <field name="slides" type="text-very-long" />
        <!-- narrated video of the slides (AI job VIDEO): the mp4 in DbResource, streamed by
             /courseMedia/video?t=videoToken; a new video gets a new token -->
        <field name="videoLocation" type="text-long" />
        <field name="videoToken" type="id-long" />
        <field name="dueDays" type="number-integer" /> <!-- due this many days after the start -->

        <field name="createdDate" type="date-time" />
        <field name="lastModifiedDate" type="date-time" />

        <relationship type="one" related="growerp.course.Course">
            <key-map field-name="courseId" />
        </relationship>
        <relationship type="many" related="growerp.course.CourseLesson">
            <key-map field-name="moduleId" />
        </relationship>
    </entity>

    <!-- ========================================================= -->
    <!--  Course Lesson (Individual Learning Content)               -->
    <!-- ========================================================= -->
    <entity entity-name="CourseLesson" package="growerp.course">
        <description>Individual lesson with content, key points, and media.</description>
        <field name="lessonId" type="id" is-pk="true" />
        <field name="pseudoId" type="id" />
        <field name="moduleId" type="id" />
        <field name="courseId" type="id" />
        <field name="title" type="text-medium" />
        <field name="content" type="text-very-long" /> <!-- Markdown content -->
        <field name="keyPoints" type="text-very-long" /> <!-- JSON array of key points -->
        <field name="sequenceNum" type="number-integer" />
        <field name="estimatedDuration" type="number-integer" /> <!-- in minutes -->
        <field name="videoUrl" type="text-long" />
        <field name="imageUrl" type="text-long" />
        <!-- REVIEW AI job: statements that may be outdated and what to change, for the author -->
        <field name="reviewNotes" type="text-very-long" /> <!-- JSON {summary, issues: [{text, suggestion}]} -->
        <field name="reviewDate" type="date-time" />

        <field name="createdDate" type="date-time" />
        <field name="lastModifiedDate" type="date-time" />

        <relationship type="one" related="growerp.course.CourseModule">
            <key-map field-name="moduleId" />
        </relationship>
        <relationship type="one" related="growerp.course.Course">
            <key-map field-name="courseId" />
        </relationship>
    </entity>

    <!-- ========================================================= -->
    <!--  Course Media (AI-Generated Platform Content)             -->
    <!-- ========================================================= -->
    <entity entity-name="CourseMedia" package="growerp.course">
        <description>AI-generated content for various platforms.</description>
        <field name="mediaId" type="id" is-pk="true" />
        <field name="pseudoId" type="id" />
        <field name="ownerPartyId" type="id" />
        <field name="courseId" type="id" />
        <field name="moduleId" type="id" /> <!-- optional, for module-specific content -->
        <field name="lessonId" type="id" /> <!-- optional, for lesson-specific content -->
        <field name="platform" type="text-short" /> <!-- LINKEDIN, MEDIUM, EMAIL, YOUTUBE, TWITTER, SUBSTACK, INAPP -->
        <field name="mediaType" type="text-short" /> <!-- POST, ARTICLE, SEQUENCE, SCRIPT, THREAD, TUTORIAL -->
        <field name="title" type="text-medium" />
        <field name="generatedContent" type="text-very-long" />
        <field name="editedContent" type="text-very-long" />
        <field name="status" type="text-short" /> <!-- DRAFT, REVIEWED, SCHEDULED, PUBLISHED -->
        <field name="scheduledDate" type="date-time" />
        <field name="publishedDate" type="date-time" />

        <field name="createdDate" type="date-time" />
        <field name="lastModifiedDate" type="date-time" />

        <relationship type="one" related="growerp.course.Course">
            <key-map field-name="courseId" />
        </relationship>
        <relationship type="one" related="growerp.course.CourseModule">
            <key-map field-name="moduleId" />
        </relationship>
        <relationship type="one" related="growerp.course.CourseLesson">
            <key-map field-name="lessonId" />
        </relationship>
        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
    </entity>

    <!-- ========================================================= -->
    <!--  Course Quiz Question (multiple choice, per module)       -->
    <!-- ========================================================= -->
    <entity entity-name="CourseQuizQuestion" package="growerp.course">
        <description>Multiple choice question of the quiz at the end of a module. The quiz of a
            module is all its questions; learners never receive correctIndex or explanation
            before they submitted their answers.</description>
        <field name="questionId" type="id" is-pk="true" />
        <field name="courseId" type="id" />
        <field name="moduleId" type="id" />
        <field name="sequenceNum" type="number-integer" />
        <field name="question" type="text-long" />
        <field name="optionsJson" type="text-very-long" /> <!-- JSON array of answer texts -->
        <field name="correctIndex" type="number-integer" /> <!-- 0-based into optionsJson -->
        <field name="explanation" type="text-long" />
        <field name="lessonId" type="id" /> <!-- the lesson it tests: review it when answered wrong -->
        <field name="createdDate" type="date-time" />

        <relationship type="one" related="growerp.course.CourseModule">
            <key-map field-name="moduleId" />
        </relationship>
        <relationship type="one" related="growerp.course.Course">
            <key-map field-name="courseId" />
        </relationship>
    </entity>

    <!-- ========================================================= -->
    <!--  Course Exercise (hands-on practice, AI graded)           -->
    <!-- ========================================================= -->
    <entity entity-name="CourseExercise" package="growerp.course">
        <description>A practice task for the learner: a written answer, code, or (course level,
            no moduleId) the capstone project. The AI grades submissions against the rubric,
            which learners never see.</description>
        <field name="exerciseId" type="id" is-pk="true" />
        <field name="courseId" type="id" />
        <field name="moduleId" type="id" /> <!-- empty: course level, the capstone project -->
        <field name="lessonId" type="id" /> <!-- optional: the lesson it practices -->
        <field name="sequenceNum" type="number-integer" />
        <field name="exerciseType" type="text-short" /> <!-- TEXT, CODE, PROJECT -->
        <field name="title" type="text-medium" />
        <field name="prompt" type="text-very-long" /> <!-- Markdown task description -->
        <field name="rubric" type="text-very-long" /> <!-- grading criteria, for the AI -->
        <field name="createdDate" type="date-time" />
        <field name="lastModifiedDate" type="date-time" />

        <relationship type="one" related="growerp.course.Course">
            <key-map field-name="courseId" />
        </relationship>
        <relationship type="one" related="growerp.course.CourseModule">
            <key-map field-name="moduleId" />
        </relationship>
        <relationship type="one" related="growerp.course.CourseLesson">
            <key-map field-name="lessonId" />
        </relationship>
    </entity>

    <!-- ========================================================= -->
    <!--  Course Submission (a learner answer to an exercise)      -->
    <!-- ========================================================= -->
    <entity entity-name="CourseSubmission" package="growerp.course">
        <description>One attempt of a learner at an exercise; every attempt is kept, the latest
            counts. The AI grades it right away; an instructor can review it afterwards and
            the instructor score then overrides the AI score.</description>
        <field name="submissionId" type="id" is-pk="true" />
        <field name="exerciseId" type="id" />
        <field name="courseId" type="id" />
        <field name="userId" type="id" />
        <field name="answer" type="text-very-long" />
        <field name="status" type="text-short" /> <!-- SUBMITTED, AI_GRADED, REVIEWED -->
        <field name="aiScore" type="number-integer" /> <!-- 0-100 -->
        <field name="aiFeedback" type="text-very-long" /> <!-- JSON {feedback, strengths[], improvements[]} -->
        <field name="instructorScore" type="number-integer" />
        <field name="instructorFeedback" type="text-very-long" />
        <field name="reviewedByUserId" type="id" />
        <field name="reviewedDate" type="date-time" />
        <field name="submittedDate" type="date-time" />

        <relationship type="one" related="growerp.course.CourseExercise">
            <key-map field-name="exerciseId" />
        </relationship>
        <relationship type="one" related="growerp.course.Course">
            <key-map field-name="courseId" />
        </relationship>
        <relationship type="one" related="moqui.security.UserAccount">
            <key-map field-name="userId" />
        </relationship>
        <relationship type="one" related="moqui.security.UserAccount" title="ReviewedBy">
            <key-map field-name="reviewedByUserId" related="userId" />
        </relationship>
    </entity>

    <!-- ========================================================= -->
    <!--  Course Source (material the AI writes the course from)   -->
    <!-- ========================================================= -->
    <entity entity-name="CourseSource" package="growerp.course">
        <description>Source material given when a course was created with AI: notes, web pages,
            uploaded documents, or the tenant knowledge base. Kept so later AI jobs (lessons,
            slides, quizzes) write from the same material.</description>
        <field name="sourceId" type="id" is-pk="true" />
        <field name="courseId" type="id" />
        <field name="sourceType" type="text-short" /> <!-- NOTE, URL, FILE, KB, CURRICULUM -->
        <field name="title" type="text-medium" />
        <field name="location" type="text-long" /> <!-- url or file name -->
        <field name="content" type="text-very-long" /> <!-- extracted plain text -->
        <field name="createdDate" type="date-time" />

        <relationship type="one" related="growerp.course.Course">
            <key-map field-name="courseId" />
        </relationship>
    </entity>

    <!-- ========================================================= -->
    <!--  Course AI Job (background generation with progress)      -->
    <!-- ========================================================= -->
    <entity entity-name="CourseAiJob" package="growerp.course">
        <description>One AI generation run for a course (outline, lessons, ...). Runs as a
            background job; this row carries the progress the app polls.</description>
        <field name="jobId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" />
        <field name="courseId" type="id" />
        <field name="jobType" type="text-short" /> <!-- OUTLINE, LESSONS, QUIZ, SLIDES, VIDEO, PROMO, EXERCISE, TRANSLATE, REVIEW -->
        <field name="status" type="text-short" /> <!-- QUEUED, RUNNING, DONE, ERROR -->
        <field name="progressPercent" type="number-integer" />
        <field name="statusMessage" type="text-long" />
        <field name="errorMessage" type="text-very-long" />
        <field name="errorCode" type="text-short" /> <!-- AI_ALLOWANCE: token allowance used up -->
        <field name="inputJson" type="text-very-long" />
        <field name="username" type="text-medium" />
        <field name="createdDate" type="date-time" />
        <field name="completedDate" type="date-time" />

        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
    </entity>

    <!-- ========================================================= -->
    <!--  Course Progress (User Progress Tracking)                 -->
    <!-- ========================================================= -->
    <entity entity-name="CourseProgress" package="growerp.course">
        <description>Tracks user progress through a course.</description>
        <field name="progressId" type="id" is-pk="true" />
        <field name="userId" type="id" />
        <field name="courseId" type="id" />
        <field name="currentLessonId" type="id" />
        <field name="completedLessons" type="text-very-long" /> <!-- JSON array of lessonIds -->
        <field name="quizScores" type="text-long" /> <!-- JSON map moduleId: best score percent -->
        <field name="progressPercent" type="number-integer" />
        <field name="startedDate" type="date-time" />
        <field name="lastAccessDate" type="date-time" />
        <field name="completedDate" type="date-time" />
        <field name="lastReminderDate" type="date-time" />

        <relationship type="one" related="moqui.security.UserAccount">
            <key-map field-name="userId" />
        </relationship>
        <relationship type="one" related="growerp.course.Course">
            <key-map field-name="courseId" />
        </relationship>
        <relationship type="one" related="growerp.course.CourseLesson">
            <key-map field-name="currentLessonId" related="lessonId" />
        </relationship>
    </entity>

    <!-- ========================================================= -->
    <!--  Course Lesson History (earlier versions of a lesson)     -->
    <!-- ========================================================= -->
    <entity entity-name="CourseLessonHistory" package="growerp.course">
        <description>The text of a lesson before it was changed, by hand or by an AI job, so an
            author can see and restore earlier versions.</description>
        <field name="historyId" type="id" is-pk="true" />
        <field name="lessonId" type="id" />
        <field name="courseId" type="id" />
        <field name="versionNum" type="number-integer" />
        <field name="title" type="text-medium" />
        <field name="content" type="text-very-long" />
        <field name="keyPoints" type="text-very-long" />
        <field name="changedByUsername" type="text-medium" />
        <field name="changeReason" type="text-medium" /> <!-- EDIT, AI_LESSONS, AI_REVIEW, RESTORE -->
        <field name="changedDate" type="date-time" />

        <relationship type="one" related="growerp.course.CourseLesson">
            <key-map field-name="lessonId" />
        </relationship>
        <relationship type="one" related="growerp.course.Course">
            <key-map field-name="courseId" />
        </relationship>
    </entity>

</entities>
