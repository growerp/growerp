<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="PosSale" package="growerp.pos" cache="never">
        <description>A sale at the till. clientSaleId comes from the terminal and makes a retry
            after a lost connection return the first sale instead of selling twice.</description>
        <field name="ownerPartyId" type="id" is-pk="true" />
        <field name="clientSaleId" type="id-long" is-pk="true" />
        <field name="requestHash" type="text-short" />
        <field name="orderId" type="id" />
        <field name="invoiceId" type="id" />
        <field name="terminalName" type="text-short" />
        <field name="userId" type="id" />
        <field name="shiftId" type="id" />
        <field name="changeAmount" type="currency-amount" />
        <field name="saleDate" type="date-time" />
        <relationship type="one" title="Owner" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <relationship type="one" related="mantle.order.OrderHeader" />
        <relationship type="one" related="mantle.account.invoice.Invoice" />
    </entity>

    <entity entity-name="PosRefund" package="growerp.pos" cache="never">
        <description>Money given back at the till. clientRefundId works like clientSaleId.</description>
        <field name="ownerPartyId" type="id" is-pk="true" />
        <field name="clientRefundId" type="id-long" is-pk="true" />
        <field name="clientSaleId" type="id-long" />
        <field name="requestHash" type="text-short" />
        <field name="returnId" type="id" />
        <field name="paymentId" type="id" />
        <field name="shiftId" type="id" />
        <field name="amount" type="currency-amount" />
        <field name="terminalName" type="text-short" />
        <field name="userId" type="id" />
        <field name="refundDate" type="date-time" />
        <relationship type="one" title="Owner" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <relationship type="one" related="mantle.order.return.ReturnHeader" />
        <relationship type="one" related="mantle.account.payment.Payment" />
    </entity>

    <entity entity-name="PosShift" package="growerp.pos" cache="never">
        <description>The time a till is open, from the float counted in to the cash counted out.
            A till has at most one open shift.</description>
        <field name="shiftId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" not-null="true" />
        <field name="terminalName" type="text-short" not-null="true" />
        <field name="status" type="text-short" not-null="true" />
        <field name="openedByUserId" type="id" />
        <field name="closedByUserId" type="id" />
        <field name="openedDate" type="date-time" />
        <field name="closedDate" type="date-time" />
        <field name="openingFloat" type="currency-amount" />
        <field name="expectedCash" type="currency-amount" />
        <field name="countedCash" type="currency-amount" />
        <relationship type="one" title="Owner" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <index name="POS_SHIFT_TILL">
            <index-field name="ownerPartyId" />
            <index-field name="terminalName" />
        </index>
    </entity>

    <entity entity-name="PosCashMovement" package="growerp.pos" cache="never">
        <description>Cash into (positive) or out of (negative) the drawer that is no sale, like
            to the safe. It stays cash of the company, so it is not posted.</description>
        <field name="movementId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" not-null="true" />
        <field name="shiftId" type="id" not-null="true" />
        <field name="amount" type="currency-amount" not-null="true" />
        <field name="reason" type="text-medium" />
        <field name="userId" type="id" />
        <field name="movementDate" type="date-time" />
        <relationship type="one" title="Owner" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <relationship type="one" related="growerp.pos.PosShift" />
    </entity>
</entities>
