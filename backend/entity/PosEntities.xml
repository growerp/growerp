<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="PosSale" package="growerp.pos" cache="never">
        <description>A sale at the till. clientSaleId comes from the terminal and makes a retry
            after a lost connection return the first sale instead of selling twice.</description>
        <field name="ownerPartyId" type="id" is-pk="true" />
        <field name="clientSaleId" type="id-long" is-pk="true" />
        <field name="requestHash" type="text-short" />
        <field name="orderId" type="id" />
        <field name="invoiceId" type="id" />
        <field name="terminalName" type="text-short" />
        <field name="userId" type="id" />
        <field name="shiftId" type="id" />
        <field name="changeAmount" type="currency-amount" />
        <field name="saleDate" type="date-time" />
        <relationship type="one" title="Owner" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <relationship type="one" related="mantle.order.OrderHeader" />
        <relationship type="one" related="mantle.account.invoice.Invoice" />
    </entity>

    <entity entity-name="PosRefund" package="growerp.pos" cache="never">
        <description>Money given back at the till. clientRefundId works like clientSaleId.</description>
        <field name="ownerPartyId" type="id" is-pk="true" />
        <field name="clientRefundId" type="id-long" is-pk="true" />
        <field name="clientSaleId" type="id-long" />
        <field name="requestHash" type="text-short" />
        <field name="returnId" type="id" />
        <field name="paymentId" type="id" />
        <field name="shiftId" type="id" />
        <field name="amount" type="currency-amount" />
        <field name="terminalName" type="text-short" />
        <field name="userId" type="id" />
        <field name="refundDate" type="date-time" />
        <relationship type="one" title="Owner" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <relationship type="one" related="mantle.order.return.ReturnHeader" />
        <relationship type="one" related="mantle.account.payment.Payment" />
    </entity>

    <entity entity-name="PosShift" package="growerp.pos" cache="never">
        <description>The time a till is open, from the float counted in to the cash counted out.
            A till has at most one open shift.</description>
        <field name="shiftId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" not-null="true" />
        <field name="terminalName" type="text-short" not-null="true" />
        <field name="status" type="text-short" not-null="true" />
        <field name="openedByUserId" type="id" />
        <field name="closedByUserId" type="id" />
        <field name="openedDate" type="date-time" />
        <field name="closedDate" type="date-time" />
        <field name="openingFloat" type="currency-amount" />
        <field name="expectedCash" type="currency-amount" />
        <field name="countedCash" type="currency-amount" />
        <relationship type="one" title="Owner" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <index name="POS_SHIFT_TILL">
            <index-field name="ownerPartyId" />
            <index-field name="terminalName" />
        </index>
    </entity>

    <entity entity-name="PosCashMovement" package="growerp.pos" cache="never">
        <description>Cash into (positive) or out of (negative) the drawer that is no sale, like
            to the safe. It stays cash of the company, so it is not posted.</description>
        <field name="movementId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" not-null="true" />
        <field name="shiftId" type="id" not-null="true" />
        <field name="amount" type="currency-amount" not-null="true" />
        <field name="reason" type="text-medium" />
        <field name="userId" type="id" />
        <field name="movementDate" type="date-time" />
        <relationship type="one" title="Owner" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <relationship type="one" related="growerp.pos.PosShift" />
    </entity>

    <entity entity-name="PosTableLayout" package="growerp.pos" cache="never">
        <description>A table on the floor plan. The table itself is an Asset of class AsClsTable.</description>
        <field name="assetId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" not-null="true" />
        <field name="areaName" type="text-short" />
        <field name="x" type="number-integer" />
        <field name="y" type="number-integer" />
        <field name="shape" type="text-short" />
        <field name="seats" type="number-integer" />
        <relationship type="one" related="mantle.product.asset.Asset" />
        <relationship type="one" title="Owner" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
    </entity>

    <entity entity-name="PosTab" package="growerp.pos" cache="never">
        <description>The open bill of a table: an order that stays open until it is settled.</description>
        <field name="tabId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" not-null="true" />
        <field name="orderId" type="id" not-null="true" />
        <field name="tableAssetId" type="id" />
        <field name="guestCount" type="number-integer" />
        <field name="serverUserId" type="id" />
        <field name="status" type="text-short" not-null="true" />
        <field name="openedDate" type="date-time" />
        <field name="closedDate" type="date-time" />
        <relationship type="one" related="mantle.order.OrderHeader" />
        <relationship type="one" title="Owner" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <index name="POS_TAB_ORDER">
            <index-field name="orderId" />
        </index>
        <index name="POS_TAB_TABLE">
            <index-field name="tableAssetId" />
        </index>
    </entity>

    <entity entity-name="PosLine" package="growerp.pos" cache="never">
        <description>What happens to an order item of a tab: its way through the kitchen. Kept apart
            from the OrderItem so it cannot get lost, status New, Sent, Ready, Served or Voided.</description>
        <field name="orderId" type="id" is-pk="true" />
        <field name="orderItemSeqId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" not-null="true" />
        <field name="ticketId" type="id" />
        <field name="kitchenStatus" type="text-short" not-null="true" />
        <field name="seatNo" type="number-integer" />
        <field name="splitNo" type="number-integer" />
        <field name="sentDate" type="date-time" />
        <field name="readyDate" type="date-time" />
        <field name="voidReason" type="text-medium" />
        <relationship type="one" related="mantle.order.OrderItem" />
        <index name="POS_LINE_TICKET">
            <index-field name="ticketId" />
        </index>
    </entity>

    <entity entity-name="PosKitchenTicket" package="growerp.pos" cache="never">
        <description>What one send of a tab brought to the kitchen, status Open or Done.</description>
        <field name="ticketId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" not-null="true" />
        <field name="tabId" type="id" not-null="true" />
        <field name="status" type="text-short" not-null="true" />
        <field name="sentDate" type="date-time" />
        <relationship type="one" related="growerp.pos.PosTab" />
        <index name="POS_TICKET_OWNER">
            <index-field name="ownerPartyId" />
            <index-field name="status" />
        </index>
    </entity>

    <entity entity-name="PosModifierGroup" package="growerp.pos" cache="never">
        <description>A choice on a product, like the sauce: between minSelect and maxSelect of its
            modifiers. Not ProductFeature: those types are global, a tenant needs its own.</description>
        <field name="groupId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" not-null="true" />
        <field name="groupName" type="text-short" not-null="true" />
        <field name="minSelect" type="number-integer" />
        <field name="maxSelect" type="number-integer" />
        <relationship type="one" title="Owner" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
    </entity>

    <entity entity-name="PosModifier" package="growerp.pos" cache="never">
        <field name="modifierId" type="id" is-pk="true" />
        <field name="groupId" type="id" not-null="true" />
        <field name="modifierName" type="text-short" not-null="true" />
        <field name="priceDelta" type="currency-amount" />
        <relationship type="one" related="growerp.pos.PosModifierGroup" />
    </entity>

    <entity entity-name="PosProductModifierGroup" package="growerp.pos" cache="never">
        <field name="productId" type="id" is-pk="true" />
        <field name="groupId" type="id" is-pk="true" />
        <relationship type="one" related="mantle.product.Product" />
        <relationship type="one" related="growerp.pos.PosModifierGroup" />
    </entity>

    <entity entity-name="PosLineModifier" package="growerp.pos" cache="never">
        <description>A modifier as it was chosen: name and price stay when the modifier changes.</description>
        <field name="orderId" type="id" is-pk="true" />
        <field name="orderItemSeqId" type="id" is-pk="true" />
        <field name="modifierId" type="id" is-pk="true" />
        <field name="modifierName" type="text-short" />
        <field name="priceDelta" type="currency-amount" />
    </entity>
</entities>
