<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========================================================= -->
    <!--  Insurance agency: policies sold for carriers, and the    -->
    <!--  claims of the insured clients.                           -->
    <!--  The insured is a customer (Party with role Customer),    -->
    <!--  the carrier a company with role Supplier. Premiums are   -->
    <!--  billed by the carrier; the agency earns a commission.    -->
    <!-- ========================================================= -->

    <entity entity-name="Policy" package="growerp.insurance">
        <field name="policyId" type="id" is-pk="true" />
        <field name="pseudoId" type="id" />
        <field name="ownerPartyId" type="id" />
        <field name="policyNumber" type="text-short"><description>number given by the carrier</description></field>
        <field name="insuredPartyId" type="id" />
        <field name="carrierPartyId" type="id" />
        <field name="producerPartyId" type="id"><description>agency employee handling the policy</description></field>
        <field name="policyTypeEnumId" type="id" />
        <field name="statusId" type="id" enable-audit-log="true" />
        <field name="effectiveDate" type="date-time" />
        <field name="expirationDate" type="date-time" />
        <field name="premiumAmount" type="currency-amount" />
        <field name="premiumFrequencyEnumId" type="id" />
        <field name="currencyUomId" type="id" />
        <field name="commissionRate" type="number-decimal"><description>percentage of the premium</description></field>
        <field name="commissionReceived" type="currency-amount" />
        <field name="renewedFromPolicyId" type="id" />
        <field name="description" type="text-long" />
        <field name="vehiclePlate" type="text-short"><description>motor policies: licence plate of the insured vehicle</description></field>
        <field name="vehicleDescription" type="text-medium" />
        <field name="verificationToken" type="id"><description>random token in the QR code of the digital policy card, public proof of insurance</description></field>
        <field name="plainSummary" type="text-very-long"><description>AI plain-language explanation of the coverage, cleared when the policy changes</description></field>
        <field name="plainSummaryLocale" type="text-short" />
        <field name="renewalRequestedDate" type="date-time"><description>the client asked for the renewal in the portal</description></field>
        <field name="renewalToken" type="id"><description>random token of the private renewal link sent in reminders (/renew/{token})</description></field>
        <field name="createdDate" type="date-time" />
        <relationship type="one" title="Owner" related="mantle.party.Party">
            <key-map field-name="ownerPartyId" related="partyId" />
        </relationship>
        <relationship type="one" title="Insured" related="mantle.party.Party">
            <key-map field-name="insuredPartyId" related="partyId" />
        </relationship>
        <relationship type="one" title="Carrier" related="mantle.party.Party">
            <key-map field-name="carrierPartyId" related="partyId" />
        </relationship>
        <relationship type="one" title="Producer" related="mantle.party.Party">
            <key-map field-name="producerPartyId" related="partyId" />
        </relationship>
        <relationship type="one" title="InsPolicyType" related="moqui.basic.Enumeration">
            <key-map field-name="policyTypeEnumId" related="enumId" />
        </relationship>
        <relationship type="one" title="InsPremiumFrequency" related="moqui.basic.Enumeration">
            <key-map field-name="premiumFrequencyEnumId" related="enumId" />
        </relationship>
        <relationship type="one" related="moqui.basic.StatusItem">
            <key-map field-name="statusId" />
        </relationship>
        <relationship type="many" related="growerp.insurance.PolicyCoverage" short-alias="coverages">
            <key-map field-name="policyId" />
        </relationship>
        <index name="PolicyPseudoIdx">
            <index-field name="ownerPartyId" />
            <index-field name="pseudoId" />
        </index>
        <index name="PolicyVerifyIdx" unique="true">
            <index-field name="verificationToken" />
        </index>
        <index name="PolicyRenewIdx" unique="true">
            <index-field name="renewalToken" />
        </index>
    </entity>

    <entity entity-name="PolicyCoverage" package="growerp.insurance">
        <field name="policyId" type="id" is-pk="true" />
        <field name="coverageSeqId" type="id" is-pk="true" />
        <field name="coverageName" type="text-medium" />
        <field name="limitAmount" type="currency-amount" />
        <field name="deductibleAmount" type="currency-amount" />
        <relationship type="one" related="growerp.insurance.Policy">
            <key-map field-name="policyId" />
        </relationship>
    </entity>

    <entity entity-name="Claim" package="growerp.insurance">
        <field name="claimId" type="id" is-pk="true" />
        <field name="pseudoId" type="id" />
        <field name="ownerPartyId" type="id" />
        <field name="policyId" type="id" />
        <field name="claimNumber" type="text-short"><description>number given by the carrier</description></field>
        <field name="statusId" type="id" enable-audit-log="true" />
        <field name="incidentTypeEnumId" type="id" />
        <field name="incidentDate" type="date-time" />
        <field name="incidentLocation" type="text-medium" />
        <field name="reportedDate" type="date-time" />
        <field name="reportedByPartyId" type="id" />
        <field name="description" type="text-long" />
        <field name="amountClaimed" type="currency-amount" />
        <field name="amountPaid" type="currency-amount" />
        <field name="comments" type="text-long" />
        <field name="aiAssessment" type="text-very-long"><description>JSON triage of the claim photos by AI, advice for the adjuster only</description></field>
        <field name="aiAssessedDate" type="date-time" />
        <relationship type="one" related="growerp.insurance.Policy">
            <key-map field-name="policyId" />
        </relationship>
        <relationship type="one" title="InsIncidentType" related="moqui.basic.Enumeration">
            <key-map field-name="incidentTypeEnumId" related="enumId" />
        </relationship>
        <relationship type="many" related="growerp.insurance.ClaimContent" short-alias="contents">
            <key-map field-name="claimId" />
        </relationship>
        <relationship type="one" related="moqui.basic.StatusItem">
            <key-map field-name="statusId" />
        </relationship>
        <index name="ClaimPseudoIdx">
            <index-field name="ownerPartyId" />
            <index-field name="pseudoId" />
        </index>
    </entity>

    <entity entity-name="ClaimContent" package="growerp.insurance">
        <description>Photos and documents of a claim, stored in the content store.</description>
        <field name="claimId" type="id" is-pk="true" />
        <field name="contentSeqId" type="id" is-pk="true" />
        <field name="contentLocation" type="text-medium" />
        <field name="description" type="text-medium" />
        <field name="createdDate" type="date-time" />
        <relationship type="one" related="growerp.insurance.Claim">
            <key-map field-name="claimId" />
        </relationship>
    </entity>

    <!-- ====================== renewal engine ====================== -->
    <entity entity-name="RenewalTouch" package="growerp.insurance">
        <description>One contact moment in the renewal journey of a policy: a reminder sent on a
            channel, the customer opening or acting on it, an AI voice call, a telesales call and
            its outcome. The funnel and the lead score are computed from these.</description>
        <field name="touchId" type="id" is-pk="true" />
        <field name="ownerPartyId" type="id" />
        <field name="policyId" type="id" />
        <field name="channelEnumId" type="id" />
        <field name="eventEnumId" type="id" />
        <field name="outcomeEnumId" type="id"><description>telesales / voice call outcome code</description></field>
        <field name="touchDate" type="date-time" />
        <field name="messageText" type="text-very-long"><description>the reminder as sent (Zalo/VETC/SMS/email)</description></field>
        <field name="summary" type="text-long"><description>AI summary of a voice call or chat, for the telesales colleague</description></field>
        <field name="transcript" type="text-very-long" />
        <field name="byPartyId" type="id"><description>staff member, or empty for the system / AI</description></field>
        <relationship type="one" related="growerp.insurance.Policy">
            <key-map field-name="policyId" />
        </relationship>
        <relationship type="one" title="InsTouchChannel" related="moqui.basic.Enumeration">
            <key-map field-name="channelEnumId" related="enumId" />
        </relationship>
        <relationship type="one" title="InsTouchEvent" related="moqui.basic.Enumeration">
            <key-map field-name="eventEnumId" related="enumId" />
        </relationship>
        <relationship type="one" title="InsCallOutcome" related="moqui.basic.Enumeration">
            <key-map field-name="outcomeEnumId" related="enumId" />
        </relationship>
        <index name="RenewalTouchPolicyIdx">
            <index-field name="policyId" />
            <index-field name="touchDate" />
        </index>
    </entity>

    <entity entity-name="CustomerConsent" package="growerp.insurance">
        <description>Permission of a customer to be contacted on a channel (Decree 13/2023): when,
            how it was given, and withdrawn consent (granted N).</description>
        <field name="partyId" type="id" is-pk="true" />
        <field name="channelEnumId" type="id" is-pk="true" />
        <field name="granted" type="text-indicator" />
        <field name="consentDate" type="date-time" />
        <field name="source" type="text-medium"><description>e.g. dealer contract, VETC app, renewal page, voice call</description></field>
        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="partyId" />
        </relationship>
        <relationship type="one" title="InsTouchChannel" related="moqui.basic.Enumeration">
            <key-map field-name="channelEnumId" related="enumId" />
        </relationship>
    </entity>
</entities>
