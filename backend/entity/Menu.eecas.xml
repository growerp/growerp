<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">

    <!-- The menu decides REST access (check#RestAccess), so any menu write has to
         drop the cached per organization access map. Hung on the entities rather
         than on the eleven menu services: a new write path cannot forget it.

         Clears the whole cache instead of one owner's entries: MenuItem carries no
         ownerPartyId, menu writes are rare, and the map is cheap to rebuild. -->
    <eeca id="MenuItemClearAccessCache" entity="growerp.menu.MenuItem"
        on-create="true" on-update="true" on-delete="true">
        <actions>
            <service-call name="growerp.100.SecurityServices100.clear#OwnerDomainAccessCache" />
        </actions>
    </eeca>

    <eeca id="MenuConfigurationClearAccessCache" entity="growerp.menu.MenuConfiguration"
        on-create="true" on-update="true" on-delete="true">
        <actions>
            <service-call name="growerp.100.SecurityServices100.clear#OwnerDomainAccessCache" />
        </actions>
    </eeca>

</eecas>
