<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <!-- Per-user calendars (CalendarSyncServices100): todos, events and rentals are pushed
         after the transaction commits (registerOnCommit, a worker without a user), so a
         calendar failure never breaks a save. Several ECAs of one save push the same record:
         the push locks it and skips unchanged content. Tenants without a calendar connection
         (googleRefreshToken) are filtered here already. -->
    <eeca id="CalendarSyncWorkEffort" entity="mantle.work.effort.WorkEffort"
            on-create="true" on-update="true">
        <condition>
            <expression>(workEffortTypeEnumId == 'WetTask' || workEffortTypeEnumId == 'WetEvent')
                &amp;&amp; ownerPartyId &amp;&amp; ec.entity.find('growerp.general.SystemSettings')
                    .condition('ownerPartyId', ownerPartyId).useCache(true).one()?.googleRefreshToken</expression>
        </condition>
        <actions>
            <script>ec.service.special().name('growerp.100.CalendarSyncServices100.push#Activity')
                .parameters([workEffortId: workEffortId]).registerOnCommit()</script>
        </actions>
    </eeca>
    <eeca id="CalendarSyncWorkEffortParty" entity="mantle.work.effort.WorkEffortParty"
            on-create="true" on-update="true">
        <condition>
            <expression>roleTypeId in ['Assignee', 'Originator']</expression>
        </condition>
        <actions>
            <entity-find-one entity-name="mantle.work.effort.WorkEffort" value-field="calWorkEffort">
                <field-map field-name="workEffortId" />
            </entity-find-one>
            <if condition="calWorkEffort?.ownerPartyId &amp;&amp;
                    ['WetTask', 'WetEvent'].contains(calWorkEffort.workEffortTypeEnumId) &amp;&amp;
                    ec.entity.find('growerp.general.SystemSettings')
                        .condition('ownerPartyId', calWorkEffort.ownerPartyId).useCache(true).one()?.googleRefreshToken">
                <script>ec.service.special().name('growerp.100.CalendarSyncServices100.push#Activity')
                    .parameters([workEffortId: workEffortId]).registerOnCommit()</script>
            </if>
        </actions>
    </eeca>
    <eeca id="CalendarSyncAssetRental" entity="growerp.product.AssetRental"
            on-create="true" on-update="true" on-delete="true">
        <condition>
            <expression>orderId</expression>
        </condition>
        <actions>
            <entity-find-one entity-name="mantle.product.Product" value-field="calProduct">
                <field-map field-name="productId" />
            </entity-find-one>
            <if condition="calProduct?.ownerPartyId &amp;&amp; ec.entity.find('growerp.general.SystemSettings')
                    .condition('ownerPartyId', calProduct.ownerPartyId).useCache(true).one()?.googleRefreshToken">
                <script>ec.service.special().name('growerp.100.CalendarSyncServices100.push#Rental')
                    .parameters([orderId: orderId]).registerOnCommit()</script>
            </if>
        </actions>
    </eeca>
    <!-- a cancelled order: the rentals are bulk deleted (no ECA), the push removes them -->
    <eeca id="CalendarSyncOrderCancelled" entity="mantle.order.OrderHeader" on-update="true"
            get-original-value="true">
        <condition>
            <expression>statusId == 'OrderCancelled' &amp;&amp; originalValue?.statusId != 'OrderCancelled'</expression>
        </condition>
        <actions>
            <entity-find-count entity-name="growerp.crm.CalendarEventLink" count-field="calLinks">
                <econdition field-name="sourceType" value="rental" />
                <econdition field-name="sourceId" operator="like" value="${orderId}:%" />
            </entity-find-count>
            <if condition="calLinks">
                <script>ec.service.special().name('growerp.100.CalendarSyncServices100.push#Rental')
                    .parameters([orderId: orderId]).registerOnCommit()</script>
            </if>
        </actions>
    </eeca>
</eecas>
